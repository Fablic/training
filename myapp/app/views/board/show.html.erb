<div class="container">
  <div style="text-align:right;">
    <div class="btn-group" role="group" aria-label="Basic example">
<% I18n.available_locales.each do |locale, var| %>
      <a href="<%= board_path({"id": params[:id], "locale":locale}) %>" class="btn <% if(locale == I18n.locale) %>btn-primary<% else %>btn-light<%end%> btn-sm"><%= I18n.name_for_locale(locale) %></a>
<% end %>
    </div>
  </div>
  <div class="control-pane">
    <span>
      <div class="btn-group" role="group">
        <a href="#" id="btn_kanban" class="btn btn-lg btn-primary" onclick="TaskList.close();return false;"><i class="fas fa-columns"></i></a>
        <a href="#" id="btn_list" class="btn btn-lg btn-outline-secondary" onclick="TaskList.show();return false;"><i class="fal fa-table"></i></a>
      </div>
    </span>  
    <span>
      <a class="btn btn-success" href="#" onclick="EditModal.openNew();return false;">
       <i class="fas fa-calendar-plus"></i>
        <%= t :create_button %>
      </a>
    </span>
    <span id="status_button" onclick="FilterModal.show('status');" >Status: All</span>
    <span id="sort_button" onclick="SortModal.show();">Priority↓</span>
    <input type="text" placeholder="Keyword" id="keyword" />
  </div>

  <!-- kanban -->

  <div class="row" id="kanban" style="display:none;"></div>

  <!-- listview -->
  <div id="listView">
    <table class="table">
      <thead>
        <tr>
          <td>Status</td>
          <td>Priority</td>
          <td>Title</td>
          <td>Due date</td>
        </tr>
      </thead>
      <tbody id="tasklist">  
      </tbody>
    </table>
  </div>

  <nav>
    <ul class="pagination" id="paging">
      <li class="page-item"><a class="page-link" href="#">1</a></li>
      <li class="page-item"><a class="page-link" href="#">2</a></li>
      <li class="page-item"><a class="page-link" href="#">3</a></li>
    </ul>
  </nav>
  </div>


<div id="modal_background" onclick="Modal.maskClicked();" style="display:none;position:fixed; left:0px;top:0px;right:0px;bottom:0px;background-color: #000000;opacity:0.6"></div>

<!-- write modal -->
<div id="modal_edit" style="display:none;padding:20px;background-color: #eeeeee;position: fixed;right: 0px;top: 0px;width: 400px;bottom: 0px;">
    <form id="form_edit">
      <input type="hidden" id="edit_id" >
        <div class="mb-3">
            <label class="form-label"><%= t :form_title %></label>
            <input type="text" class="form-control" id="edit_title">
            <div class="invalid-feedback" id="edit_title_message"></div>            
        </div>
        <div class="mb-3">
            <label class="form-label"><%= t :form_contents %></label>
            <textarea class="form-control"  id="edit_contents"></textarea>
            <div class="invalid-feedback" id="edit_contents_message"></div>            
        </div>
        <div class="mb-3">
            <label class="form-label"><%= t :form_due_date %></label>
            <input type="text" class="form-control" id="edit_due_date" autocomplete="off">
            <div class="invalid-feedback" id="edit_due_date_message"></div>            
        </div>
        <div class="mb-3">
            <label class="form-label"><%= t :form_priority %></label>
            <select class="form-select" id="edit_priority">
            </select>
            <div class="invalid-feedback" id="edit_priority_message"></div>            
        </div>
        <div class="mb-3">
            <label class="form-label"><%= t :form_status %></label>
            <select class="form-select" id="edit_status">
            </select>
            <div class="invalid-feedback" id="edit_status_message"></div>            
        </div>
        <button type="button" class="btn btn-primary" onclick="EditModal.save();"><%= t :save_button %></button>
        <a href="#" onclick="EditModal.remove();return false;"><%= t :delete_button %></a>
    </form>
</div>

<!-- sort modal -->
<div id="modal_sort">
    <div class="sort_item" onclick="SortModal.apply('priority');" data-sort_type="priority">Priority △</div>
    <div class="sort_item" onclick="SortModal.apply('-priority');" data-sort_type="-priority">Priority ▽</div>
    <div class="sort_item" onclick="SortModal.apply('due_date');" data-sort_type="due_date">Due Date △</div>
    <div class="sort_item" onclick="SortModal.apply('-due_date');" data-sort_type="-due_date">Due Date ▽</div>
    <div class="sort_item" onclick="SortModal.apply('created_at');" data-sort_type="created_at">Created △</div>
    <div class="sort_item" onclick="SortModal.apply('-created_at');" data-sort_type="-created_at">Created ▽</div>
</div>    


<!-- filter modal -->
<div id="modal_filter">
  <ul class="list-group" id="filter_list">
  </ul>
</div>    


<script>
  $(document).ready(function() {
    init();
  });

  async function init() {
    HashState.init();
    let sort = HashState.get("sort");
    if (sort === null) {
      sort = "-created_at";
    }

    if (HashState.get("page") !== null) {
      TaskList.page = HashState.get("page");
    }

    await Board.init(<%=params[:id]%>);
    Board.changeSort(sort);
    Board.draw();

    let status_ids = HashState.get("status");
    if (status_ids !== null) {
      status_ids = status_ids.split(",");
      let ids_for_hide = [];
      for (let id in Status.all) {
        ids_for_hide.push(id);
      }

      ids_for_hide = ids_for_hide.filter(function (e) {
        return !status_ids.includes(e);
      });
      ids_for_hide.forEach(e => {
        Status.get(e).hide();
      });

      FilterModal.updateButtonText();
    }

    //await Task.init();
    let viewmode = HashState.get("viewmode");
    if (viewmode === null) viewmode = "kanban";
    let modal = null;
    let id = "";
    if (HashState.has("create")) {
      modal = "create";
      HashState.remove("create");
    } else if (HashState.has("modify")) {
      modal = "modify";
      id = HashState.get("id");
      HashState.remove("modify");
      HashState.remove("id");
    }

    KeywordWatch.init();

    if (viewmode === "kanban") {
      await TaskList.close();
    } else {
      await TaskList.show();
    }
    
    if (modal === "create") {
      EditModal.openNew();
    } else if (modal === "modify") {
      EditModal.openEdit(id);
    }
  }



</script>
