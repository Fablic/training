


<div class="section">

<h1 class="title has-text-primary">
  <%=t('actions.show') + Label.model_name.human() %>
</h1>
<div class='box'>
<%= link_to t('actions.back'), labels_path, class:"delete is-large is-pulled-right" %>


<p>
  <strong><%= Task.human_attribute_name(:name) %> </strong>
  <%= @label.name %>
</p>

<p>
  <strong><%= Task.human_attribute_name(:color) %></strong>
  <%= @label.color %>
</p>




<%= link_to t('actions.edit'), edit_label_path(@label) , class: "button is-link" %>


</div>
</div>