<%= simple_form_for label, html: { class: "label form" } do |f| %>
  <% if label.errors.any? %>
    <div class="error-message">
      <%= label.errors.full_messages.to_sentence.capitalize %>
    </div>
  <% end %>

  <%= f.input :name, input_html: { autofocus: true } %>
  <%= f.submit class: "btn btn-primary" %>
<% end %>
