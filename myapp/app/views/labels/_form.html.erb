<%= form_with(model: label, local: true) do |form| %>
  <% if label.errors.any? %>
    <div id="error_explanation">
      <ul>
        <% label.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label Label.human_attribute_name(:name) %>
    <%= form.text_field :name %>
  </div>


  <div class="field">
    <%= form.label Label.human_attribute_name(:color) %>
    <%= form.color_field :color %>
  </div>


  <div class="actions">
    <%= form.submit class: "button is-success"  %>
  </div>
<% end %>
