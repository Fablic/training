<%= form_with model: @label, local: true do |form| %>
  <%= render 'shared/error_messages', object: form.object %>

  <div class='w-50'>
    <div class='col-auto mb-3'>
        <%= form.label t('activerecord.attributes.label.name') , class: 'col-form-label' %>
        <%= form.text_field :name, class: 'form-control' %>
    </div>

    <div class='submit-content'>
      <%= form.submit t('buttons.register'), class: 'btn btn-primary' %>
      <%= link_to t('buttons.back_page'), :back, class: 'btn btn-link' %>
    </div>
  </div>
<% end %>