<p id="notice"><%= notice %></p>


<nav class="navbar navbar-expand-lg navbar-light" style="background-color: darkred;">
  <div class="navbar-brand" style="color: white;">
    <h1><%= t('pages.label_list_page.title') %></h1>
  </div>
  <div class="collapse navbar-collapse justify-content-end">
    <ul class="navbar-nav">
      <li class="nav-item">
        <%= link_to t('pages.label_list_page.new_label'), new_label_path, class: 'nav-link btn btn-outline-secondary', role: 'button', style: 'color: white;' %>
      </li>
      <li class="nav-item">
        <%= link_to t('back'), tasks_path, class: 'nav-link btn btn-outline-danger', role: 'button', style: 'color: white;' %>
      </li>
    </ul>
  </div>
</nav>


<div class="container" style="width: 90%; margin: 0 auto;">
  <div class="row">
    <div class="col-sm-12">
      <table class="table table-borderless table-striped">
      <thead class="thead-dark">
        <tr>
          <th scope="col"><%= t('pages.label_list_page.name') %></th>
          <th scope="col" colspan="3"></th>
        </tr>
      </thead>

        <tbody>
          <% @labels.each do |label| %>
            <tr>
              <td><%= link_to label.name,label %></td>
              <td class="text-right">
                <div style="display: flex; justify-content: flex-end;">
                  <%= link_to t('pages.label_list_page.edit_label'), edit_label_path(label) , class: 'btn btn-primary' , style: 'margin-right: 5px;'%>
                  <%= button_to t('pages.label_list_page.delete_label'), label_path(label), method: :delete, class: 'btn btn-primary', data: {confirm: "Do you want to delete #{label.name}?"} %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% if @labels.none? %>
        <p class="text-center">No results found</p>
      <% end %>
    </div>
  </div>
</div>