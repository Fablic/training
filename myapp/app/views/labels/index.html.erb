<p id="notice"><%= notice %></p>

<h1><%= Label.model_name.human + t('actions.list')%></h1>

<table class="type06">
  <thead>
    <tr>
      <th><%= link_to Label.human_attribute_name(:name), {sort: :name, direction: get_sort_direction(:name)} %></th>
      <th><%= link_to Label.human_attribute_name(:color) , {sort: :color, direction: get_sort_direction(:color)}%></th>

      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @labels.each do |label| %>
      <tr>
        <td><%= label.name %></td>
        <td><%= label.color %></td>
        <td><%= link_to t('actions.show'), label %></td>
        <td><%= link_to t('actions.edit'), edit_label_path(label) %></td>
        <td><%= link_to t('actions.destroy'), label, method: :delete, data: { confirm: t('messages.delete_confirm') } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to "#{t('actions.new')} #{Label.model_name.human}", new_label_path %>
