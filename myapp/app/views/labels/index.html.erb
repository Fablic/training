<div class="d-flex justify-content-end ">
  <div class='btn-toolbar' role="toolbar">
    <%= link_to 'タスク一覧', root_path, class: 'btn btn-outline-primary mx-1' %>
  </div>
</div>
<%= render 'layouts/error_messages' %>

<div class = 'new'>
<h5>新規ラベル</h5>
<%= form_with model: @label, local: true, scope: :label, class: "row row-cols-lg-auto g-3 align-items-center mb-5" do |f| %>
  <div class="col-12">
    <%= f.text_field :name, class: "form-control" %>
  </div>
  <div class="col-12">
    <%= f.submit '登録', class: 'btn btn-secondary' %>
  </div>
<% end %>
</div>

<div class = 'update'>
<h5>登録済ラベル</h5>
<% @labels.each do |label| %>
  <%= form_with model: label, local: true, class: "row row-cols-lg-auto g-3 align-items-center mb-2" do |f| %>
    <div class="col-12">
      <%= f.text_field :name, class: "form-control" %>
    </div>
    <div class="col-12">
      <%= f.submit '更新', class: 'btn btn-secondary' %>
    </div>
    <div class="col-12">
      <%= link_to '削除', label_path(label), method: :delete, data:{ confirm: '本当によろしいですか？'}, class: 'btn btn-dark mx-1' %>
    </div>
  <% end %>
<% end %>
</div>
