<h1><%= t('login.form.titles.login') %></h1>

<%= form_with url: login_path, method: :post, local: true do |form| %>
  <div class="form-group">
    <%= t('login.form.labels.username') %>
    <%= form.text_field :username, required: true, class: "form-control", placeholder: t('login.form.placeholders.username') %>
  </div>

  <div class="form-group">
    <%= t('login.form.labels.password') %>
    <%= form.password_field :password, required: true, class: "form-control", placeholder: t('login.form.placeholders.password') %>
  </div>

  <div class="form-group text-center">
    <%= form.submit t('login.form.submit.login'), class: "btn btn-primary" %>
  </div>
<% end %>


