<div class="container-sm border rounded-3" style="padding:10px;">
  <%= form_with(url: attach_labels_task_labels_path) do |form| %>
    <% if task_label.errors.any? %>
      <div class="alert alert-danger" role="alert">
        <h2><%= I18n.t('activerecord.errors.messages.count', count: task_label.errors.count) %></h2>

        <ul>
          <% task_label.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form.hidden_field :task_id, value: task_id %>

    <div class="row mb-3" style="padding:10px;">
      <%= form.label :label, 'ラベルを付与する', class: "col-sm-2 col-form-label" %>
      <div class="col-sm-10">
        <%= form.collection_check_boxes(:label_ids, labels, :id, :name, { checked: attached_label_ids }) do |box| %>
          <%= box.label do %>
            <%= box.check_box %>
            <%= box.text %>
          <% end %>
        <% end %>
      </div>
    </div>

    <div style="padding:10px;">
      <%= form.submit class: "btn btn-primary" %>
    </div>
  <% end %>
</div>

<%= link_to I18n.t('transition_destination.show'), task_path(task_id), { class: "btn btn-primary mx-1" } %>