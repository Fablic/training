<td class='user_name'><%= user.name %></td>
<td class='user_email'><%= user.email %></td>
<td class='user_email'><%= user.tasks.count %></td>
<td class='user_show_buttons'><%= link_to I18n.t('transition_destination.show'), admin_user_path(user), { class: "btn btn-primary mx-1" } %></td>
<td class='user_edit_buttons'><%= link_to I18n.t('transition_destination.edit'), edit_admin_user_path(user), { class: "btn btn-primary mx-1" } %></td>
<td class='user_destroy_buttons'><%= button_to I18n.t('transition_destination.destroy'), admin_user_path(user), method: :delete, class: "btn btn-danger mx-1" %></td>
