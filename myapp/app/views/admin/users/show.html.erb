<p id="notice"><%= notice %></p>
<h1><%= t('admin.users.show.page_title', user_name: @user.name) %></h1>

<div>
    <strong><%= t('admin.users.user_name') %></strong>
    <br />
    <%= @user.name %>
</div>

<% if @tasks.size != 0 %>
    <table>
    <thead>
        <tr>
        <th><%= t('tasks.title') %></th>
        <th><%= t('tasks.description') %></th>
        <th><%= t('tasks.termination_date') %></th>
        <th><%= t('tasks.priority') %></th>
        <th><%= t('tasks.status') %></th>
        <th colspan="3"></th>
        </tr>
    </thead>

    <tbody>
        <% @tasks.each do |task| %>
        <tr>
            <td><%= task.title %></td>
            <td>
            <%= task.description.length >= 10 ? task.description.slice(0,10) + t('tasks.sybol_abbreviations') : task.description %>
            </td>
            <td><%= task.termination_at.strftime("%Y-%m-%d %H:%M:%S") %></td>
            <td><%= Task.human_attribute_name("priority.#{task.priority}") %></td>
            <td><%= Task.human_attribute_name("status.#{task.status}") %></td>
            <td><%= link_to t('tasks.index.show_link'), task %></td>
            <td><%= link_to t('tasks.index.edit_link'), edit_task_path(task) %></td>
            <td><%= link_to t('tasks.index.delete_link'), task_path(task), method: :delete %></td>
        </tr>
        <% end %>
    </tbody>
    </table>
    <br>
<% else %>
    <h2><%= t('admin.users.show.no_task') %></h2>
<% end %>

<%= link_to t('admin.users.back'), admin_users_path %>
