<h1 class="display-1"><%= @user.name %>さんのタスク一覧</h1>

<% if @user_tasks.present? %>
<div id="tasks">
  <table class="table table-striped table-bordered">
    <tr>
      <%= render 'tasks/header' %>
    </tr>

    <% @user_tasks.each do |task| %>
      <div class="task" id="<%= dom_id task %>">
        <tr>
          <%= render 'tasks/attributes', task: %>
        </tr>
      </div>
    <% end %>
  </table>
</div>
<% else %>
	<h1 class="display-1"><%= @user.name %>さんのタスクは現在１件もありません〜〜</h1>
<% end %>

<div style="padding:10px;">
  <%= link_to I18n.t('transition_destination.index'), admin_users_path, { class: "btn btn-primary mx-1" } %>
</div>
