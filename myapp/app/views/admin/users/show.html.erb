<h1><%= t("page.user_detail") %></h1>

<% if flash[:notice] %>
  <div class="alert alert-success"><%= flash[:notice] %></div>
<% end %>
<% if flash[:alert] %>
  <div class="alert alert-danger"><%= flash[:alert] %></div>
<% end %>

<div class="container">
<p>
  <strong><%= t('name') %>:</strong>
  <%= @user.name %>
</p>

<p>
  <strong><%= t('username') %>:</strong>
  <%= @user.username %>
</p>

<p>
  <strong><%= t('tasks_count') %>:</strong>
  <%= @user.tasks_count %>
</p>

<span>
  <%= link_to t("button.show_task"), admin_user_tasks_path(@user), class:"btn btn-secondary" %>
</span>
<span>
  <%= link_to t("button.edit_user"), edit_admin_user_path(@user), class:"btn btn-secondary" %>
</span>
<span>
  <%= link_to t("button.back"), admin_users_path, class:"btn btn-secondary" %>
</span>

<span>
  <%= link_to t("button.deactivate_user"), admin_user_path(@user), method: :delete, data: { turbo_method: :delete , turbo_confirm: "Are you sure you want to delete this user?" }, class: "btn btn-danger" %>
</span>
</div>
