<h1>ユーザー管理</h1>

<table class="table">
  <thead>
    <tr>
      <th>名前</th>
      <th>メールアドレス</th>
      <th>タスク数</th>
      <th>操作</th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.name %></td>
        <td><%= user.email %></td>
        <td><%= link_to user.tasks.count, admin_user_tasks_path(user) %></td>
        <td>
          <%= link_to '編集', edit_admin_user_path(user), class: 'btn btn-primary' %>
          <%= button_to '削除', admin_user_path(user), method: :delete, class: 'btn btn-danger btn-sm' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to '新規作成', new_admin_user_path, class: 'btn btn-success' %>
