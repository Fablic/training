<p id="notice"><%= notice %></p>

<h1><%= t('admin.users.index.page_title')%></h1>
<td><%= link_to t('admin.users.index.new_link'), new_admin_user_path %></td>
<table>
  <thead>
    <tr>
      <th><%= t('admin.users.user_name') %></th>
      <th><%= t('admin.users.user_email') %></th>
      <th><%= t('admin.users.index.task_count') %></th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.name %></td>
        <td><%= user.email %></td>
        <td><%= user.admin ? t('admin.users.admin') :  t('admin.users.general') %>
        <td><%= link_to user.tasks.count.to_s + t('admin.users.index.task_count_unit'), admin_user_path(user) %></td> 
        <td><%= link_to t('tasks.index.edit_link'), edit_admin_user_path(user) %></td>
        <td><%= link_to t('tasks.index.delete_link'), admin_user_path(user), method: :delete %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<br>
