<div class="h5"><%= t 'users' %></div>

<%= render "form", user: @new_user, action: :create, btn_label: "Create" %>

<div class="row">
  <div class="col-12">
    <table class="table table-hover">
      <thead>
        <tr>
          <th scope="col"><%= t "user.name" %></th>
          <th scope="col"><%= t "task count" %></th>
          <th scope="col"><%= t "user.role" %></th>
          <th scope="col"><%= t 'created_at' %></th>
          <th scope="col"><%= t 'updated_at' %></th>
          <th scope="col"><%= t 'deleted_at' %></th>
        </tr>
      </thead>
    <% if @users.any? %>
      <tbody>
    <% @users.each do |user| %>
        <tr class="<%= 'table-danger' unless user.deleted_at.nil? %>">
          <td><%= link_to user.name, edit_admin_user_path(user) %></td>
          <td><%= link_to @tasks_count_map[user.id] ||= 0, admin_user_tasks_path(user) %></td>
          <td><%= t user.role %></td>
          <td><%= user.created_at %></td>
          <td><%= user.updated_at %></td>
          <td>
          <% if user.deleted_at.nil? %>
          <%= button_to "Delete",
          admin_user_path(user),
          method: :delete,
          class: "btn btn-danger btn-sm",
          id: "btn-delete",
          data: { "turbo-method": :delete, "turbo-confirm": 'Are you sure?' }
          %>
          <% else %>
          <%= user.deleted_at %>
          <% end %>
          </td>
          </td>
        </tr>
    <% end %>
      </tbody>
    <% end %>
    </table>
    <%= paginate @users %>
  </div>
</div>
