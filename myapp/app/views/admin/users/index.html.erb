<h1>Users</h1>

<table>
  <thead>
    <tr>
      <td>Name</td>
      <td>E-mail</td>
      <td>Is Admin?</td>
    </tr>
  </thead>

  <tbody>
    <% @users.each do |user| %>
        <tr>
          <td><%= user.name %></td>
          <td><%= user.email %></td>
          <td><%= user.is_admin %></td>
          <td><%= link_to 'Edit', edit_admin_user_path(user) %></td>
          <td><%= link_to 'Delete', admin_user_path(user), method: 'delete', data: { confirm: 'Are you sure you want to delete?'} %></td>
        </tr>
    <% end %>
  </tbody>
</table>

<%= link_to 'Create New User', new_admin_user_path %>
