<div class="container-sm border rounded-3" style="padding:10px;">
  <%= form_with(model: [:admin, @user]) do |form| %>
    <% if user.errors.any? %>
      <div class="alert alert-danger" role="alert">
        <h2><%= I18n.t('activerecord.errors.messages.count', count: user.errors.count) %></h2>

        <ul>
          <% user.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="row mb-3" style="padding:10px;">
      <%= form.label :name, I18n.t('activerecord.attributes.user.name'), class: "col-sm-2 col-form-label" %>
      <%= form.text_field :name, class: "form-control" %>
    </div>

    <div class="row mb-3" style="padding:10px;">
      <%= form.label :email, I18n.t('activerecord.attributes.user.email'), class: "col-sm-2 col-form-label" %>
      <%= form.text_field :email, class: "form-control"%>
    </div>

    <% if @user.new_record? %>
    <div class="row mb-3" style="padding:10px;">
      <%= form.label :password, I18n.t('activerecord.attributes.user.password'), class: "col-sm-2 col-form-label" %>
      <%= form.password_field :password, class: "form-control"%>
    </div>
    <% end %>

    <div class="row mb-3" style="padding:10px;">
      <%= form.label :role, I18n.t('activerecord.attributes.user.role'), class: "col-sm-2 col-form-label" %>
      <%= form.select :role, I18n.t('select_form.user.role'), {}, class: "form-select" %>
    </div>

    <div style="padding:10px;">
      <%= form.submit class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
