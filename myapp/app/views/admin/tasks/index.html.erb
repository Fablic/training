<div class="h5"><%= t "#{@user.name}'s task" %></div>
<table class="table table-hover">
  <thead>
    <tr>
      <th scope="col"><%= t "title" %></th>
      <th scope="col"><%= t "status" %></th>
      <th scope="col"><%= t "detail" %></th>
      <th scope="col"><%= t 'due_date_at' %></th>
      <th scope="col"><%= t 'created_at' %></th>
      <th scope="col"><%= t 'updated_at' %></th>
      <th scope="col"><%= t 'deleted_at' %></th>
    </tr>
  </thead>
<% if @tasks.any? %>
  <tbody>
<% @tasks.each do |task| %>
    <tr class="<%= 'table-danger' unless task.deleted_at.nil? %>" id="task-<%= task.id %>">
      <td><%= task.title %></td>
      <td><%= t task.status %></td>
      <td><%= task.description %></td>
      <td><%= task.due_date_at %></td>
      <td><%= task.created_at %></td>
      <td><%= task.updated_at %></td>
      <% if task.deleted_at.nil? %>
      <td>
      <%= button_to "Delete",
      admin_task_path(task),
      method: :delete,
      class: "btn btn-danger btn-sm",
      id: "btn-delete",
      data: { "turbo-method": :delete, "turbo-confirm": 'Are you sure?' }
      %>
      </td>
      <% else %>
      <td><%= task.deleted_at %></td>
      <% end %>
    </tr>
<% end %>
  </tbody>
<% end %>
</table>
<%= paginate @tasks %>
