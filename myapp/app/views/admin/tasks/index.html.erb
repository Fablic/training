<h1><%= t('page.all_tasks') %></h1>

<% if flash[:notice] %>
  <div class="alert alert-success"><%= flash[:notice] %></div>
<% end %>
<% if flash[:alert] %>
  <div class="alert alert-danger"><%= flash[:alert] %></div>
<% end %>

<div class="d-flex justify-content-center">
  <%= search_form_for @q, url: admin_tasks_path, html: { class: 'form-inline' } do |f| %>
    <% if params[:user_id].present? %>
      <%= hidden_field_tag :user_id, params[:user_id] %>
    <% end %>
    <div class="input-group">
      <span class="input-group-text">
        <i class="bi bi-search"></i>
      </span>
      <%= f.search_field :name_or_description_cont, class: "form-control" %>
      <%= f.hidden_field :s, value: params.dig(:q, :s) %>
      <%= f.submit t("button.search") %>
    </div>
    <div>
      <% Task.statuses.each do |status_key, status_value| %>
        <%= f.check_box :status_in, { multiple: true, class: "form-check-input" }, status_value, nil %>
        <%= f.label :status_in, t("activerecord.attributes.task.statuses.#{status_key}"), class: "form-check-label" %>
      <% end %>
    </div>
  <% end %>
</div>

<% if @tasks.empty? %>
  <p><%= t("page.no_task") %></p>
<% else %>
<div class="container">
<table class="table">
  <thead>
    <tr>
      <th><%= t('name') %></th>
      <th><%= t('assignee') %></th>
      <th><%= sort_link(@q, :deadline, t('deadline'), default_order: :asc) %></th>
      <th><%= sort_link(@q, :created_at, t('created_at'), default_order: :asc) %></th>
      <th><%= sort_link(@q, :priority, t('priority'), default_order: :asc) %></th>
      <th><%= t('status') %></th>
      <th><%= t('labels') %></th>
    </tr>
  </thead>
  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= link_to task.name, task %></td>
        <td><%= link_to task.user.name, admin_user_path(task.user) %></td>
        <td><%= task.deadline.strftime("%Y-%m-%d %H:%M") %></td>
        <td><%= task.created_at.strftime("%Y-%m-%d %H:%M") %></td>
        <td><%= t("activerecord.attributes.task.priorities.#{task.priority}") %></td>
        <td><%= t("activerecord.attributes.task.statuses.#{task.status}") %></td>
        <td>Label</td>
        <td>
          <%= link_to edit_task_path(task), class: "text-decoration-none" do %>
            <i class="bi bi-pencil-square"></i>
            <span class="visually-hidden">Edit</span>
          <% end %> |
          <%= link_to task, method: :delete, data: { turbo_method: :delete , turbo_confirm: "Are you sure?" }, class: "text-decoration-none" do %>
            <i class="bi bi-trash"></i>
            <span class="visually-hidden">Delete</span>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
</div>
<% end %>

<%= link_to new_task_path, class: "btn btn-primary text-decoration-none" do  %>
  <i class="bi bi-plus-circle"></i>
  <span><%= t('button.new_task') %></span>
<% end %>

<span>
  <%= link_to t("button.back"), tasks_path, class:"btn btn-secondary" %>
</span>

<%= paginate @tasks %>
