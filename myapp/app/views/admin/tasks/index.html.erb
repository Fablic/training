

<% if @total_tasks_count == 0 %>
  <p><%= t('admin.tasks.no_tasks') %></p>
<% else %>
  <h2>Tasks</h2>
  <% unless @user.nil? %>
    Reporter = <%=@user.name %>
  <% end %>
  <table class="table table-striped table-bordered border-dark" id="result">
    <thead>
    <tr>
      <th>Title</th>
      <th>Description</th>
      <th>Reporter</th>
      <th>Priority</th>
      <th>Labels</th>
      <th>DueDate</th>
      <th>Status</th>
      <th>Created</th>
      <th>Updated</th>
      <th></th>
    </tr>
    </thead>
    <tbody>
    <% @tasks.each_with_index do |task, index| %>
      <tr>
        <td><%= link_to task.title, admin_task_path(task) %></td>
        <td><%= task.description %></td>
        <td><%= task.user.name %></td>
        <td><%= task.priority %></td>
        <td>N/A</td>
        <td><%= task.due_date %></td>
        <td><%= task.status %></td>
        <td><%= task.created_at %></td>
        <td><%= task.updated_at %></td>
        <td>
          <div class="d-grid gap-2 d-md-flex">
            <%= button_to t('common.update'), edit_admin_task_path(task), method: :get, class: 'btn btn-sm btn-primary' , id: "update-#{index}"%>
            <%= link_to t('common.delete'), admin_task_path(task), method: :delete, data: { confirm: 'Really delete?' }, class: 'btn btn-sm btn-danger', id: "delete-#{index}"%>
          </div>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
<% end %>
