  <% if @task.errors.any? %>
    <div class="alert alert-warning" role="alert">
        <% @task.errors.full_messages.each do |message| %>
          <p><%= message %></p>
        <% end %>
    </div>
  <% end %>

  <div class="row mb-3">
    <%= form.label :title, "Title", class:'col-sm-2 col-form-label'%>
    <div class="col-sm-10"><%= form.text_field :title %></div>
    <% if @task.errors[:title].any? %>
      <div class="error-message"><%= @task.errors[:title].join(", ") %></div>
    <% end %>
  </div>
  <div class="row mb-3">
    <%= form.label :description, "Description", class:'col-sm-2 col-form-label' %>
    <div class="col-sm-10"><%= form.text_field :description %></div>
  </div>
  <div class="row mb-3">
    <%= form.label :status, "Status", class:'col-sm-2 col-form-label' %>
    <div class="col-sm-10"><%= form.select :status, Task.statuses.keys.to_a, {} %></div>
  </div>
  <div class="row mb-3">
    <%= form.label :priority, "Priority", class:'col-sm-2 col-form-label' %>
    <div class="col-sm-10"><%= form.select :priority, Task.priorities.keys.to_a, {} %></div>
  </div>
  <div class="row mb-3">
    <%= form.label :due_date, "Due date", class:'col-sm-2 col-form-label' %>
    <div class="col-sm-10"><%= form.text_field :due_date, placeholder: "2025-01-01" %></div>
    <% if @task.errors[:due_date].any? %>
      <div class="error-message"><%= @task.errors[:due_date].join(", ") %></div>
    <% end %>
  </div>
  <div class="row mb-3">
    <div class="d-grid gap-2 d-md-flex">
      <%= form.submit t('common.proceed'), class:'btn btn-sm btn-primary', id: 'proceed' %>
      <%= link_to t('common.cancel'), admin_tasks_path, class:'btn btn-sm btn-secondary', id: 'cancel'%>
    </div>
  </div>
