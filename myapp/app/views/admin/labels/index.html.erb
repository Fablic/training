<h2>Labels</h2>
<% if @total_labels_count == 0 %>
  <div class="alert alert-warning" role="alert"><%= t('admin.labels.no_labels') %></div>
<% end %>

<% if @total_labels_count != 0 %>
  <table class="table table-striped table-bordered border-dark" id="result">
    <thead>
    <tr>
      <th>Name</th>
      <th>Tasks</th>
      <th>Created</th>
      <th>Updated</th>
      <th>Operation</th>
    </tr>
    </thead>
    <tbody>
    <% @labels.each_with_index do |label, index| %>
      <tr>
        <td><%= label.name %></td>
        <td><%= label.tasks.size %></td>
        <td>
          <span title="<%= label.created_at.strftime('%Y-%m-%d %H:%M:%S') %>"><%= label.created_at.strftime('%Y-%m-%d') %></span>
        </td>
        <td>
          <span title="<%= label.created_at.strftime('%Y-%m-%d %H:%M:%S') %>"><%= label.updated_at.strftime('%Y-%m-%d') %></span>
        </td>
        <td>
          <%= button_to t('common.delete'), admin_label_path(label), method: :delete, data: { confirm: 'Really delete?' }, class: 'btn btn-sm btn-danger', id: "delete-#{index+1}" %>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
<% end %>
