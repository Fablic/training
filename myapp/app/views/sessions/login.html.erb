<div class="row mb-4">
  <% flash.each do |message_type, message| %>
    <% if message_type == 'success' %>
      <p class="col alert alert-success"><%= message %></p>
    <% else %>
      <p class="col alert alert-danger"><%= message %></p>
    <% end %>
  <% end %>
</div>
<div class="row">
  <h1 class="col mb-5"><%= I18n.t 'auth.login' %></h1>
</div>
<div class="row">
  <%= form_with scope: :session, url: login_path, method: :post, class: 'col-4', local: true do |form| %>
    <div class="form-group mb-4">
      <%= form.label :email, I18n.t('auth.email') %>
      <%= form.email_field :email, class: 'form-control' %>
    </div>
    <div class="form-group mb-4">
      <%= form.label :password, I18n.t('auth.password') %>
      <%= form.password_field :password, class: 'form-control' %>
    </div>
    <div class="form-group mb-4">
      <%= form.submit I18n.t('auth.login'), class: 'btn btn-primary' %>
    </div>
  <% end %>
</div>
