<h1>ログイン</h1>
  <% if flash[:error] %>
    <p class="alert-faild">
      <%= flash[:error] %>
    </p>
  <% end %>
<%= form_with scope: :session, local: true do |f| %>
    <div>
      <%= f.label :メールアドレス %>
    </div>
    <div>
      <%= f.text_field :email %>
    </div>
    <div>
      <%= f.label :password, 'パスワード' %>
    </div>
    <div>
      <%= f.password_field :password %>
    </div>
    <div>
      <%= f.submit 'ログインする', class: 'btn btn-primary' %>
    </div>
<% end %>
