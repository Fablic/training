<div class="signin-bg">
  <div class="sign-card">
    <div class="card-title text-center">
      <h2>Login</h2>
    </div>
    <%= form_tag login_path, method: :post do %>
      <div class="form-group">
        <%= label_tag :username %>
        <%= text_field_tag :username, nil, class: "form-control", placeholder: "Enter your username" %>
      </div>

      <div class="form-group">
        <%= label_tag :password %>
        <%= password_field_tag :password, nil, class: "form-control", placeholder: "Enter your password" %>
      </div>

      <div class="form-group text-center">
        <%= submit_tag "Log in", class: "btn btn-primary" %>
      </div>
    <% end %>

    <%= link_to "Sign Up", new_user_path, class: "btn btn-link" %>
  </div>
</div>
