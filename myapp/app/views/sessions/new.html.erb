<h1>ログイン</h1>

<div class="row justify-content-center">
  <div class="col-md-6">
    <%= form_for(:session, url: login_path) do |f| %>
      <div class="mb-3">
        <%= f.label :email, t('users.label.email') %>
        <%= f.email_field :email, class: 'form-control' %>
      </div>
      <div class="mb-3">
        <%= f.label :password, t('users.label.password') %>
        <%= f.password_field :password, class: 'form-control' %>
      </div>
        <div class="mb-3">
        <%= f.submit "ログイン", class: "btn btn-primary", id: 'login_button' %>
      </div>
    <% end %>

    <p>新規登録は<%= link_to "こちら", signup_path %></p>
  </div>
</div>
