<%= t '.title'%><br>
<%= form_with model: @session, local: true do |f| %>
  <%= flash[:denger] %><br>
  <%= f.label :personal_id, t('.id') %><br>
  <%= f.text_field :personal_id %><br>

  <%= f.label :password, t('.pass') %><br>
  <%= f.password_field :password %><br>
  <%= f.submit t('.login') %><br>
<% end %>
