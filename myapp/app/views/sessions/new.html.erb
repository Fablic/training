<!DOCTYPE html>
<html>
  <head>
    <title>Task-u-ten</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>


<h1>Login</h1>
<p id="alert"><%= alert %></p>
<%= form_tag '/login' do %>
    <%= label_tag :username%>
    <%= text_field_tag :username %>
    <%= label_tag :password%>
    <%= password_field_tag :password%>
    <%= submit_tag "Login" %>
<%end%>


  </body>
</html>


