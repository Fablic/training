<div class="px-5">
  <h2><%= I18n.t('action.login') %></h2>

  <%= form_with scope: :session, url: login_path, method: :post, class:"d-inline" do |form| %>
    <div class="w-50 mx-auto">
      <div class="d-flex mb-4">
        <p class="w-25"><%= I18n.t(:email, scope: [:activerecord, :attributes, :user]) %></p>
        <%= form.text_field :email, class:"form-control w-75" %>
      </div>
      <div class="d-flex mb-4">
        <p class="w-25"><%= I18n.t(:password, scope: [:activerecord, :attributes, :user]) %></p>
        <%= form.password_field :password, class:"form-control w-75" %>
      </div>
      <%= form.submit I18n.t('action.login'), class:"d-block btn btn-primary mx-auto mb-3" %>
    </div>
  <% end %>

  <p class="text-center"><%= I18n.t('noaccount') %></p>
</div>
