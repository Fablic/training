<div class='mt-5 mb-5 container', style='text-align:center'>
  <h1><%= t('views.titles.login') %></h1>
</div>

<div class='mb-5 container'>
  <h4 class='fst-italic text-info', style='text-align:center'>
    <%= flash[:notice] %>
  </h4>
</div>

<div class='container'>
  <%= form_with url: login_path, local: true, data: {turbo: false} do |form| %>
    <div class='mb-3 w-75'>
      <%= form.label :username, t('views.labels.username'), class: 'form-label' %>
      <%= form.text_field :username, class: 'form-control' %>
    </div> 

    <div class='mb-3 w-75'>
      <%= form.label :password, t('views.labels.password'), class: 'form-label' %>
      <%= form.password_field :password, class: 'form-control' %>
    </div>

    <div class='mb-2'>
      <%= form.submit t('views.buttons.login'), class: 'btn btn-primary w-25' %>
    </div>

    <div>
      <%= t('views.texts.to_signup_1') %>
      <%= link_to t('views.texts.here'), signup_path %>
      <%= t('views.texts.to_signup_2') %>
    </div>
  <% end %>
</div>  
