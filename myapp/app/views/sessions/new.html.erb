<div class="alert alert-failed" style="color: red"><%= alert %></div>

<h1>ログイン画面</h1>
<div>
<%= form_with scope: :session, url: login_path, method: :post, local: true do |f| %>
  <div class='field'>
    <p>メールアドレス</p>
    <%= f.text_field :email %>
  </div>
  <div class='field'>
    <p>パスワード</p>
    <%= f.text_field :password %>
  </div>
  <br>
  <%= f.submit 'ログイン' %>
<% end %>
</div>
