<div class='mt-5 mb-5 container', style='text-align:center'>
  <h1>Log in</h1>
</div>

<div class='container'>
  <%= form_with url: users_path, local: true, data: {turbo: false} do |form| %>
    <div class='mb-3 w-75'>
      <%= form.label :username, class: 'form-label' %>
      <%= form.text_field :username, class: 'form-control' %>
    </div>  

    <div class='mb-3 w-75'>
      <%= form.label :password, class: 'form-label' %>
      <%= form.password_field :password, class: 'form-control' %>
    </div>

    <div class='mb-2'>
      <%= form.submit 'Log in', class: 'btn btn-primary w-25' %>
    </div>

    <div>
      New user? Click 
      <%= link_to 'here', users_signup_path %>
       to sign up.
    </div>
  <% end %>
</div>  
