<div class='mt-5 mb-5 container', style='text-align:center'>
  <h1><%= t('views.titles.signup') %></h1>
</div>

<div class='container'>
  <%= button_to t('views.buttons.back_to_login'), login_path, method: :get, class: 'mb-4 btn btn-outline-secondary' %>

  <%= form_with scope: :user, url: signup_path, local: true, data: {turbo: false} do |form| %>

    <%= render partial: 'common_components/error_display', locals: { model: @user } %>
    
    <div class='mb-3 w-75'>
      <%= form.label :username, class: 'form-label' %>
      <%= form.text_field :username, class: 'form-control' %>
    </div> 

    <div class='mb-3 w-75'>
      <%= form.label :password, class: 'form-label' %>
      <%= form.password_field :password, class: 'form-control' %>
    </div>

    <div class='mb-3 w-75'>
      <%= form.label :password_confirmation, class: 'form-label' %>
      <%= form.password_field :password_confirmation, class: 'form-control' %>
    </div> 

    <div>
      <%= form.submit t('views.buttons.signup'), class: 'btn btn-primary' %>
    </div>
  <% end %>
</div>  
