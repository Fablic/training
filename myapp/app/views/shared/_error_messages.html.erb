<% if flash['validation_error'].present? %>
  <div id="error_explanation">
    <div class="alert alert-danger">
      <%= I18n.t("form.error",smtg: flash['validation_error'].count)%>
    </div>
    <ul>
    <% flash['validation_error'].each do |msg| %>
      <li><%= msg %></li>
    <% end %>
    </ul>
  </div>
<% end %>
