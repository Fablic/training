<h1><%= t('task.titles.show') %></h1>

<table>
  <tr>
    <th><%= t('task.table.labels.title') %>:</th>
    <td><%= @task.title %></td>
  </tr>
  <tr>
    <th><%= t('task.table.labels.description') %>:</th>
    <td><%= @task.description %></td>
  </tr>
  <tr>
    <th><%= t('task.table.labels.priority') %>:</th>
    <td><%= @task.priority %></td>
  </tr>
  <tr>
    <th><%= t('task.table.labels.due_date') %>:</th>
    <td><%= @task.due_date %></td>
  </tr>
  <tr>
    <th><%= t('task.table.labels.status') %>:</th>
    <td><%= @task.status.humanize %></td>
  </tr>
</table>

<%= link_to t('task.links.edit'), edit_task_path(@task) %> |
<%= link_to t('task.links.index'), task_index_path %>