<h1>Task Details</h1>

<table>
  <tr>
    <th>Title:</th>
    <td><%= @task.title %></td>
  </tr>
  <tr>
    <th>Description:</th>
    <td><%= @task.description %></td>
  </tr>
  <tr>
    <th>Priority:</th>
    <td><%= @task.priority %></td>
  </tr>
  <tr>
    <th>Due Date:</th>
    <td><%= @task.due_date %></td>
  </tr>
  <tr>
    <th>Status:</th>
    <td><%= @task.status %></td>
  </tr>
</table>

<%= link_to 'Edit', edit_task_path(@task) %> |
<%= link_to 'All Taskst', task_index_path %>