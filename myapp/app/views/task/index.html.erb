<h1>All Tasks</h1>
<h4>
  <%= link_to 'Add Task', new_task_path %>
</h4>
<table border="1" cellpadding="5">
    <tr>
        <th>Title</th>
        <th>Status</th>
        <th>Due Date</th>
        <th>Priority</th>
        <th>Actions</th>
    </tr>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.title %></td>
        <td><%= task.status.humanize %></td>
        <td><%= task.due_date %></td>
        <td><%= task.priority %></td>
        <td>
          <%= link_to 'Show', task_path(task) %>
          <%= link_to 'Update', edit_task_path(task) %>
          <%= link_to 'Delete', task_path(task),
                      method: :DELETE,
                      data: { confirm: 'sure want to delete this task?' } %>
        </td>
      </tr>
    <% end %>
</table>