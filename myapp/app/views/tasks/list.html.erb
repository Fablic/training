<p><%= notice %></p>
<h1>Task List</h1>
<%= link_to("Create Task", tasks_new_path(), {class: "btn_a"}) %>
<br>
<br>
<table>
    <thead>
        <tr>
            <th>title</th>
            <th>label</th>
            <th></th>
            <th></th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        <% @tasks.each do |task| %>
            <tr>
                <td><span><%= task.title %></span></td>
                <td><span><%= task.label %></span></td>
                <td><%= link_to("Details", tasks_show_path(task), {id: "show#{task.id}" ,class: "btn_a"}) %></td>
                <td><%= link_to("Update", tasks_edit_path(task), {id: "update#{task.id}" ,class: "btn_a"}) %></td>
                <td><%= link_to("Delete", tasks_destroy_path(task), method: :delete, id: "delete#{task.id}" ,class: "btn_a") %></td>
            </tr>
        <% end %>
    </tbody>
</table>