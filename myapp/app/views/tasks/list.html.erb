<% if flash[:notice] %>
  <p><%= flash[:notice] %></p>
<% end %>
<section id="task-list-option">
    <div class="create-task-ticket list">
        <div class="create-field">
            <span class="task-id"><%= t("tasks.default.create_button") %></span>
        </div>
    </div>
    <div class="search-task-ticket">
        <%= form_with url: search_path, method: :get, local: true do |f| %>
        <%= f.text_field :keyword, value: @keyword %>
        <% status = {t(".not_choose") => "", t("enums.task.status.not_started") => 1,t("enums.task.status.start") => 2,t("enums.task.status.done") => 3,} %>
        <%= f.select :status, status, :selected => @status %>
        <%= f.submit t(".search") %>
        <% end %>
    </div>
</section>

<section id="task-list">
<% @tasks.each do |task| %>
    <div class="task-ticket" draggable="true" value=111>
        <div class="task-id-field">
            <a class="none-under-line" href="/tasks/<%= task.id %>">#<%= task.id %></a>
        </div>
        <div class="task-title-field">
            <span class="task-title"><%= task.title %></span>
        </div>
    </div>
<% end %>
</section>

<div class="trash-box">
<span class="trash-box"><%= t(".garbage") %></span>
</div>

<%= javascript_pack_tag 'tasks_list', 'data-turbolinks-track': 'reload' %>
