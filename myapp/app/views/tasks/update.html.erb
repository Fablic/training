<h1>タスク登録</h1>

<%= form_for @task do |t| %>
  <p>
  <%= t.label :task_name %>
  <%= t.text_field :task_name %>
  </p>
 
  <p>
  <%= t.label :description %>
  <%= t.text_field :description %>
  </p>
 
  <p>
  <%= t.label :status %>
  <%= t.text_field :status %>
  </p>
 
  <p>
  <%= t.label :priority %>
  <%= t.text_field :priority %>
  </p>
 
  <p>
  <%= t.label :label %>
  <%= t.text_field :label %>
  </p>
 
  <p>
  <%= t.label :start_date %>
  <%= t.text_field :start_date %>
  </p>
 
  <p>
  <%= t.label :end_date %>
  <%= t.text_field :end_date %>
  </p>

  <%= t.submit %> 
<% end %>

