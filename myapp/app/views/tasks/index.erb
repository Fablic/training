<h1><%= t '.title' %></h1>
<% flash.each do |message_type, message| %>
  <div class="alert alert-<%= message_type %>"><%= message %></div>
<% end %>
<table>
  <thead>
    <tr>
      <th><%= t 'tasks.title' %></th>
      <th><%= t 'tasks.description' %></th>
      <th><%= t 'tasks.created_at' %></th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @tasks.each do |t| %>
    <tr>
      <td><%= t.title %></td>
      <td><%= t.description %></td>
      <td><%= l t.created_at, format: :long %></td>
      <td>
         <td><%= link_to t('.edit_task'), edit_task_path(t) %></td>
      </td>
      <td>
         <%= link_to t('.delete_task'), task_path(t), method: :delete %>
      </td>
    </tr>
    <% end %>
  </tbody>
</table>
<%= link_to t('.add_new_task'), new_task_path %>
