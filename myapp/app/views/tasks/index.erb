<%= render partial: 'layouts/page_title', locals: { title: t('.title') } %>

<div class="p-3">
  <form>
    <%= form_with url: "/", method: :get, local: true do |form| %>
      <div class="col mb-3">
        <%= form.label :search_text, t('.search_label'), class: 'form-label' %>
        <%= form.text_field :search_text, value:@search_text, id: 'search_text' %>
        <%= form.select :search_status, options_for_select(Task.statuses.map { |key, v| [t("enums.task.status.#{key}"), v] }, selected: @search_status), {}, {id: "search_status", class: "form-select-sm" } %>
        <%= form.hidden_field :sort, :value => @sort_column%>
        <%= form.hidden_field :type, :value => @sort_type%>
        <%= form.submit t('.search_submit'), class: 'btn btn-primary' %>
      </div>
    </form>
  <% end %>
</div>

<%= render partial: 'layouts/flash_messages', locals: { flash: flash } %>

<%= paginate @tasks, theme: 'bootstrap-5' %>
<table class="table table-striped">
  <thead>
    <tr>
      <th><%= t 'tasks.title' %></th>
      <th><%= t 'tasks.description' %></th>
      <th><%= t 'tasks.status' %></th>
      <th><%= link_to t('tasks.due_date'), { sort: 'due_date', type: sort_order('due_date'), search_text: @search_text, search_status: @search_status } %></th>
      <th><%= t 'tasks.created_at' %></th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @tasks.each do |t| %>
    <tr>
      <td><%= t.title %></td>
      <td><%= t.description %></td>
      <td><%= t("enums.task.status.#{t.status}") %></td>
      <td><%= l t.due_date, format: :date_only %></td>
      <td><%= l t.created_at, format: :date_only %></td>
      <td>
         <td><%= link_to t('.edit_task'), edit_task_path(t), class: "btn btn-outline-primary btn-sm" %></td>
      </td>
      <td>
         <%= link_to t('.delete_task'), task_path(t), method: :delete, class: "btn btn-danger btn-sm" %>
      </td>
    </tr>
    <% end %>
  </tbody>
</table>
<%= paginate @tasks, theme: 'bootstrap-5' %>
<%= link_to t('.add_new_task'), new_task_path, {id: 'task-add-btn', class: 'btn btn-primary'} %>
