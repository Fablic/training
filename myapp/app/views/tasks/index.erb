<h1>タスク一覧</h1>
<% flash.each do |message_type, message| %>
  <div class="alert alert-<%= message_type %>"><%= message %></div>
<% end %>
<table>
  <thead>
    <tr>
      <th>タスク</th>
      <th>説明</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @tasks.each do |t| %>
    <tr>
      <td><%= t.title %></td>
      <td><%= t.description %></td>
      <td>
         <td><%= link_to '編集', edit_task_path(t) %></td>
      </td>
      <td>
         <%= link_to '削除', task_path(t), method: :delete %>
      </td>
    </tr>
    <% end %>
  </tbody>
</table>
<%= link_to 'タスク新規追加', new_task_path %>