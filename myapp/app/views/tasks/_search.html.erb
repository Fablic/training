<div class="search_form">
  <%= form_with url: search_path, local: true, method: :get do |form| %>
    <%= form.text_field :title, id: 'search_word' %>
    <%= form.select :status, Task.statuses.keys.map { |k| [t("enums.task.status.#{k}"), k] }, { selected: 1 } %>
    <%= form.submit '検索', id: 'search_submit' %>
  <% end %>
  </div>
</div>
