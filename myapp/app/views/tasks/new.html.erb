<h1>タスク新規登録</h1>

<%= form_with model: @task, local: true do |f| %>

    <div class="form-group">
     <label>タスク名</label>
     <%= f.text_field :title, class: "form-control" %>
    </div>

    <div class="form-group">
     <label>タスク内容</label>
     <%= f.text_field :content, class: "form-control" %>
    </div>

    <div class="form-group">
     <label>優先度</label>
     <%= f.select :priority, [["低",1],["中",2],["高",3]], {}, {class: "form-control"} %>
    </div>

    <div class="form-group">
     <label>ステータス</label>
     <%= f.select :status, [["未着手",0],["実施中",1],["完了",3],["保留",9]], {}, {class: "form-control"} %>
    </div>

    <div class="form-group">
     <label>終了期限</label>
     <%= f.datetime_field :due_date, class: "form-control" %>
    </div>

    <%= f.submit "登録", class: "btn btn-primary" %>
    <%= link_to "戻る", tasks_path, class: "btn btn-secondary" %>
<% end %>
