<h1>Tasks#new</h1>
<div>
  <%= form_with(model: Task) do |form| %>
    <div>
      <%= form.label :title, 'たいとる' %>
      <%= form.text_field :title %>
    </div>

    <div>
      <%= form.label :description, 'ですくりぷしょん' %>
      <%= form.text_field :description %>
    </div>

    <div class="actions">
      <%= form.submit :submit %>
    </div>
  <% end %>
</div>

<%= link_to 'Back', tasks_path %>
