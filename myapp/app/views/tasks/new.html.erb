<h1 class="text-muted pb-3" >タスク登録</h1>
  <%= form_for(@task) do |f| %>
    <div>
      <%= f.label :タイトル %>
    </div>
    <div>
      <%= f.text_field :title, :class=>"form-control" %>
    </div>
    <div>
      <%= f.label :説明 %>
    </div>
    <div>
      <%= f.text_area :description, :class=>"form-control" %>
    </div>
    <div class="d-grid gap-2">
      <input type="submit" name="commit" value="登録" class="btn btn-primary mt-2" data-disable-with="登録">
    </div>
  <% end %>
<%= link_to '一覧に戻る', tasks_path %>
