<% content_for :title do %>
<%= I18n.t('tasks.new.title')%>
<% end %>

<div class="navi">
    <%= link_to I18n.t('tasks.new.to_index'), tasks_path %>
</div>

<% if @task.errors.any? %>
<div class="errors">
    <ul>
<% @task.errors.full_messages.each do |message| %>
        <%= content_tag(:li, message, class: 'alert') %>
<% end %>
    </ul>
</div>
<% end %>

<%= render "tasks/form" %>
