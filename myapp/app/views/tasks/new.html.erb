<h1>Create Task</h1>
<%= form_with(model: @task, url: tasks_create_path()) do |f| %>
    <p>Title</p>
    <%= f.text_field(:title) %>
    <p>Description</p>
    <%= f.text_field(:description) %>
    <p>Label</p>
    <%= f.text_field(:label) %>
    <p>User</p>
    <%= f.select(:user_id, @user_names) %>
    <br>
    <br>
    <%= f.submit("Create") %>
<% end %>
<%= link_to("Back", "/") %>