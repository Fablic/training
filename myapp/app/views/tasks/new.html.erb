<h1>タスクの作成</h1>

<%= form_with model: @task, local: true do |f| %>
<%= render 'layouts/error_messages' %>
<div>
  <%= f.label :title, '件名' %>
  <%= f.text_field :title %>
</div>
<div>
  <%= f.label :content, '詳細' %>
  <%= f.text_area :content %>
</div>
<div>
<%= f.submit '投稿' %>
</div>
<% end %>

<p><%= link_to '一覧に戻る', tasks_path %></p>
