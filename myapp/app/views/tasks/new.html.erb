<div>
  <%= form_with(mode: @task, local:true) do |f| %>
    <%= f.label :title %>
    <%= f.text_field :title %>

    <%= f.label :description %>
    <%= f.text_field :description %>

    <%= f.label :priority %>
    <%= f.select :priority %>

    <%= f.label :status %>
    <%= f.select :status %>
  <% end %>
</div>