<%= form_with(url: tasks_path, method: :get, local: true) do |form| %>
  <div>
    <%= form.label :keyword, 'キーワード検索', style: "display: block" %>
    <%= form.text_field :keyword, placeholder: I18n.t('select_form.placeholder') %>
  </div>

  <div>
    <%= form.label :status, 'ステータスで絞り込む', style: "display: block" %>
    <%= form.select :status, I18n.t('select_form.task.status'), include_blank: I18n.t('select_form.include_blank') %>
  </div>

  <div>
    <%= form.label :sort, 'ソート', style: "display: block" %>
    <%= form.select :sort, I18n.t('select_form.search_form.sort')  %>
  </div>

  <div>
    <%= form.submit '送信' %>
  </div>
<% end %>
