<h1><%= t('.title') %></h1>
<%= render 'flash' %>

<h3><%= @task.title %></h3>
<p><%= @task.description %></p>
<ul>
<% @task.labels.each do |label| %>
  <li><%= label.label %></li>
<% end %>
</ul>
<p><%= @task.expiration_date.nil? ? '' : @task.expiration_date.strftime("%Y-%m-%d %H:%M:%S") %></p>
<p><%= t("activerecord.attributes.task.statuses.#{@task.status}") %></p>

<p><%= link_to t('tasks.index.title'), tasks_path %></p>
