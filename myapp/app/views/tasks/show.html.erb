<% content_for :title do %>
<%= t('.title')%>
<% end %>

<div class="navi">
    <%= link_to t('dictionary.button.to_index'), tasks_path %>
</div>

<div class="task-show">
    <dl>
        <dt><%= t('tasks.labels.title') %>:</dt>
        <dd><%= @task.title %></dd>
        <dt><%= t('tasks.labels.body') %>:</dt>
        <dd><%= raw(h(@task.body).gsub(/\R/, "<br>")) %></dd>
        <dt><%= t('tasks.labels.deadline') %>:</dt>
        <dd><%= @task.deadline %></dd>
        <dt><%= t('tasks.labels.priority') %>:</dt>
        <dd><%= @task.priority %></dd>
        <dt><%= t('tasks.labels.status') %>:</dt>
        <dd><%= @task.status %></dd>
        <dt><%= t('tasks.labels.label') %>:</dt>
        <dd><%= @task.label_id %></dd>
    </dl>
</div>
