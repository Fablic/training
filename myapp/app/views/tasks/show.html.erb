<% flash.each do |message_type, message| %>
  <%= message %>
<% end %>

<h1><%= I18n.t 'tasks.show.title' %></h1>

<h2><%= @task.title %></h2>
<p><%= "#{Task.human_attribute_name :description}: #{@task.description}" %></p>

<%= link_to (I18n.t 'common.edit'), edit_task_path(@task) %>
<%= link_to (I18n.t 'common.delete'), task_path(@task),
  method: :delete,
  data: { confirm: (I18n.t 'common.messages.confirm_delete') }
%>
<%= link_to (I18n.t 'tasks.index.title'), tasks_path %>
