<div class="alert alert-success" style="color: green"><%= notice %></div>

<h1><%= I18n.t('page_titles.tasks.show') %></h1>

<div>
  <p>
    <strong><%= Task.human_attribute_name(:name) %>:</strong>
    <%= @task.name %>
  </p>

  <p>
    <strong><%= Task.human_attribute_name(:description) %>:</strong>
    <%= @task.description %>
  </p>

  <p>
    <strong><%= Task.human_attribute_name(:status) %>:</strong>
    <%= I18n.t("enums.task.status.#{@task.status}") %>
  </p>

  <p>
    <strong><%= I18n.t(Label.model_name.human) %></strong>
    <% @task.labels.each do |label| %>
      <%= label.name %>
    <% end %>
  </p>

  <p>
    <strong><%= Task.human_attribute_name(:created_at) %>:</strong>
    <%= @task.created_at %>
  </p>

  <p>
    <strong><%= Task.human_attribute_name(:updated_at) %>:</strong>
    <%= @task.updated_at %>
  </p>
</div>
<br>

<%= link_to I18n.t('buttons.tasks.edit'), edit_task_path(@task.id) %>
<%= link_to I18n.t('buttons.tasks.delete'), task_path(@task.id), method: :delete, data: { confirm: "タスク「#{@task.name}」を削除します。よろしいですか？"} %>
<%= link_to I18n.t('buttons.tasks.index'), tasks_path %>
