<h1><%= t '.title' %></h1>

<h2><%= @task.title %></h2>
<p><%= (Task.human_attribute_name :description) + ":" +  @task.description %></p>

<%= link_to (t 'tasks.common.edit'), edit_task_path(@task) %>
<%= link_to (t 'tasks.common.delete'), task_path(@task),
    method: :delete,
    data: { confirm: (t 'tasks.messages.confirm_delete') }
%>
<%= link_to (t 'tasks.index.title'), tasks_path %>
