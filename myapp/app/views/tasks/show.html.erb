<h1>Tasks#detail</h1>

<table>
  <tr>
    <th><%= t('tasks.title') %></th>
    <td><%= @task.title %></td>
  </tr>
  <tr>
    <th><%= t('tasks.description') %></th>
    <td><%= @task.description %></td>
  </tr>
  <tr>
    <th><%= t('tasks.created_at') %></th>
    <td><%= l @task.created_at %></td>
  </tr>
  <tr>
    <th><%= t('tasks.due_date') %></th>
    <td><%= l @task.due_date %></td>
  </tr>
  <tr>
</table>

<p><%= link_to t('tasks.back'), root_path %></p>

<p><%= link_to t('tasks.edit'), edit_task_path(@task) %></p>
