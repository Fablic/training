<div class="container-sm mt-4">
  <div class="d-flex justify-content-between align-items-center">
    <h1><%= t('views.tasks.show.title') %></h1>
    <%= button_to t('views.common.delete'), task_path(@task), method: :delete, form: { data: { turbo_confirm: t('views.common.confirm') }}, class: "btn btn-danger ml-auto" %>
  </div>
  <%= form_with model: @task, local: true do |form| %>
    <%= render "form", form: form %>
  <% end %>
  <div class="d-flex justify-content-between">
    <%= link_to t('views.common.cancel'), tasks_path, class: "btn btn-secondary" %>
    <%= link_to t('views.common.edit'), edit_task_path(@task), class: "btn btn-primary" %>
  </div>
</div>
