<% provide(:title, '詳細') %>

<div class="d-flex justify-content-end ">
  <div class='btn-toolbar' role="toolbar">
    <%= link_to '一覧に戻る', root_path, class: 'btn btn-outline-primary mx-1' %>
  </div>
</div>

<div class="card border border-0">
  <div class="card-body">
    <h5 class="card-title">
      <%= @task.title %>
      <span class="badge rounded-pill bg-info text-dark p-1">
      <%= I18n.t("activerecord.attributes.task.statuses.#{@task.status}") %>
      </span>
    </h5>
    <p class="card-text"><%= @task.content %></p>
    <p>終了期限:<%= I18n.l(@task.deadline, format: :short, default: '') %></p>
    <p>作成日:<%= I18n.l(@task.created_at, format: :short) %></p>
    <%= link_to '編集する', edit_task_path(@task), class: 'btn btn-primary mx-1' %>
    <%= link_to '削除する', @task, method: :delete, data:{ confirm: '本当によろしいですか？'}, class: 'btn btn-dark mx-1' %>
  </div>
</div>
