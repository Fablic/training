<% content_for(:page_title, I18n.t('tasks.show.title')) %>

<%= link_to t('dictionary.button.edit'), edit_task_path(@task) %>

<%= link_to t('dictionary.button.destory'), @task, method: :delete, data: {confirm: "Do you want to delete #{@task.name}?"} %>

<h2>
  <%= @task.name %>
</h2>

<div>
  <p>
    <%= @task.description %>
  </p>
  <span>
    <label>Status</label>
    <%= @task.status_i18n %>
    <label>Priority</label>
    <%= @task.priority_i18n %>
    <label>Limit</label>
    <%= @task.limit %>
  </span>
</div>

<%= link_to t('dictionary.button.home'), root_path %>
