<p id="notice"><%= notice %></p>

<h1><%= t "tasks.show.page_title", task_title: @task.title %></h1>

<div>
    <strong><%= t "tasks.title" %></strong>
    <br />
    <%= @task.title %>
</div>
<div>
    <em><%= t "tasks.description" %></em>
    <br />
    <%= @task.description %>
</div>
<div>
    <em><%= t "tasks.termination_date" %></em>
    <br />
    <%= @task.termination_at.strftime("%Y-%m-%d %H:%M:%S") %>
</div>
<div>
    <em><%= t "tasks.priority" %></em>
    <br />
    <% if @task.priority == 0 %>
        <p><%= t "tasks.priority00" %>
    <% elsif @task.priority == 1 %>
        <p><%= t "tasks.priority01" %>
    <% else %>
        <p><%= t "tasks.priority02" %>
    <% end %>
</div>
<div>
    <em><%= t "tasks.status" %></em>
    <br />
    <% if @task.status == 0 %>
        <p><%= t "tasks.status00" %></>
    <% elsif @task.status == 1 %>
        <p><%= t "tasks.status01" %></>
    <% else %>
        <p><%= t "tasks.status02" %></>
    <% end %>
</div>

<%= link_to t('tasks.back'), tasks_path %>
