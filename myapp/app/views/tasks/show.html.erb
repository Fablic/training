
<% content_for(:page_title, 'Task detail') %>

<h1> Task Detail Page </h1>

<h2>
  <%= @task.name %>
</h2>
<p>
  <%= @task.description %>
</p>
<p>
  <%= @task.status %>
</p>
<p>
  <%= @task.priority %>
</p>
<p>
  <%= @task.duedate %>
</p>
<p>
  <% @task.labels.each do |label| %>
    <%= label.name %>
  <% end %>
</p>


<p id="notice"><%= notice %></p>



<%= link_to t('pages.task_list_page.edit_task'), edit_task_path(@task) %>
<%= link_to t('back'), tasks_path %>
<%= button_to t('pages.task_list_page.delete_task'), @task, method: :delete, data: {confirm: "Do you want to delete #{@task.name}?"} %>


