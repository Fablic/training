<h1><%= I18n.t('activerecord.models.task').capitalize %> <%= I18n.t('helpers.show').capitalize %></h1>

<%= I18n.t('activerecord.attributes.task.id') %>: <%= @task.id %> <br>
<%= I18n.t('activerecord.attributes.task.title') %>: <%= @task.title %> <br>
<%= I18n.t('activerecord.attributes.task.description') %>: <%= @task.description %> <br>
<%= I18n.t('activerecord.attributes.task.due_date') %>: <%= @task.due_date.strftime('%F') %> <br>
<%= I18n.t('activerecord.attributes.task.created_at') %>: <%= @task.created_at.strftime('%F %T') %> <br>

<%= link_to I18n.t('helpers.edit'), edit_task_path(@task) %> |
<%= link_to I18n.t('helpers.delete'), task_path(@task), method: 'delete', data: { confirm: 'Are you sure you want to delete?'} %> |
<%= link_to I18n.t('helpers.back'), tasks_path %>
