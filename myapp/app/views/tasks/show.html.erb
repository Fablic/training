<h1>Tasks#detail</h1>

<table class="table">
  <tr>
    <th class="text-white bg-dark col-2"><%= t('tasks.title') %></th>
    <td><%= @task.title %></td>
  </tr>
  <tr>
    <th class="text-white bg-dark col-2"><%= t('tasks.description') %></th>
    <td><%= @task.description %></td>
  </tr>
  <tr>
    <th class="text-white bg-dark col-2"><%= t('tasks.created_at') %></th>
    <td><%= l @task.created_at %></td>
  </tr>
  <tr>
    <th class="text-white bg-dark col-2"><%= t('tasks.due_date') %></th>
    <td><%= l @task.due_date %></td>
  </tr>
  <tr>
    <th class="text-white bg-dark col-2"><%= t('tasks.status') %></th>
    <td><%= t("activerecord.attributes.task.status.#{@task.status}") %></td>
  </tr>
</table>

<div class="d-flex align-items-start">
  <%= link_to t('tasks.back'), tasks_path, class: 'btn btn-secondary p-2' %>
  <%= link_to t('tasks.edit'), edit_task_path(@task), class: 'btn btn-secondary p-2 ml-3'%>
</div>
