<div class="alert alert-success" style="color: green"><%= notice %></div>

<h1>タスク詳細画面</h1>

<div>
  <p>
    <strong>タスク名:</strong>
    <%= @task.name %>
  </p>

  <p>
    <strong>詳細:</strong>
    <%= @task.detail %>
  </p>

  <p>
    <strong>ステータス:</strong>
    <%= I18n.t("enums.task.status.#{@task.status}") %>
  </p>

  <p>
    <strong>優先度:</strong>
    <%= I18n.t("enums.task.priority.#{@task.priority}") %>
  </p>

  <p>
    <strong>担当者:</strong>
    <%= @task.user.user_name %>
  </p>

  <p>
    <strong>ラベル:</strong>
    <% @task.labels.each do |label| %>
      <%= label.label_name %>
    <% end %>
  </p>

  <p>
    <strong>登録日時:</strong>
    <%= @task.created_at %>
  </p>

  <p>
    <strong>更新日時:</strong>
    <%= @task.updated_at %>
  </p>
</div>
<br>

<%= link_to '編集', edit_task_path(@task.id) %>
<%= link_to '削除', task_path(@task.id), method: :delete, data: { confirm: "タスク「#{@task.name}」を削除します。よろしいですか？"} %>
<br>
<br>

<%= link_to '一覧へ戻る', tasks_path %>
