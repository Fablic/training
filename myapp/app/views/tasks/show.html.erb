<h1>Task Details</h1>
<p><%= I18n.t('task.title') %></p>
<p><%= @task.title %></p>
<p><%= I18n.t('task.description') %></p>
<p><%= @task.description %></p>
<p><%= I18n.t('task.label') %></p>
<% @task.labels.each do |label| %>
