<% content_for :title do %>
<%= I18n.t('tasks.show.title')%>
<% end %>

<div class="navi">
    <%= link_to I18n.t('tasks.show.to_index'), tasks_path %>
</div>

<div class="task-show">
    <dl>
        <dt><%= I18n.t('activerecord.attributes.tasks.title') %>:</dt>
        <dd><%= @task.title %></dd>
        <dt><%= I18n.t('activerecord.attributes.tasks.body') %>:</dt>
        <dd><%= raw(h(@task.body).gsub(/\R/, "<br>")) %></dd>
        <dt><%= I18n.t('activerecord.attributes.tasks.deadline') %>:</dt>
        <dd><%= @task.deadline %></dd>
        <dt><%= I18n.t('activerecord.attributes.tasks.priority') %>:</dt>
        <dd><%= @task.priority %></dd>
        <dt><%= I18n.t('activerecord.attributes.tasks.status') %>:</dt>
        <dd><%= @task.status %></dd>
        <dt><%= I18n.t('activerecord.attributes.tasks.label_id') %>:</dt>
        <dd><%= @task.label_id %></dd>
    </dl>
</div>
