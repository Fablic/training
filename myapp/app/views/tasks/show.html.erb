<div class='mt-5 mb-5 container', style='text-align:center'> 
  <h1><%= t('views.titles.show_task') %></h1>
</div>

<%= render 'log_out' %>

<div class='container'>
  <button class='mb-4 btn btn-outline-secondary'>
    <%= link_to t('views.buttons.back_to_home'), tasks_path, method: :get , class: 'link-without-underline link-secondary' %>
  </button>

  <div class='mb-3 container border rounded'>
    <h2><%= t('activerecord.attributes.task.title') %></h2>
    <hr class='w-25 hr-style'>
    <h3><%= @task.title %></h3>
  </div>  
  
  <div class='mb-3 container border rounded'>
    <h2><%= t('activerecord.attributes.task.description') %></h2>
    <hr class='w-25 hr-style'>
    <h3><%= @task.description %></h3>
  </div>

  <div class='mb-3 container border rounded'>
    <h2><%= t('activerecord.attributes.task.due') %></h2>
    <hr class='w-25 hr-style'>
    <h3 class='fst-italic'><%= l @task.due %></h3>
  </div>


  <div class='mb-3 container border rounded'>
    <h2><%= t('activerecord.attributes.task.status') %></h2>
    <hr class='w-25 hr-style'>
    <div class='mb-2'>
      <%= status_label(@task) %>
    </div>
  </div>

  <p>
    <%= button_to t('views.buttons.edit'), edit_task_path(@task), method: :get, class: 'btn btn-outline-success' %>
  </p>
</div>
