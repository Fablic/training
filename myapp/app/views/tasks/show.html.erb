
<% content_for(:page_title, 'Task detail') %>

<nav class="navbar navbar-expand-lg navbar-light m-3" style="background-color: darkred;">
  <div class="navbar-brand" style="color: white;">
    <h1><%= t('pages.task_detail_page.title') %></h1>
  </div>
</nav> 

<div class="container" style="width: 90%; margin: 0 auto;">
  <div class="row">
    <div class="col-sm-12">
      <div class="form-group p-3 mb-2 bg-light text-dark border border-secondary">
<h2>
  <%= @task.name %>
</h2>
<p>
  <%= @task.description %>
</p>
<p>
  <%= @task.status %>
</p>
<p>
  <%= @task.priority %>
</p>
<p>
  <%= @task.duedate %>
</p>
<p>
  <% @task.labels.each do |label| %>
    <%= label.name %>
  <% end %>
</p>
</div>
</div>
</div>



<p id="notice"><%= notice %></p>



<%= link_to t('pages.task_list_page.edit_task'), edit_task_path(@task) %>
<%= link_to t('back'), tasks_path %>
<%= button_to t('pages.task_list_page.delete_task'), @task, method: :delete, data: {confirm: "Do you want to delete #{@task.name}?"} %>


