<h1><%= t("page.task_detail") %></h1>

<% if flash[:notice] %>
  <div class="alert alert-success"><%= flash[:notice] %></div>
<% end %>
<% if flash[:alert] %>
  <div class="alert alert-danger"><%= flash[:alert] %></div>
<% end %>

<div class="container">
<p>
  <strong><%= t('name') %>:</strong>
  <%= @task.name %>
</p>

<p>
  <strong><%= t('description') %>:</strong>
  <%= @task.description %>
</p>

<p>
  <strong><%= t('priority') %>:</strong>
  <%= t("activerecord.attributes.task.priorities.#{@task.priority}") %>
</p>

<p>
  <strong><%= t('status') %>:</strong>
  <%= t("activerecord.attributes.task.statuses.#{@task.status}") %>
</p>

<p>
  <strong><%= t('deadline') %>:</strong>
  <%= @task.deadline ? @task.deadline.strftime("%Y-%m-%d %H:%M") : "None" %>
</p>

<span>
  <%= link_to t("button.update_task"), edit_task_path(@task), class:"btn btn-secondary" %>
</span>
<span>
  <%= link_to t("button.back"), tasks_path, class:"btn btn-secondary" %>
</span>
</div>
