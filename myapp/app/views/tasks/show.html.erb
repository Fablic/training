<div class="alert alert-success" style="color: green"><%= notice %></div>

<h1><%= t('tasks.show.page_title') %></h1>

<div>
  <p>
    <strong><%= Task.human_attribute_name(:name) %></strong>
    <%= @task.name %>
  </p>

  <p>
    <strong><%= Task.human_attribute_name(:detail) %></strong>
    <%= @task.detail %>
  </p>

  <p>
    <strong><%= Task.human_attribute_name(:status) %></strong>
    <%= I18n.t("enums.task.status.#{@task.status}") %>
  </p>

  <p>
    <strong><%= Task.human_attribute_name(:priority) %></strong>
    <%= I18n.t("enums.task.priority.#{@task.priority}") %>
  </p>

  <p>
    <strong><%= Task.human_attribute_name(:created_at) %></strong>
    <%= @task.created_at %>
  </p>

  <p>
    <strong><%= Task.human_attribute_name(:updated_at) %></strong>
    <%= @task.updated_at %>
  </p>
</div>
<br>

<%= link_to t('common.link.tasks.edit'), edit_task_path(@task.id) %>
<%= link_to t('common.link.tasks.delete'), task_path(@task.id), method: :delete, data: { confirm: "タスク「#{@task.name}」を削除します。よろしいですか？" } %>
<br>
<br>

<%= link_to t('common.link.tasks.back_to_index'), tasks_path %>
