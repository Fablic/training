<p style="color: green"><%= notice %></p>

<%= link_to '編集する', edit_task_path(@task) %> |
<%= link_to '一覧に戻る', tasks_path %>

<table border="1">
  <tr>
    <th>タスク名</th>
    <th>終了時刻</th>
    <th>優先度</th>
    <th>ステータス</th>
    <th>説明</th>
  </tr>
  <tr>
    <td><%= @task.name %></td>
    <td><%= time_zone(@task.end_date) %></td>
    <td><%= @task.priority %></td>
    <td><%= @task.status %></td>
    <td><%= @task.explanation %></td>
  </tr>
</table>

<%= button_to '削除する', @task, method: :delete %>
