<p style="color: green"><%= notice %></p>

<%= link_to I18n.t('transition_destination.edit'), edit_task_path(@task) %> |
<%= link_to I18n.t('transition_destination.index'), tasks_path %>

<table border="1">
  <tr>
    <th>タスク名</th>
    <th>終了時刻</th>
    <th>優先度</th>
    <th>ステータス</th>
    <th>説明</th>
  </tr>
  <tr>
    <td><%= @task.name %></td>
    <td><%= time_zone(@task.end_date) %></td>
    <td><%= task_priority_enum_to_ja(@task.priority) %></td>
    <td><%= task_status_enum_to_ja(@task.status) %></td>
    <td><%= @task.explanation %></td>
  </tr>
</table>

<%= button_to I18n.t('transition_destination.destroy'), @task, method: :delete %>
