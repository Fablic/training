<h1><%= t('page_titles.tasks_show') %></h1>

<table>
  <tr>
    <th>Name:</th>
    <td><%= @task.name %></td>
  </tr>
  <tr>
    <th>Description:</th>
    <td><%= @task.description %></td>
  </tr>
  <tr>
    <th>Priority:</th>
    <td><%= @task.priority %></td>
  </tr>
  <tr>
    <th>Deadline:</th>
    <td><%= @task.deadline %></td>
  </tr>
  <tr>
    <th>Status:</th>
    <td><%= @task.status %></td>
  </tr>
</table>

<%= link_to t('task.edit_task_link'), edit_task_path(@task) %> |
<%= link_to t('task.back_to_tasks_link'), tasks_path %>
