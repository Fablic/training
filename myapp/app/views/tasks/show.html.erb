<h1><%= @task.title %>の詳細</h1>
  <ul>
    <li>タスク
      <div>
        <%= @task.title %>
      </div>
    <li>説明
      <div>
        <%= @task.description %>
      </div>
    <li>ステータス
      <div>
        <%= @task.status %>
      </div>
    <li>ラベル
      <div>
        <%= @task.label %>
      </div>
    <li>ユーザID
      <div>
        <%= @task.user_id %>
      </div>
    <li>登録日時
      <div>
        <%= @task.created_at %>
      </div>
    <li>更新日時
      <div>
        <%= @task.updated_at %>
      </div>

  </ul>
  <div>
    <%= link_to '編集', edit_task_path(@task) %>
    <%= link_to '削除', task_path(@task), method: :delete, data: {confirm: "削除しますか？"} %>
  </div>
<%= link_to '一覧に戻る', tasks_path %>
