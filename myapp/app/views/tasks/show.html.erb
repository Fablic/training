<h1>Task</h1>

<table>
  <thead>
    <tr>
      <% Task.column_names.each do |t| %>
        <th><%= t %></th>
      <% end %>
    </tr>
  </thead>
  <tbody>
    <tr>
      <% @task.attributes.values.each do |v| %>
        <th><%= v %></th>
      <% end %>
    </tr>
  </tbody>
</table>

<%= link_to "List", "/tasks", {style: "display: block;"} %>
