<div class="container pt-5">
  <h1><%= t('.detail') %></h1>
  <div class="row">
    <aside class="col-md-4">
      <section class="task_info">
        <h2>
          <%= @task.title %>:
        </h2>
        <p>
          <%= @task.description %>:
        </p>
        <p>
          <%= t('tasks.form.status') %>:
          <%= @task.status %>
        </p>
        <p>
          <%= t('tasks.form.expire') %>:
          <%= @task.expire_at %>
        </p>
        <p>
          <%= t('tasks.form.created_at') %>:
          <%= @task.created_at %>
        </p>
        <p>
          <%= t('tasks.form.label') %>:
          <% @task.labels.each do |label| %>
            <%= label.name %>
          <% end %>
        </p>
      </section>
    </aside>
  </div>
</div>
