<div class="container">
  <h1><%= t '.detail' %></h1>
  <div class="row">
    <aside class="col-md-4">
      <section class="task_info">
        <h1>
          <%= t '.title' %>
          <%= @task.title %>
        </h1>
        <p>
          <%= t '.description' %>
          <%= @task.description %>
        </p>
        <p>
          <%= t '.expire' %>
          <%= @task.expire_at %>
        </p>
      </section>
    </aside>
  </div>
</div>
