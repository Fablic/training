<div class="px-5">
  <h2><%= I18n.t('activerecord.models.task') %> <%= I18n.t('action.show') %></h2>

  <table class='table'>
    <tbody>
      <% Task.column_names.each do |column_name| %>
        <tr>
          <th class="w-25"><%= I18n.t(column_name.to_sym, scope: [:activerecord, :attributes, :task]) %></th>
          <td class="w-75 text-break"><%= value_with_i18n(@task, column_name) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= link_to I18n.t('action.list'), tasks_path, class:"btn btn-primary" %>
  <%= link_to I18n.t('action.edit'), edit_task_path(@task), class:"btn btn-primary" %>
</div>
