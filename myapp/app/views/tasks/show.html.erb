<p id="notice"><%= notice %></p>

<h1><%= t('tasks.show.page_title', task_title: @task.title) %></h1>

<div>
    <strong><%= t('tasks.title') %></strong>
    <br>
    <%= @task.title %>
</div>
<div>
    <em><%= t('tasks.description') %></em>
    <br>
    <%= @task.description %>
</div>
<div>
    <em><%= t('tasks.termination_date') %></em>
    <br>
    <%= @task.termination_at.strftime("%Y-%m-%d %H:%M:%S") %>
</div>
<div>
    <em><%= t('tasks.priority') %></em>
    <br>
    <p><%= Task.human_attribute_name("priority.#{@task.priority}") %></p>
</div>
<div>
    <em><%= t('tasks.status') %></em>
    <br>
    <p><%= Task.human_attribute_name("status.#{@task.status}") %></p>
</div>
<div>
    <em><%= t('tasks.label') %></em>
    <br>
    <%= @task.labels.pluck(:name).join(" ") %>
</div>

<%= link_to t('tasks.back'), tasks_path %>
