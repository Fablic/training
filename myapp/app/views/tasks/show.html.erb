<% content_for :title do %>
<%= t('.title')%>
<% end %>

<div class="navi">
    <%= link_to t('.to_index'), tasks_path %>
</div>

<div class="task-show">
    <dl>
        <dt><%= t('activerecord.attributes.tasks.title') %>:</dt>
        <dd><%= @task.title %></dd>
        <dt><%= t('activerecord.attributes.tasks.body') %>:</dt>
        <dd><%= raw(h(@task.body).gsub(/\R/, "<br>")) %></dd>
        <dt><%= t('activerecord.attributes.tasks.deadline') %>:</dt>
        <dd><%= @task.deadline %></dd>
        <dt><%= t('activerecord.attributes.tasks.priority') %>:</dt>
        <dd><%= @task.priority %></dd>
        <dt><%= t('activerecord.attributes.tasks.status') %>:</dt>
        <dd><%= @task.status %></dd>
        <dt><%= t('activerecord.attributes.tasks.label_id') %>:</dt>
        <dd><%= raw(show_labels(@task.label_id)) %></dd>
    </dl>
</div>
