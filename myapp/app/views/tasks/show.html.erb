<p style="color: green"><%= notice %></p>

<div style="padding:10px;">
  <%= link_to I18n.t('transition_destination.edit'), edit_task_path(@task), { class: "btn btn-primary mx-1" } %> |
  <%= link_to I18n.t('transition_destination.index'), tasks_path, { class: "btn btn-primary mx-1" } %>
</div>

<table class="table table-striped table-bordered">
  <tr>
    <%= render 'header' %>
  </tr>
  <tr>
    <%= render 'attributes', task: @task %>
  </tr>
</table>

<div style="padding:10px;">
  <%= button_to I18n.t('transition_destination.destroy'), @task, method: :delete, class: "btn btn-danger mx-1" %>
</div>
