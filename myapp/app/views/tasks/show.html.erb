<div class='mb-5 container', style='text-align:center'> 
  <h1>Task Detail</h1>
</div>

<div class='container'>
  <div class='mb-3 container border rounded'>
    <h2>Title</h2>
    <hr class='w-25 hr-style'>
    <h3><%= @task.title %></h3>
  </div>  
  
  <div class='mb-3 container border rounded'>
    <h2>Description</h2>
    <hr class='w-25 hr-style'>
    <h3><%= @task.description %></h3>
  </div>

  <div class='mb-3 container border rounded'>
    <h2>Due</h2>
    <hr class='w-25 hr-style'>
    <h3 class='fst-italic'><%= l @task.due %></h3>
  </div>


  <div class='mb-3 container border rounded'>
    <h2>Status</h2>
    <hr class='w-25 hr-style'>
    <div class='mb-2'>
      <%= status_label(@task) %>
    </div>
  </div>

  <p>
    <%= button_to 'Edit', edit_task_path(@task), method: :get, class: 'btn btn-outline-success' %>
  </p>
</div>
