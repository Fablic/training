<div class="container mt-5">
  <h1 class="mb-4">Task Details</h1>

  <div class="card">
    <div class="card-header">
      <h5 class="card-title mb-0">Title: <%= @task.title %></h5>
    </div>
    <div class="card-body">
      <p class="card-text"><strong>Description:</strong> <%= @task.description %></p>
      <p class="card-text"><strong>Created at:</strong> <%= @task.created_at.strftime("%Y-%m-%d %H:%M:%S") %></p>
      <% if @task.deadline %>
        <p class="card-text"><strong>Deadline:</strong> <%= @task.deadline.strftime("%Y-%m-%d") %></p>
      <% else %>
        <p class="card-text"><strong>Deadline:</strong> No deadline set</p>
      <% end %>
      <p class="card-text"><strong>Status:</strong> <%= @task.status %></p>
    </div>
    <div class="card-footer text-end">
      <div class="d-inline-block me-2">
        <%= link_to 'Edit', edit_task_path(@task), class: 'btn btn-warning' %>
      </div>
      <div class="d-inline-block me-2">
        <%= link_to 'Back', tasks_path, class: 'btn btn-secondary' %>
      </div>
      <div class="d-inline-block">
        <%= button_to 'Delete', @task, method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-danger' %>
      </div>
    </div>
  </div>
</div>
