<% content_for(:page_title, t('.title')) %>

<%= link_to "Edit", edit_task_path(@task) %>

<%= link_to "Delete", @task, method: :delete, data: {confirm: "Do you want to delete #{@task.name}?"} %>

<h2>
  <%= @task.name %>
</h2>

<div>
  <p>
    <%= @task.description %>
  </p>
  <span>
    <label>Status</label>
    <%= @task.status %>
    <label>Priority</label>
    <%= @task.priority %>
    <label>Limit</label>
    <%= @task.limit %>
  </span>
</div>

<%= link_to "Home", '/' %>
