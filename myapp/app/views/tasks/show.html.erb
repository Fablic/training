<h1><%= @task.title %>の詳細</h1>
  <ul>
    <li>タスク</li>
    <div>
      <%= @task.title %>
    </div>
    <li>説明</li>
    <div>
      <%= @task.description %>
    </div>
    <li>ステータス</li>
    <div>
      <%= I18n.t("enums.task.status.#{@task.status}") %>
    </div>
    <li>ラベル</li>
    <div>
      <%= @task.label %>
    </div>
    <li>ユーザID</li>
    <div>
      <%= @task.user_id %>
    </div>
    <li>登録日時</li>
    <div>
      <%= @task.created_at %>
    </div>
    <li>更新日時</li>
    <div>
      <%= @task.updated_at %>
    </div>
  </ul>
  <div>
    <%= link_to '編集', edit_task_path(@task) %>
    <%= link_to '削除', task_path(@task), method: :delete, data: {confirm: "削除しますか？"} %>
  </div>
<%= link_to '一覧に戻る', tasks_path %>
