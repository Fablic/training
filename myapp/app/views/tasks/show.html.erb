<div class="container">
  <p id="notice"><%= notice %></p>

  <%= link_to t('common.edit'), edit_task_path(@task) %> |
  <%= link_to t('common.index'), tasks_path %> |
  <%= link_to t('common.destroy'), @task, method: :delete, data: { confirm: 'Are you sure?' } %>

  <dl class="row">
    <dt class="col-2"><%= t('activerecord.attributes.task.title') %>:</dt>
    <dd class="col-10"><%= @task.title %></dd>
    <dt class="col-2"><%= t('activerecord.attributes.task.description') %>:
    <dt>
    <dd class="col-10">
      <pre><%= @task.description %></pre>
    </dd>
    <dt class="col-2"><%= t('activerecord.attributes.task.priority') %>:</dt>
    <dd class="col-10"><%= @task.priority && I18n.t("enums.task.priority.#{@task.priority}") %></dd>
    <dt class="col-2"><%= t('activerecord.attributes.task.status') %>:</dt>
    <dd class="col-10"><%=  @task.status && I18n.t("enums.task.status.#{@task.status}") %></dd>
    <dt class="col-2"><%= t('activerecord.attributes.label.name') %>:</dt>
    <dd class="col-10">
      <% @task.labels.pluck(:name).each do |label_name|%>
      <span class="badge badge-pill badge-primary"><%= label_name %></span>
      <% end %>
    </dd>

    <dt class="col-2"><%= t('activerecord.attributes.task.expires_at') %>:</dt>
    <dd class="col-10"><%= @task.expires_at %></dd>
  </dl>
</div>
