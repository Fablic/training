

<%=  search_form_for @q do |f| %>
<div class="level box container " >
<div class="level-left">
 <span class="title has-text-primary">SEARCH</span>
</div>
  <div class="level-left">
    <%= f.label 'name' %>
    <%= f.search_field :name_cont %>
  </div>
  <div class="level-left">
    <%= f.label 'status' %>
    <%= f.select :status_eq,  Task.statuses_i18n.keys.map { |k| [Task.statuses_i18n[k], Task.statuses[k]]}, :include_blank => true %>
  </div>
  <div class="level-left">
    <%= f.label 'label' %>
    <%= f.select(:labels_id_eq, Label.pluck(:name, :id), { include_blank: true }) %>
   </div>
  <div class="level-left">
    <%= f.submit t('messages.search'), class: "button is-link" %>
  </div>
</div>
 <% end %>



