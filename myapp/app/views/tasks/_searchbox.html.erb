<%= search_form_for @q do |f| %>
    <div class="level  ">
        <div class="level-left">

<h1 class="title has-text-primary">
  <%= Task.model_name.human + t('actions.list')%>
  <%= link_to new_task_path, class:"button is-success" do %>
    <span class="icon">
      <i class="fas fa-plus-circle fa-2x"></i>
    </span>
  <% end %>
</h1>

        </div>
        <div class="level-right">
            <div class="level-item">
                <%= f.label 'name' %>
                    <%= f.search_field :name_cont %>
            </div>
            <div class="level-item">
                <%= f.label 'status' %>
                    <%= f.select :status_eq, Task.statuses_i18n.keys.map { |k| [Task.statuses_i18n[k], Task.statuses[k]]},
            :include_blank=> true %>
            </div>
            <div class="level-item">
                <%= f.label 'label' %>
                    <%= f.select(:labels_id_eq, Label.pluck(:name, :id), { include_blank: true }) %>
            </div>
            <div class="level-item">
                <%= f.submit t('messages.search'), class: "button is-link" %>
            </div>
        </div>



    </div>
    <% end %>