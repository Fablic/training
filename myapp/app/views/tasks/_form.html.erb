</p>
 
<p>
  <%= t.label t('tasks.common.label') %>
  <%= t.text_field :label, size:50, maxlength:20 %>
</p>
 
<p>
  <%= t.label t('tasks.common.start_date') %>
  <%= t.text_field :start_date %>
</p>
 
<p>
  <%= t.label t('tasks.common.end_date') %>
