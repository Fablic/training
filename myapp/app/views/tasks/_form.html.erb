<%= form_for(@task) do |f| %>
    <%= f.label :name %>
    <%= f.text_field :name, placeholder: t('tasks.label.name') %>
    <%= f.label :description %>
    <%= f.text_area :description, placeholder: t('tasks.label.description') %>
    <%= f.submit t('tasks.button.post'), class: "btn btn-primary", id: "post_task_button" %>
<% end %>
