<% # task登録・編集用form template %>
<%= javascript_pack_tag 'tasks' %>

<!-- message -->
<% if @task.errors.any? %>
  <div class="error_message_area">
    <p><i class="fas fa-exclamation-circle"></i><%= t 'dicrionary.messages.msg_input_err' %></p>
    <ul>
      <% @task.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
<!-- form -->
<%= form_for @task,html:{ class:'pure-form pure-form-aligned'} do |f| %>
  <fieldset>
    <div class="pure-control-group">
      <%= f.label :name %>
      <%= f.text_field :name ,required:true ,class:'pure-input-3-4' %>
    </div>
    <div class="pure-control-group">
      <%= f.label :description%>
      <%= f.text_area :description,class:'pure-input-3-4' %>
    </div>
    <div class="pure-control-group">
      <%= f.label :status %>
      <%= f.select :status, Task.statuses_i18n.invert ,{ include_blank: false },{ class:'pure-input-1-4' } %>
    </div>
    <div class="pure-control-group">
      <%= f.label :due_date %>
      <%= f.date_field :due_date,class:'pure-input-1-4 calendar' %>
    </div>
    <div class="pure-controls">
      <%= f.submit (local_assigns[:edit_flag].present? ? t('tasks.edit.btn_regist'):t('tasks.new.btn_regist')) ,class:'pure-button button-success' %>
    </div>
  </fieldset>
<% end %>
