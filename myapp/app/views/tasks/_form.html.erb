<% if @task_form.error_messages.present? %>
  <div class='error-area'>
    <ul>
      <% @task_form.error_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>
<%= form_with(model: @task_form, url: url, method: method, local: true) do |f| %>
  <p><%= I18n.t('task.title') %></p>
  <%= f.text_field(:title) %>

  <p><%= I18n.t('task.content') %></p>
  <%= f.text_field(:content) %>

  <p><%= I18n.t('task.label') %></p>
  <%= f.collection_select(:label1,  Label.all, :id, :name, { include_blank: '未設定' }) %>
  <%= f.collection_select(:label2,  Label.all, :id, :name, { include_blank: '未設定' }) %>
  <%= f.collection_select(:label3,  Label.all, :id, :name, { include_blank: '未設定' }) %>
  <%= f.collection_select(:label4,  Label.all, :id, :name, { include_blank: '未設定' }) %>
  <%= f.collection_select(:label5,  Label.all, :id, :name, { include_blank: '未設定' }) %>

  <% if is_status %>
    <p><%= I18n.t('task.status') %></p>
    <%= f.select(:status, Task.statuses.keys.map { |k| [I18n.t("enums.task.status.#{k}"), k] }) %>
  <% end %>

  <br><br>
  <%= f.submit(button_name) %>
<% end %>
