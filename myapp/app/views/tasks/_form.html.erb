<% if @task.errors.any? %>
  <div>
    <ul>
      <% @task.errors.each do |error| %>
        <li class="text-danger fw-bold"><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
<div class="mb-3">
  <%= form.label :title, class: "form-label" %>
  <%= form.text_field :title, class: "form-control", readonly: !@edit_mode  %>
</div>
<div class="mb-3">
  <%= form.label :assignee, class: "form-label" %>
  <%= text_field_tag :username, params[:username], value: @task.user&.username, class: "form-control", readonly: !@edit_mode, placeholder: 'No assigned' %>
</div>
<div class="mb-3">
  <%= form.label :label, class: "form-label" %>
  <div class="btn-group d-flex"  role="group" aria-label="Basic radio toggle button group">
    <%= form.collection_check_boxes :label_ids, @labels, :id, :name do | items| %>
      <%= items.check_box class: "btn-check", disabled: !@edit_mode %>
      <%= items.label class: "btn btn-outline-primary" %>
    <% end %>
  </div>
</div>
<div class="mb-3">
  <%= form.label :start_date, class: "form-label" %>
  <%= form.date_field :start_date, class: "form-control", readonly: !@edit_mode %>
</div>
<div class="mb-3">
  <%= form.label :due_date, class: "form-label" %>
  <%= form.date_field :due_date, class: "form-control", readonly: !@edit_mode %>
</div>
<div class="mb-3">
  <%= form.label :status, class: "form-label" %>
  <div class="btn-group d-flex"  role="group" aria-label="Basic radio toggle button group">
    <% Task.statuses.keys.each do |status| %>
      <%= form.radio_button :status, status, id: %(status_#{status}), class: "btn-check", autocomplete: "off",disabled: !@edit_mode %>
      <%= form.label t(%(activerecord.attributes.task.status.#{status})) , class: "btn btn-outline-primary", for: %(status_#{status})%>
    <% end %>
  </div>
</div>
<div class="mb-3">
  <%= form.label :priority, class: "form-label" %>
  <div class="btn-group d-flex"  role="group" aria-label="Basic radio toggle button group">
    <% Task.priorities.keys.each do |priority| %>
      <%= form.radio_button :priority, priority, id: %(priority_#{priority}), class: "btn-check", autocomplete: "off", disabled: !@edit_mode %>
      <%= form.label t(%(activerecord.attributes.task.priority.#{priority})) , class: "btn btn-outline-primary", for: %(priority_#{priority})%>
    <% end %>
  </div>
</div>
<div class="mb-3">
  <%= form.label :details, class: "form-label" %>
  <%= form.text_area :details, class: "form-control" , rows: 5, placeholder: "Summary/概要", readonly: !@edit_mode %>
</div>
