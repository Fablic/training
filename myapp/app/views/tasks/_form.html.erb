<div>
  <div >
    <%= form_with(model: @task, local: true) do |f| %>
        <%= render 'shared/error_messages', object: f.object %>
        <%= f.label :title %>
        <%= f.text_field :title, class: 'form-control' %>
        <br />
  
        <%= f.label :detail %>
        <%= f.text_field :detail, class: 'form-control' %>
        <br />
  
        <%= f.label :priority %>
        <%= f.collection_select :priority, Task.prioritys.values, :to_i, method(:translate_priority), selected:@task.priority %>
        <br />

        <%= f.label :status %>
        <%= f.collection_select :status, Task.statuses.values, :to_i, method(:translate_status), selected:@task.status %>
        <br />
  
        <%= f.label :due_date %>
        <%= f.text_field :due_date, class: 'form-control'%>
        <br />
      
        <%= f.file_field :image, accept: "image/jpeg,image/gif,image/png", class: 'form-control'  %>
        <br />
        
      <%= f.submit button_value, class: "btn btn-primary" %>
    <% end %>
  </div>
</div>
