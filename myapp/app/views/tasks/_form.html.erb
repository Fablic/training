<%# ここからエラーメッセージ %>
<% if t.errors.any? %>
  <div id="error_explanation">
    <h2><%= pluralize(t.errors.count, "error") %> prohibited this tasks from being saved:</h2>

    <ul>
      <% t.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
<%# ここまでエラーメッセージ %>

<p>
  <%= t.label t('tasks.common.task_name') %>
  <%= t.text_field :task_name, size:50, maxlength:20 %>
</p>

<p>
  <%= t.label t('tasks.common.description') %>
  <%= t.text_field :description, size:50, maxlength:100 %>
</p>

<p>
  <%= t.label t('tasks.common.status') %>
  <%= t.text_field :status, size:30, maxlength:10 %>
</p>
 
<p>
  <%= t.label t('tasks.common.priority') %>
