<% if @task.errors.any? %>
  <div style="color: red; background: yellow">
    <ul>
      <% @task.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_for(task) do |f| %>

    <div class='field'>
      <%= f.label :name %>
      <br>
      <%= f.text_field :name %>
    </div>

    <div class='field'>
      <%= f.label :description %>
      <br>
      <%= f.text_field :description %>
    </div>

    <div class='field'>
      <%= f.label :status %>
      <br>
      <%= f.select :status, Task.statuses.keys.map { |k| [I18n.t("enums.task.status.#{k}"), k] } %>
    </div>

  <div class='field'>
    <%= t(Label.model_name.human) %>
    <br>
    <%= f.collection_check_boxes :label_ids, Label.all, :id, :name %>
  </div>

    <br>
    <%= f.submit %>
  <% end %>
