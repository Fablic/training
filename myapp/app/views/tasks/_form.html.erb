<%= form_with(model: task, local: true) do |form| %>
  <% if task.errors.any? %>
    <div class="alert alert-danger">
      <ul>
        <% task.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-2 row">
    <%= form.label :name, class: "col-auto form-label" %>
    <%= form.text_field :name, class: "col-auto" %>
  </div>

  <div class="mb-2 row">
    <%= form.label :description, class: "col-auto form-label" %>
    <%= form.text_area :description, class: "col-auto" %>
  </div>

  <div class="mb-2">
    <%= form.label :priority, class: "col-auto form-label" %>
    <%= form.select :priority, options_for_select(Task.priorities.keys.map { |key| [t("activerecord.attributes.task.priorities.#{key}"), key] }, task.priority) %>
  </div>

  <div class="mb-2">
    <%= form.label :status, class: "col-auto form-label" %>
    <%= form.select :status, options_for_select(Task.statuses.keys.map { |key| [t("activerecord.attributes.task.statuses.#{key}"), key] }, task.status) %>
  </div>

  <div class="mb-2">
    <%= form.label :deadline %>
    <%= form.datetime_select :deadline, include_blank: true, start_year: Date.today.year, end_year: Date.today.year + 10 %>
  </div>

  <% if current_user.is_admin %>
    <div class="mb-2">
      <%= form.label :assignee, t("assignee"), class: "col-auto form-label" %>
      <%= form.collection_select :user_id, User.active.order(:name), :id, :name, { selected: form.object.user_id } %>
    </div>
  <% else %>
    <%# user_id is the automatically set to the current_user %>
    <%= form.hidden_field :user_id, value: current_user.id %>
  <% end %>

  <button type="submit" class="btn btn-primary">
    <%= t("button.save") %>
  </button>
<% end %>
