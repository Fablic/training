<%= form_with(model: task, local: true) do |form| %>
  <% if task.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(task.errors.count, "error") %> prohibited this task from being saved:</h2>

      <ul>
        <% task.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>



  <div class="field">
    <%= form.label :name, t('attributes.model.task.name') %>
    <%= form.text_field :name %>
  </div>

  <div class="field">
    <%= form.label :description, t('attributes.model.task.description') %>
    <%= form.text_area :description %>
  </div>

  <div class="field">
  <%= form.label :priority, t('attributes.model.task.priority') %>
  <%= form.select :priority, options_for_select([
    [t('form.priority.low'), 'Low'],
    [t('form.priority.medium'), 'Medium'],
    [t('form.priority.high'), 'High']])
    %>
</div>

  <div class="field">
    <%= form.label :status, t('attributes.model.task.status') %>
    <%= form.select :status, options_for_select([
    [t('form.status.not started'), 'Not Started'],
    [t('form.status.in progress'), 'In Progress'],
    [t('form.status.done'), 'Done']])
    %>
  </div>

  <div class="field">
    <%= form.label :duedate, t('attributes.model.task.duedate') %>
    <%= form.date_field :duedate %>
  </div>

  <div class="field">
    <%= form.label :label_ids, "Labels" %>
    <%= form.collection_check_boxes :label_ids, @current_user.labels, :id, :name do |b| %>
      <%= b.check_box %>
      <%= b.label %>
    <% end %>
  </div>

  <div class="actions">
    <%= form.submit t('pages.task_list_page.update_task') %>
  </div>
<% end %>
