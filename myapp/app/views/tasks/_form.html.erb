 <ul>
  <% if task.errors.any? %>
    <% task.errors.full_messages.each do |message| %>
        <li><%= message %></li>
    <% end %>
  <% end %>
</ul>

<%= form_with model: task do |form| %>
  Title: <%= form.text_field :title %> <br>
  Description: <%= form.text_field :description %> <br>

  <%= form.submit "Submit" %>
<% end %>
