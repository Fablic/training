<%= form_with(model: task, local: true) do |form| %>
  <% if task.errors.any? %>
    <div id="error_explanation">
      <ul>
        <% task.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label Task.human_attribute_name(:status) %>
    <%= form.select :status,  Task.statuses_i18n.keys.map { |k| [Task.statuses_i18n[k], k]} %>
  </div>

  <div class="field">
    <%= form.label Task.human_attribute_name(:name) %>
    <%= form.text_field :name %>
  </div>


  <div class="field">
    <%= form.label Task.human_attribute_name(:description) %>
    <%= form.text_field :description %>
  </div>

    <div class="field">
    <%= form.label Task.human_attribute_name(:created_by) %>
    <%= form.text_field :created_by %>
  </div>

  <div class="field">
    <%= form.label Task.human_attribute_name(:started_at) %>
    <%= form.date_select :started_at %>
  </div>

  <div class="field">
    <%= form.label Task.human_attribute_name(:finished_at) %>
    <%= form.date_select :finished_at %>
  </div>

  <div class="actions">
    <%= form.submit %>
  </div>
<% end %>
