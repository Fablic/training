<%= form_with model: @task do |form| %>
  <p>name</p>
  <%= form.text_field :name %>
  <p>description</p>
  <%= form.text_field :description %>
  <p>deadline_at</p>
  <%= form.datetime_field :deadline_at %>

  <%= link_to "Cancel", "/tasks", {style: "display: block;"} %>
  <%= form.submit %>
<% end %>
