<% if flash[:notice] %>
  <p><%= flash[:notice] %></p>
<% end %>
<%= form_with(model: task, local: true) do |form| %>
  <div class="field">
    <%= form.label :title %>
    <%= form.text_field :title, id: :task_title, :required => 'required' %>
  </div>

  <div class="field">
    <%= form.label :description %>
    <%= form.text_area :description, id: :task_description %>
  </div>

  <div class="actions">
    <%= form.submit %>
  </div>
<% end %>
