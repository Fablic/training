<div class='task-form'>
  <%= form_with model: @task, local: true do |form| %>
    <%= render 'shared/error_messages', object: form.object %>
    <div>
      <%= form.label 'タスク名(必須)', style: 'display: block' %>
      <%= form.text_field :title %>
    </div>
    <div>
      <%= form.label '概要', style: 'display: block' %>
      <%= form.text_area :content %>
    </div>

    <div>
      <%= form.label 'ステータス', style: 'display: block' %>
      <%= form.select :status, ['未着手', '着手中', '完了済'], {include_blank: '------'} %>
    </div>

    <div>
      <%= form.label '終了期限', style: 'display: block' %>
      <%= form.date_field :deadline %>
    </div>

    <div class="submit-content">
      <%= form.submit '登録' %>
      <%= link_to 'もどる', tasks_path %>
    </div>
  <% end %>
</div>
