<% if @task.errors.any? %>
  <div style="color: red" >
    <ul>
      <% @task.errors.full_messages.each do |msg| %>
        <li class='error_list' ><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_for(@task) do |f| %>
    <div>
      <%= f.label :タイトル %>
    </div>
    <div>
      <%= f.text_field :title, id: 'textarea1' %>
    </div>
    <div>
      <%= f.label :説明 %>
    </div>
    <div>
      <%= f.text_area :description, id: 'textarea2' %>
    </div>
    <div>
    <%= f.submit id: 'submit' %>
    </div>
  <% end %>
