<div class="card shadow mx-800">
  <div class="card-header">Edit the task</div>
  <div class="card-body">
    <%= form_with(model: @task, url: form_url, local: true, method: form_method, id: 'task-form') do |form| %>
      <% if @task.errors.any? %>
        <div id="error_explanation" class="alert alert-danger">
          <h2><%= pluralize(@task.errors.count, "error") %> prohibited this task from being saved:</h2>
          <ul>
            <% @task.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <table class="table table-borderless">
        <tbody>
          <tr>
            <td class="title-column"><%= form.label :name, t('task.table_headers.name') %></td>
            <td><%= form.text_field :name, class: 'form-control' %></td>
          </tr>
          <tr>
            <td class="title-column"><%= form.label :description, t('task.table_headers.description') %></td>
            <td><%= form.text_area :description, class: 'form-control' %></td>
          </tr>
          <tr>
            <td class="title-column"><%= form.label :priority, t('task.table_headers.priority') %></td>
            <td><%= form.number_field :priority, class: 'form-control' %></td>
          </tr>
          <tr>
            <td class="title-column"><%= form.label :deadline, t('task.table_headers.deadline') %></td>
            <td><%= form.date_field :deadline, class: 'form-control' %></td>
          </tr>
          <tr>
            <td class="title-column"><%= form.label :status, t('task.table_headers.status') %></td>
            <td><%= form.select :status, ["Not Started", "In Progress", "Done"], {}, class: 'form-control' %></td>
          </tr>
          <tr>
            <td class="title-column"><%= t('task.table_headers.labels') %></td>
            <td>
              <div class="form-group">
                <div id="labels-list">
                  <% @labels.each do |label| %>
                    <%= check_box_tag "task[label_ids][]", label.id, @task.label_ids.include?(label.id) %>
                    <%= label.name %><br>
                  <% end %>
                </div>
                <%= text_field_tag 'new_label_name', '', class: 'form-control', placeholder: 'New Label Name' %>
                <%= button_tag 'Add New Label', type: 'button', class: 'btn btn-success mt-2', id: 'add-label-button' %>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
      <div class="form-group text-center">
        <%= form.submit submit_label, class: 'btn btn-primary' %>
      </div>
    <% end %>
  </div>
  <div class="card-footer text-right"> 
    <%= link_to tasks_path do %>
      <i class="fas fa-arrow-left"></i>
    <% end %>
  </div>
</div>

<script>
  $(document).ready(function() {
    $('#add-label-button').on('click', function(e) {
      e.preventDefault();
      var newLabel = $('#new_label_name').val();
      console.log(newLabel);
      
      if (newLabel.trim() !== '') {
        $.ajax({
          url: '/labels',
          method: 'POST',
          data: { label: { name: newLabel } },
          beforeSend: function(xhr) {
            xhr.setRequestHeader('X-CSRF-Token', $('meta[name="csrf-token"]').attr('content'));
          },
          dataType: 'json',
          success: function(response) {
            if (response.success) {
              alert('Added label successfully.');
              $('#labels-list').append(
                '<label>' +
                  '<input type="checkbox" name="task[label_ids][]" value="' + response.label_id + '" checked>' +
                  newLabel +
                '</label><br>'
              );
              $('#new_label_name').val('');
            } else {
              alert('Error creating label.');
            }
          },
          error: function() {
            alert('An error occurred.');
          }
        });
      }
    });
  });
</script>
