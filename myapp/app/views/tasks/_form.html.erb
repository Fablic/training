<%= form_with model: @task, url: form_url, method: form_method, local: true  do |form| %>
  <% if @task.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@task.errors.count, t('task.flashes.failed.form_submit')) %></h2>
      <ul>
        <% @task.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= t('task.labels.title') %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= t('task.labels.description') %>
    <%= form.text_area :description %>
  </div>

  <div>
    <%= t('task.labels.priority') %>
    <%= form.select :priority, Task.priorities.keys.map { |k| [k.humanize, k] } %>
  </div>

  <div>
    <%= t('task.labels.due_date') %>
    <%= form.date_field :due_date %>
  </div>

  <div>
    <%= t('task.labels.status') %>
    <%= form.select :status, Task.statuses.keys.map { |k| [k.humanize, k] } %>
  </div>

  <div>
    <%= form.submit submit_label %>
  </div>
<% end %>

<%= link_to t('task.links.index'), tasks_path %>
