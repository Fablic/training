 <ul>
  <% if task.errors.any? %>
    <% task.errors.full_messages.each do |message| %>
        <li><%= message %></li>
    <% end %>
  <% end %>
</ul>

<%= form_with model: task do |form| %>
  <%= I18n.t('activerecord.attributes.task.title') %>: <%= form.text_field :title %> <br>
  <%= I18n.t('activerecord.attributes.task.description') %>: <%= form.text_field :description %> <br>

  <%= form.submit I18n.t('helpers.submit.submit', model: I18n.t('activerecord.models.task')).capitalize %>
<% end %>
