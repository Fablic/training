<% if task.errors.any? %>
  <div id="error_explanation">
    <h2><%= task.errors.count %>件のエラーが発生しています。</h2>
    <ul>
      <% task.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_for @task do |f| %>
    <div class="field">
      <%= f.label :task_name %>
      <%= f.text_field :task_name %>
    </div>
    <div class="field">
      <%= f.label :description %>
      <%= f.text_field :description %>
    </div>
    <div class="field">
      <%= f.label :starts_on %>
      <%= f.date_select :starts_on %>
    </div>
    <div class="field">
      <%= f.label :ends_on %>
      <%= f.date_select :ends_on %>
    </div>
    <div class="field">
      <%= f.label :priority %>
      <%= f.text_field :priority %>
    </div>
    <div class="field">
      <%= f.label :label %>
      <%= f.collection_check_boxes(:label_ids, Label.all, :id, :label_name) %>
    </div>
    <div class="field">
      <%= f.label :status %>
      <%= f.select :status, Task.statuses.keys.map { |k| [t("activerecord.enums.task.status.#{k}"), k]} %>
    </div>
    <div class="actions">
      <%= f.submit %>
    </div>
<% end %>
