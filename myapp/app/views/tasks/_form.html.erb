<div class='task-form align-items-center'>
  <%= form_with model: @task, local: true do |form| %>
    <%= render 'shared/error_messages', object: form.object %>
    <div class='form-group'>
      <div class='col-auto mb-3'>
        <span class='badge bg-danger'>必須</span>
        <%= form.label t('activerecord.attributes.task.title') , class: 'col-form-label' %>
        <%= form.text_field :title, class: 'form-control' %>
      </div>
      <div class='col-auto mb-3'>
        <%= form.label t('activerecord.attributes.task.content') , class: 'col-form-label' %>
        <%= form.text_area :content, class: 'form-control' %>
      </div>

      <div class='col-auto mb-3'>
        <span class='badge bg-danger'>必須</span>
        <%= form.label t('activerecord.attributes.task.deadline'), class: 'col-form-label' %>
        <%= form.date_field :deadline, class: 'form-control' %>
        </div>
      </div>

      <div class='col-auto mb-3'>
        <%= form.label t('activerecord.attributes.task.status'), class: 'col-form-label' %>
        <%= form.select :status, options_for_select(Task.statuses.keys.map  {|k| [t("enums.task.status.#{k}"), k]}), {}, { class: 'form-select', 'data-style': 'form-control' } %>
      </div>

      <div class='col-auto mb-3'>
        <%= form.label (t('activerecord.attributes.label.name') + t('information.label.name')) %>
        <%= form.text_field :name, value: @label_list, class: "form-control" %>
      </div>

    <div class='submit-content'>
      <%= form.submit t('buttons.register'), class: 'btn btn-primary' %>
      <%= link_to t('buttons.back_page'), tasks_path, class: 'btn btn-link' %>
    </div>
  <% end %>
</div>
