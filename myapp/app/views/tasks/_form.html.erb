<%= form_with(model: task) do |form| %>
  <% if task.errors.any? %>
    <div style="color: red">
      <h2><%= I18n.t('activerecord.errors.count_message', count: task.errors.count) %></h2>

      <ul>
        <% task.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, I18n.t('activerecord.attributes.task.name'), style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :end_date, I18n.t('activerecord.attributes.task.end_date'), style: "display: block" %>
    <%= form.datetime_field :end_date %>
  </div>

  <div>
    <%= form.label :priority, I18n.t('activerecord.attributes.task.priority'), style: "display: block" %>
    <%= form.select :priority, I18n.t('select_form.task.priority') %>
  </div>

  <div>
    <%= form.label :status, I18n.t('activerecord.attributes.task.status'), style: "display: block" %>
    <%= form.select :status, I18n.t('select_form.task.status') %>
  </div>

  <div>
    <%= form.label :explanation, I18n.t('activerecord.attributes.task.explanation'), style: "display: block" %>
    <%= form.text_area :explanation %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
