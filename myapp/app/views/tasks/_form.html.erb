<% # task登録・編集用form template %>
<style>
  .input_form_table td{
    min-width:100px;
  }
  .error{
    color:red;
  }
  .field_with_errors input,
  .field_with_errors textarea{
    border-color:red;
  }

</style>
<%= form_for @task do |f| %>
  <% if @task.errors.any? %>
    <p class="error"><%= t 'dicrionary.messages.msg_input_err' %></p>
    <div class="error_detail_area">
      <ul>
      <% @task.errors.full_messages.each do |message| %>
      <li><%= message %></li>
      <% end %>
    </ul>
    </div>
  <% end %>
  <table class="input_form_table">
    <tbody>
      <tr>
        <td>
          <%= f.label :name %>
        </td>
        <td><%= f.text_field :name %>
        </td>
      </tr>
      <tr>
        <td>
          <%= f.label :description%>
        </td>
        <td><%= f.text_area :description %></td>
      </tr>
      <tr>
        <td> <%= f.label :period_date %></td>
        <td> <%= f.date_field :period_date %></td>
      </tr>
    </tbody>
  </table>
  <% if local_assigns[:edit_flag].present? %>
    <%= f.submit t('tasks.edit.btn_regist') %>
  <% else %>
    <%= f.submit t('tasks.new.btn_regist') %>
  <% end %>
<% end %>
