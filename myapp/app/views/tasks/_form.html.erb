<div class="task-form mt-10">
<%= form_with model: task do |f| %>

  <div class="mb-10">
    <%= f.text_field :title, class: "form-control", placeholder: "title" %>
  </div>

  <div class="mb-10">
    <%= f.text_area :description, class: "form-control", placeholder: "desscription" %>
  </div>

  <div class="mb-10">
    <%= f.submit btn_label, class: "btn" %>
  </div>

<% end %>
</div>
