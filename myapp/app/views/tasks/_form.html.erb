<p>
  <%= t.label :task_name, t('tasks.common.task_name') %>
  <%= t.text_field :task_name, size:50, maxlength:20 %>
</p>

<p>
  <%= t.label :description, t('tasks.common.description') %>
  <%= t.text_field :description, size:50, maxlength:100 %>
</p>

<p>
  <%= t.label :status, t('tasks.common.status') %>
  <%= t.select :status, options_for_select(Task.status_lists.keys, { selected: @task.status, include_blank: t('helpers.select.include_blank') }) %>
</p>
 
<p>
  <%= t.label :priority, t('tasks.common.priority') %>
  <%= t.number_field :priority, size:10, maxlength:4 %>
</p>
 
<p>
  <%= t.label :label, t('tasks.common.label') %>
  <%= t.collection_check_boxes(:label_ids, Label.all, :id, :name) %>
</p>
 
<p>
  <%= t.label :start_date, t('tasks.common.start_date') %>
  <%= t.datetime_field :start_date %>
</p>
 
<p>
  <%= t.label :end_date, t('tasks.common.end_date') %>
  <%= t.datetime_field :end_date %>
</p>
 
