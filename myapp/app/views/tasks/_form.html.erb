<% if @task.errors.any? %>
  <div style="color: red; background: yellow">
    <ul>
      <% @task.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_for(task) do |f| %>

    <div class='field'>
      <%= f.label :name %>
      <br>
      <%= f.text_field :name %>
    </div>

     <div class='field'>
      <%= f.label :description %>
      <br>
      <%= f.text_field :description %>
    </div>

    <br>
    <%= f.submit %>
  <% end %>
