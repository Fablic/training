<div class="mb-3">
  <%= form.label :title, class: "form-label" %>
  <%= form.text_field :title, class: "form-control", readonly: !@edit_mode %>
</div>
<div class="mb-3">
  <%= form.label :assignee, class: "form-label" %>
  <%= form.text_field :assignee, class: "form-control", readonly: !@edit_mode %>
</div>
<div class="mb-3">
  <%= form.label :label, class: "form-label" %>
  <%= form.text_field :label, class: "form-control", placeholder: "Label", readonly: !@edit_mode %>
</div>
<div class="mb-3">
  <%= form.label :start_date, class: "form-label" %>
  <%= form.date_field :start_date, class: "form-control", readonly: !@edit_mode %>
</div>
<div class="mb-3">
  <%= form.label :due_date, class: "form-label" %>
  <%= form.date_field :due_date, class: "form-control", readonly: !@edit_mode %>
</div>
<div class="mb-3">
  <%= form.label :status, class: "form-label" %>
  <div class="btn-group d-flex">
    <label class="btn btn-outline-primary">
      <%= form.radio_button :status, id: "status_not_started", class: "btn-check", disabled: !@edit_mode %>Not Started
    </label>
    <label class="btn btn-outline-primary">
      <%= form.radio_button :status, id: "status_in_progress", class: "btn-check", disabled: !@edit_mode %>In Progress
    </label>
    <label class="btn btn-outline-primary">
      <%= form.radio_button :status, id: "status_completed", class: "btn-check", disabled: !@edit_mode %>Completed
    </label>
  </div>
</div>
<div class="mb-3">
  <%= form.label :priority, class: "form-label" %>
  <div class="btn-group d-flex">
    <label class="btn btn-outline-primary">
      <%= form.radio_button :priority, id: "priority_high", class: "btn-check", disabled: !@edit_mode %>High
    </label>
    <label class="btn btn-outline-primary">
      <%= form.radio_button :priority, id: "priority_middle", class: "btn-check", disabled: !@edit_mode %>Middle
    </label>
    <label class="btn btn-outline-primary">
      <%= form.radio_button :priority, id: "priority_low", class: "btn-check", disabled: !@edit_mode %>Low
    </label>
  </div>
</div>
<div class="mb-3">
  <%= form.label :details, class: "form-label" %>
  <%= form.text_area :details, class: "form-control" , rows: 5, placeholder: "Summary/概要", readonly: !@edit_mode %>
</div>
