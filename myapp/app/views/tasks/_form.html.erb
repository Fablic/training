<%= form_with model: task do |f| %>
    <div><%= t "tasks.title" %></div>
    <%= f.text_field :title %>
    <div><%= t "tasks.description" %></div>
    <%= f.text_area :description %>
    <div><%= t "tasks.termination_date" %></div>
    <%= f.datetime_select :termination_at %>
    <div><%= t "tasks.priority" %></div>
    <%= f.select :priority, [[t('tasks.priority00'), 0], [t('tasks.priority01'), 1], [t('tasks.priority02'), 2]], include_blank: t('tasks.form.priority_select') %>
    <div><%= t "tasks.status" %></div>
    <%= f.select :status, [[t('tasks.status00'), 0], [t('tasks.status01'), 1], [t('tasks.status02'), 2]], include_blank: t('tasks.form.status_select') %>
    <br />
    <%= f.submit(t('tasks.form.register')) %>
<% end %>
<%= link_to t('tasks.back'), tasks_path %>
