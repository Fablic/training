<%= form_with(model: @task, local: true) do |f| %>
  <%= render 'shared/error_messages' %>

  <%= f.label :title, t('tasks.form.title') %>
  <%= f.text_field :title, class: 'form-control' %>

  <%= f.label :description, t('tasks.form.description') %>
  <%= f.text_field :description, class: 'form-control' %>

  <%= f.label :status, t('tasks.form.status') %>
  <%= f.select :status, Task.statuses.keys.map { |k| [k, k] }, class: 'form-control' %>

  <%= f.label :expire_at, t('tasks.form.expire') %>
  <%= f.datetime_field :expire_at, class: 'form-control' %>

  <%= f.label :labels %>
  <%= f.collection_check_boxes :label_ids, Label.all, :id, :name %>
  <%= f.submit t('tasks.form.save'), class: "button" %>
<% end %>
