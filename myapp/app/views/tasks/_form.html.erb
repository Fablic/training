<div class='task-form align-items-center'>
  <%= form_with model: @task, local: true do |form| %>
    <%= render 'shared/error_messages', object: form.object %>
    <div class='col-auto mb-3'>
      <span class='badge bg-danger'>必須</span>
      <%= form.label t('activerecord.attributes.task.title') , class: 'col-form-label' %><br>
      <%= form.text_field :title, class: 'form-control' %>
    </div>
    <div class='col-auto mb-3'>
      <%= form.label t('activerecord.attributes.task.content') , class: 'col-form-label' %>
      <%= form.text_area :content, class: 'form-control' %>
    </div>

    <div class='col-auto mb-3'>
      <span class='badge bg-danger'>必須</span>
      <%= form.label t('activerecord.attributes.task.deadline'), class: 'col-form-label' %>
      <%= form.date_field :deadline, class: 'form-control' %>
      </div>
    </div>

    <div>
      <%= form.label t('activerecord.attributes.task.status'), style: 'display: block' class: 'col-form-label' %>
      <%= form.select :status, Task.statuses.keys.map { |k| [t("enums.task.status.#{k}"), k] }, { selected: 1 }, class: 'form-control' %>
    </div>

    <%= form.submit t('commom.word.register'), class: 'btn btn-primary' %>
    <%= link_to t('commom.word.back_page'), tasks_path, class: 'btn btn-link' %>
  <% end %>
</div>
