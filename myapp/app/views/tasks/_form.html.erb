<% if @task.errors.any? %>
  <div class='error-area'>
    <ul>
      <% @task.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>
<%= form_with(model: @task, url: url, method: method, local: true) do |f| %>
  <p><%= I18n.t('task.title') %></p>
  <%= f.text_field(:title) %>

  <p><%= I18n.t('task.content') %></p>
  <%= f.text_field(:content) %>

  <p><%= I18n.t('task.label') %></p>
  <%= f.text_field(:label) %>

  <p><%= I18n.t('task.user') %></p>
  <%= f.select(:user_id, @select_user_names) %>

  <% if is_status %>
    <p><%= I18n.t('task.status') %></p>
    <%= f.select(:status, Task.statuses_i18n.keys.map { |k| [Task.statuses_i18n[k], k] }) %>
  <% end %>

  <br><br>
  <%= f.submit(button_name) %>
<% end %>
