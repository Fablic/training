<%= form_with(model: task, local: true) do |form| %>
    <% if task.errors.any? %>
      <div class="alert alert-danger">
        <ul>
          <% task.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
  
    <div>
      <%= form.label :name %>
      <%= form.text_field :name %>
    </div>
  
    <div>
      <%= form.label :description %>
      <%= form.text_area :description %>
    </div>
  
    <div>
      <%= form.label :priority %>
      <%= form.select :priority, options_for_select(Task.priorities.keys.map { |key| [t("activerecord.attributes.task.priorities.#{key}"), key] }, task.priority) %>
    </div>
  
    <div>
      <%= form.label :status %>
      <%= form.select :status, options_for_select(Task.statuses.keys.map { |key| [t("activerecord.attributes.task.statuses.#{key}"), key] }, task.status) %>
    </div>
  
    <div>
      <%= form.label :deadline %>
      <%= form.datetime_select :deadline, include_blank: true %>
    </div>
  
    <!-- If you want to set the user_id automatically, you might consider a hidden field or set it on the controller -->
    <%= form.hidden_field :user_id, value: 1 %>
  
    <button type="submit" class="btn btn-primary">
      <%= t("button.save") %>
    </button>
  <% end %>
  