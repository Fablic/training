<%= form_with(model: task, local: true) do |form| %>
  <% if task.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(task.errors.count, "error") %> prohibited this task from being saved:</h2>

      <ul>
        <% task.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

<div class="field">
    <%= form.label :name, 'Task title' %>
    <%= form.text_field :name %>
  </div>

  <div class="field">
    <%= form.label :description, 'Description' %>
    <%= form.text_area :description %>
  </div>

  <div class="field">
  <%= form.label :priority, 'Priority' %>
  <%= form.select :priority, options_for_select([
    [t('form.priority.low'), 'Low'],
    [t('form.priority.medium'), 'Medium'],
    [t('form.priority.high'), 'High']])
    %>
</div>

  <div class="field">
    <%= form.label :status, 'Status' %>
    <%= form.select :status, options_for_select([
    [t('form.status.not started'), 'Not Started'],
    [t('form.status.in progress'), 'In Progress'],
    [t('form.status.done'), 'Done']])
    %>
  </div>

  <div class="field">
    <%= form.label :duedate, 'Due Date' %>
    <%= form.date_field :duedate %>
  </div>

  <div class="actions">
    <%= form.submit %>
  </div>
<% end %>
