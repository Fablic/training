<% if flash[:notice] %>
  <p><%= flash[:notice] %></p>
<% end %>

<%= form_for @task do |t| %>

  <p>
  <%= t.label :task_name %>
  <%= t.text_field :task_name, size:50, maxlength:20 %>
  </p>

  <p>
  <%= t.label :description %>
  <%= t.text_field :description, size:50, maxlength:100 %>
  </p>

  <p>
  <%= t.label :status %>
  <%= t.text_field :status, size:30, maxlength:10 %>
  </p>
 
  <p>
  <%= t.label :priority %>
  <%= t.number_field :priority, size:10, maxlength:4 %>
  </p>
 
  <p>
  <%= t.label :label %>
  <%= t.text_field :label, size:50, maxlength:20 %>
  </p>
 
  <p>
  <%= t.label :start_date %>
  <%= t.text_field :start_date %>
  </p>
 
  <p>
  <%= t.label :end_date %>
  <%= t.text_field :end_date %>
  </p>

  <%= t.submit %> 
<% end %>

