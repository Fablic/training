<% if @task.errors.any? %>
  <div id="error_explanation">
    <h2><%= t('.error.cause') %></h2>
    <ul>
    <% @task.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
    </ul>
  </div>
<% end %>

<% if flash[:notice] %>
  <p><%= flash[:notice] %></p>
<% end %>
<%= form_with(model: task, local: true, class: 'form-margin') do |form| %>
  <div class="form-group">
    <%= form.label :title %>
    <%= form.text_field :title, id: :task_title, :class => 'form-control' %>
  </div>

  <div class="form-group">
    <%= form.label :description %>
    <%= form.text_area :description, id: :task_description, :class => 'form-control' %>
  </div>

  <div class="field">
    <%= form.label :expiration_date %>
    <%= form.datetime_local_field :expiration_date, id: :task_expiration_date %>
  </div>

  <div class="field">
    <%= form.label :status %>
    <%= form.select :status, Task.enum_options_for_select_status, { include_blank: "#{Task.human_attribute_name :status}", :class => "form-select"} %>
  </div>

  <div class="actions">
    <%= form.submit submit_button, class: 'btn btn-primary' %>
  </div>
<% end %>

<style>
.form-margin {
  margin: 20px
}
</style>
