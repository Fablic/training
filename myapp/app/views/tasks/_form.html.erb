<%= form_with(model: @task, url: form_url, local: true, method: form_method) do |form| %>
  <% if @task.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(@task.errors.count, "error") %> prohibited this task from being saved:</h2>
      <ul>
        <% @task.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, t('task.table_headers.name') %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :description, t('task.table_headers.description') %>
    <%= form.text_area :description %>
  </div>

  <div>
    <%= form.label :priority, t('task.table_headers.priority') %>
    <%= form.number_field :priority %>
  </div>

  <div>
    <%= form.label :deadline, t('task.table_headers.deadline') %>
    <%= form.date_field :deadline %>
  </div>

  <div>
    <%= form.label :status, t('task.table_headers.status') %>
    <%= form.select :status, ["Not Started", "In Progress", "Done"] %>
  </div>
  
  <%# todo: add labels to tasks %>
  <%# <div class="field">
    <%= form.label :label_ids, t('task.table_headers.labels') %>
    <%# <%= form.collection_select :label_ids, @labels, :id, :name, {}, multiple: true %> <%# %>
  <%# </div> %> <%# %>

  <div>
    <%= form.submit submit_label %>
  </div>
<% end %>

<%= link_to t('task.back_to_tasks_link'), tasks_path %>
