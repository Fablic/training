<% if @task.errors.any? %>
  <div style="color: red">
    <ul>
      <% @task.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_for(task) do |f| %>

  <div class='field'>
    <%= f.label :name %>
    <br>
    <%= f.text_field :name %>
  </div>

  <div class='field'>
    <%= f.label :detail %>
    <br>
    <%= f.text_field :detail %>
  </div>

   <div class='field'>
    <%= f.label :status %>
    <br>
    <%= f.select :status, Task.statuses.keys.map { |k| [I18n.t("enums.task.status.#{k}"), k] } %>
  </div>

   <div class='field'>
    <%= f.label :priority %>
    <br>
    <%= f.select :priority, Task.priorities.keys.map { |k| [I18n.t("enums.task.priority.#{k}"), k] } %>
  </div>

  <div class='field'>
    <%= f.label :user_id %>
    <br>
    <%= f.text_field :user_id %>
  </div>

  <br>
  <%= f.submit %>
<% end %>
