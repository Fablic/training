<% if @task.errors.any? %>
  <div style="color: red" >
    <ul>
      <% @task.errors.full_messages.each do |msg| %>
        <li class='error_list' ><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_for(@task) do |f| %>
  <p><%= I18n.t('task.title') %></p>
  <%= f.text_field :title, id: 'textarea1' %>
  <p><%= I18n.t('task.description') %></p>
  <%= f.text_field :description, id: 'textarea2' %>
  <br>
  <%= f.submit id: 'submit' %>
<% end %>
