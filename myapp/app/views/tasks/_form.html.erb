<%= form_for @task do |f| %>
    <div class="field">
      <%= f.label :task_name %>
      <%= f.text_field :task_name %>
    </div>
    <div class="field">
      <%= f.label :description %>
      <%= f.text_field :description %>
    </div>
    <div class="field">
      <%= f.label :starts_on %>
      <%= f.date_select :starts_on %>
    </div>
    <div class="field">
      <%= f.label :ends_on %>
      <%= f.date_select :ends_on %>
    </div>
    <div class="field">
      <%= f.label :priority %>
      <%= f.text_field :priority %>
    </div>
    <div class="field">
      <%= f.label :label %>
      <%= f.text_field :label %>
    </div>
    <div class="field">
      <%= f.label :status %>
      <%= f.text_field :status %>
    </div>
    <div class="actions">
      <%= f.submit %>
    </div>
<% end %>
