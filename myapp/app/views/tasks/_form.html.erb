<% if @task_form.errors.any? %>
  <div style="color: red">
    <ul>
      <% @task_form.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>
<%= form_with(model: @task_form, url: url, method: method, local: true) do |f| %>
    <div>
      <%= f.label :タイトル %>
    </div>
    <div>
      <%= f.text_field :title, id: 'textarea1' %>
    </div>
    <div>
      <%= f.label :説明 %>
    </div>
    <div>
      <%= f.text_area :description, id: 'textarea2' %>
    </div>
    <div>
      <%= I18n.t('task.label') %>
    </div>
      <%= f.text_field :label1 %>
      <br>
      <%= f.text_field :label2 %>
      <br>
      <%= f.text_field :label3 %>
      <br>
      <%= f.text_field :label4 %>
      <br>
      <%= f.text_field :label5 %>
      <br>
    <div>
      <% if is_status %>
        <div>
          <%= f.label :ステータス %>
        </div>
        <%= f.select(:status, Task.statuses.keys.map { |k| [I18n.t("enums.task.status.#{k}"), k] }) %>
      <% end %>
    </div>
    <br>
    <div>
    <%= f.submit id: 'submit' %>
    </div>
  <% end %>
