<%= form_with(model: task) do |form| %>
  <% if task.errors.any? %>
    <div style="color: red">
      <h2><%= task.errors.count %>件のエラーが発生しました。</h2>

      <ul>
        <% task.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, 'タスク名', style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :end_date, '終了期限', style: "display: block" %>
    <%= form.datetime_field :end_date %>
  </div>

  <div>
    <%= form.label :priority, '優先順位', style: "display: block" %>
    <%= form.select :priority, [['低', 'low'], ['普通', 'normal'], ['高', 'high']] %>
  </div>

  <div>
    <%= form.label :status, 'ステータス', style: "display: block" %>
    <%= form.select :status, [['未着手', 'untouched'], ['着手中', 'touched'], ['完了', 'completed']] %>
  </div>

  <div>
    <%= form.label :explanation, '説明', style: "display: block" %>
    <%= form.text_area :explanation %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
