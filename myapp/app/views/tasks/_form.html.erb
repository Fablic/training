<% if @task.errors.any? %>
  <div style="color: red; background: yellow">
    <ul>
      <% @task.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_for(task) do |f| %>

    <div class='field'>
      <%= f.label :name %>
      <br>
      <%= f.text_field :name %>
    </div>

    <div class='field'>
      <%= f.label :description %>
      <br>
      <%= f.text_field :description %>
    </div>

    <div class='field'>
      <%= f.label :status %>
      <br>
      <%= f.select :status, Task.statuses.keys.map { |k| [I18n.t("enums.task.status.#{k}"), k] } %>
    </div>

    <div class='field'>
      <%= f.label :user %>
      <br>
      <%= f.collection_select :user_id, @users, :id, :name, { selected: task.user_id } %>
    </div>

    <br>
    <%= f.submit %>
  <% end %>
