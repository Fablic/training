<%= form_with model: task do |form| %>
  <%= form.label :name %>
  <%= form.text_field :name %>
  <%= form.label :description %>
  <%= form.text_area :description %>
  <%= form.label :limit %>
  <%= form.date_field :limit %>
  <%= form.label :status %>
  <%= form.select :status,  [["TODO",'TODO'],["IN PROGRESS","IN_PROGRESS"], ["DONE","DONE"]], {selected: "TODO"} %>
  <%= form.label :priority %>
  <%= form.select :priority,  [["Low","Low"],["Normal","Normal"], ["High","High"]], {selected: "Low"} %>
  <%= form.submit %>
<% end %>
