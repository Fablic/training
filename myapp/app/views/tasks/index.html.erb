<h1><%= t '.title' %></h1>

<%= search_form_for @q do |f| %>
  <div class="row">
    <%= f.label :name_cont, t('tasks.task_name'), class: 'col-4 col-form-label' %>
    <%= f.label :status_eq, t('tasks.task_status'), class: 'col-3 col-form-label' %>
    <%= f.label :labels_id_eq, t('tasks.task_label'), class: 'col-3 col-form-label' %>
  </div>
  <div class="row mb-4">
    <div class="col-4">
      <%= f.search_field :name_cont, class: 'form-control' %>
    </div>
    <div class="col-3">
      <%= f.select :status_eq, Task.statuses.keys.map.with_index { |k, i| [Task.human_attribute_name("status.#{k}"), i] }, { include_blank: true }, { class: 'form-select' } %>
    </div>
    <div class="col-3">
      <%= f.select :labels_id_eq, options_from_collection_for_select(Label.all, :id, :name), { include_blank: true }, { class: 'form-select' } %>
    </div>
    <div class="col">
      <%= f.submit class: 'btn btn-outline-primary' %>
    </div>
  </div>
<% end %>

<%= link_to t('.add_new_task'), new_task_path, class: 'btn btn-primary mb-3' %>

<div class="mb-3">
  <%= paginate @tasks %>
  <%= page_entries_info @tasks %>
</div>

<table class="table">
  <thead>
    <tr>
      <th><%= t 'tasks.task_name' %></th>
      <th><%= t 'tasks.task_desc' %></th>
      <th><%= t 'tasks.task_status' %></th>
      <th><%= t 'tasks.task_label' %></th>
      <th><%= t 'tasks.created_at' %></th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @tasks.each do |task| %>
    <tr>
      <td><%= link_to task.name, task %></td>
      <td><%= task.description %></td>
      <td><%= Task.human_attribute_name("status.#{task.status}") %></td>
      <td>
        <% task.labels.each do |label| %>
          <span class="btn btn-secondary btn-sm" style="pointer-events:none;">
            <%= label.name %>
          </span>
        <% end %>
      </td>
      <td><%= l task.created_at, format: :short %></td>
      <td>
        <%= link_to t('tasks.edit_task'), edit_task_path(task), class: 'btn btn-secondary mr-3' %>
        <%= link_to t('tasks.delete_task'), task, method: :delete, data: { confirm: "Are you sure you want to delete '#{task.name}'?" }, class: 'btn btn-danger' %>
      </td>
    </tr>
    <% end %>
  </tbody>
</table>
