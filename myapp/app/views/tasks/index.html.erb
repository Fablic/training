<h2>Search</h2>
<%= form_with(url: tasks_path, method: :get, local: true) do %>
  <div class="row mb-3">
    <%= label_tag :title, "Title", class: 'col-sm-2 col-form-label' %>
    <div class="col-sm-10"><%= text_field_tag :title, params[:title], class: 'form-control' %></div>
  </div>
  <div class="row mb-3">
    <%= label_tag :status, "Status", class: 'col-sm-2 col-form-label' %>
    <div class="col"><%= select_tag :status, options_for_select([['All', '']] + Task.statuses.keys.map { |k| [k.humanize, k] }, params[:status]), class: 'form-control' %></div>
  </div>
  <%= submit_tag t('common.search'), class: 'btn btn-sm btn-success', id: 'Search' %>
<% end %>


<% if @total_tasks_count == 0 %>
  <p><%= t('tasks.no_tasks') %></p>
<% else %>
  <h2>Tasks</h2>
  <table class="table table-striped table-bordered border-dark" id="result">
    <thead>
    <tr>
      <th>Title</th>
      <th>Description</th>
      <th>Reporter</th>
      <th>Priority</th>
      <th>Labels</th>
      <th><%= sortable "due_date", "DueDate" %></th>
      <th>Status</th>
      <th><%= sortable "created_at", "Created" %></th>
      <th><%= sortable "updated_at", "Updated" %></th>
      <th></th>
    </tr>
    </thead>
    <tbody>
    <% @tasks.each_with_index do |task, index| %>
      <tr>
        <td><%= link_to task.title, task %></td>
        <td><%= task.description %></td>
        <td><%= task.user.name %></td>
        <td><%= task.priority %></td>
        <td>N/A</td>
        <td><%= task.due_date %></td>
        <td><%= task.status %></td>
        <td><%= task.created_at %></td>
        <td><%= task.updated_at %></td>
        <td>
          <div class="d-grid gap-2 d-md-flex">
            <%= button_to t('common.update'), edit_task_path(task), method: :get, class: 'btn btn-sm btn-primary' , id: "update-#{index}"%>
            <%= link_to t('common.delete'), task_path(task), method: :delete, data: { confirm: 'Really delete?' }, class: 'btn btn-sm btn-danger', id: "delete-#{index}" %>
          </div>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
  <%= paginate @tasks, params: { search: params[:search], status: params[:status] }, theme: 'bootstrap-5' %>
<% end %>

<%= button_to t('common.create'), "/tasks/new", method: :get, class: 'btn btn-sm btn-primary', id: 'create' %>
