<div class='container-sm'>
  <h1><%= I18n.t('activerecord.misc.task.plural').capitalize %> <%= I18n.t('helpers.list') %></h1>

  <%= render 'filter_form' %>
  <%= render 'sort_form' %>

  <%= render 'shared/tasks/list', tasks: @tasks %>

  <%= link_to I18n.t('helpers.submit.create', model: I18n.t('activerecord.models.task')), new_task_path, class: "btn btn-primary", style: 'margin-bottom:10px;' %>

  <%= paginate @tasks %>

</div>
