<h1>タスク一覧</h1>
<% if flash[:notice] %>
  <p class="alert-success">
    <%= flash[:notice] %>
  </p>
<% end %>
<div name='serch-task'>
  <span>検索</span>
  <%= form_with(url: root_path, local: true, method: :get) do |f| %>
    <%= I18n.t('task.title') %>: <%= f.text_field(:title) %><br>
    <%= I18n.t('task.label') %>: <%= f.text_field(:label) %><br>
    <%= I18n.t('task.status') %>: <%= f.select(:status, Task.statuses.keys.map { |k| [I18n.t("enums.task.status.#{k}"), k] }, include_blank: true) %><br>
    <p><%= f.submit('検索') %></p>
  <% end %>
</div>
<table>
  <thead>
    <tr>
      <th scope="col">タスク</th>
      <th scope="col">説明</th>
      <th scope="col">編集</th>
      <th scope="col">削除</th>
    </tr>
  </thead>
  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td>
          <%= link_to task.title, task_path(task), id: '詳細' %>
        </td>
        <td>
          <%= task.description %>
        </td>
        <td>
          <%= link_to '編集', edit_task_path(task) %>
        </td>
        <td>
          <%= link_to '削除', task_path(task), method: :delete,  data: {confirm: "削除しますか？"} %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
  <div class='pagenation-area'>
    <%= paginate(@tasks) %>
  </div>
<%= link_to '新規登録', new_task_path %>
<td><%= button_to(I18n.t('link.logout'), logout_path, method: :delete) %></td>
