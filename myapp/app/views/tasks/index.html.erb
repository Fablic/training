<div class="container mt-5">
  <h1 class="mb-4">Tasks</h1>

  <%= link_to 'New Task', new_task_path, class: 'btn btn-primary mb-3' %>

  <div class="row">
    <% @tasks.each do |task| %>
      <div class="col-md-3"> <!-- Adjusting the height of columns -->
        <div class="card mb-4" style="height: 250px;">
          <div class="card-body d-flex flex-column">
            <h5 class="card-title">Title: <%= link_to task.title, task %></h5> <!-- Add a link to the show page -->
            <p class="card-text flex-grow-1" style="max-height: 100px; overflow: hidden;">Description: <%= task.description %></p>
            <p class="card-text"><small class="text-muted">Created at: <%= task.created_at.strftime("%Y-%m-%d %H:%M:%S") %></small></p>
            <div class="d-flex justify-content-between align-items-end mt-auto">
              <%= link_to 'Edit', edit_task_path(task), class: 'btn btn-warning btn-sm' %>
              <%= button_to 'Delete', task, method: :delete, class: 'btn btn-danger btn-sm' %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
