<div class="alert alert-success" style="color: green"><%= notice %></div>
<h1>タスク一覧画面</h1>
<table>
  <thead>
    <tr>
      <th>タスク名</th>
      <th>ステータス</th>
      <th>優先度</th>
    </tr>
  </thead>

  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.name %></td>
        <td><%= task.status_i18n %></td>
        <td><%= task.priority_i18n %></td>
        <td><%= link_to '詳細', task_path(task.id) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<br>
<%= paginate @tasks %>

<div>
<%= form_with url: tasks_path, method: :get, local: true do |f| %>
  <p>検索フォーム</p>
  <p>タスク名</p>
  <%= f.text_field :name %>
  <p>ステータス</p>
  <%= f.select :status, Task.statuses_i18n.keys.map { |k| [Task.statuses_i18n[k], k] } %>
  <%= f.submit '検索' %>
<% end %>
</div>

<%= link_to '新規登録', new_task_path %>
<br>

<%= link_to 'ログアウト', logout_path, method: :delete %>
