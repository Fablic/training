<h1>Task List</h1>
<%= flash[:notice] %>
<%= flash[:success] %>
<%= flash[:alert] %>

<%= form_with url: '#', method: :get, local: true do |form| %>
  <%= form.label :sort_by %>
  <%= form.select :sort_by, [['id', 'id'], ['Create Date', 'created_at'], ['Due Date', 'due']], id: 'selected_sort_by' %>

  <%= form.label :order %>
  <%= form.select :order, ['asc', 'desc'], id: 'selected_order' %>

  <%= form.submit 'Sort' %>
<% end %>

<br>

<table>
  <thead>
    <tr>
      <td><h2>Id</h2></td>
      <td><h2>Due Date</h2></td>
      <td><h2>Title</h3></td>
    </tr>
  </head> 

  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.id %></td>
        <td><%= task.due %></td>
        <td><h3><%= task.title %></h3></td>
        <td><%= button_to "Delete", task_path(task), method: :delete, id: task.id %></td>
      </tr>
    <% end %>
  </tbody>
</table>


