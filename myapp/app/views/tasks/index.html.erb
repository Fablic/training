<h1>タスク一覧</h1>
<table class="table">
  <thead>
    <tr>
      <th scope="col">#</th>
      <th scope="col">Title</th>
    </tr>
  </thead>
  <tbody>
<% @tasks.each do |task| %>
    <tr>
      <th scope="row"><%= task.id %></th>
      <td><%= link_to task.title, task %></td>
    </tr>
<% end %>
  </tbody>
</table>
<p><%= link_to '新規作成', new_task_path %></p>
