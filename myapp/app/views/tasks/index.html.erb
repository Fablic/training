<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center">
    <h1><%= t('views.tasks.index.title') %></h1>
    <button id="logout" class="btn btn-outline-secondary"><%= t('views.common.login') %></button>
  </div>
  <% if @tasks.any? %>
    <input type="text" class="form-control w-25" placeholder="<%= t('views.common.search') %>" id="search">
    <table class="table table-striped table-hover">
      <thead class="thead-light">
        <tr>
          <th scope="col"><%= t('activerecord.attributes.task.label') %></th>
          <th scope="col"><%= t('activerecord.attributes.task.title') %></th>
          <th scope="col"><%= t('activerecord.attributes.task.assignee') %></th>
          <th scope="col"><%= t('activerecord.attributes.task.due_date') %></th>
          <th scope="col"><%= t('activerecord.attributes.task.status') %></th>
          <th scope="col"><%= t('activerecord.attributes.task.priority') %></th>
        </tr>
      </thead>
      <tbody>
        <% @tasks.each do |task| %>
          <tr>
            <td>Labels</td>
            <td><%= link_to task.title, task_path(task) %></td>
            <td>Ryu</td>
            <td>0000/00/00</td>
            <td>Not started</td>
            <td>Low</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-center"><%= t('views.tasks.index.no_tasks') %></p>
  <% end %>
  <div class="d-flex justify-content-end">
    <%= link_to t('views.common.add'), new_task_path, class: "btn btn-primary" %>
  </div>
</div>
