<h2>Tasks</h2>
<% if @total_tasks_count == 0 %>
  <div class="alert alert-warning" role="alert"><%= t('tasks.no_tasks') %></div>
<% end %>
<%= form_with(url: tasks_path, method: :get, local: true) do %>
  <div class="row mb-3">
    <%= label_tag :title, "Title", class: 'col-sm-2 col-form-label' %>
    <div class="col-sm-10"><%= text_field_tag :title, params[:title], class: 'form-control' %></div>
  </div>
  <div class="row mb-3">
    <%= label_tag :status, "Status", class: 'col-sm-2 col-form-label' %>
    <div class="col-sm-10"><%= select_tag :status, options_for_select([['All', '']] + Task.statuses.keys.map { |k| [k.humanize, k] }, params[:status]), class: 'form-control' %></div>
  </div>
  <div class="row mb-3">
    <%= label_tag :status, "label", class: 'col-sm-2 col-form-label' %>
    <div class="col-sm-10"><%= text_field_tag :label_name, params[:label_name], class: 'form-control' %></div>
  </div>
  <div class="mb-3">
    <%= submit_tag t('common.search'), class: 'btn btn-sm btn-success', id: 'search' %>
  </div>
<% end %>

<% if @total_tasks_count != 0 %>
  <table class="table table-striped table-bordered border-dark" id="result">
    <thead>
    <tr>
      <th>Title</th>
      <th>Description</th>
      <th>Reporter</th>
      <th>Priority</th>
      <th><%= sortable "created_at", "Created" %></th>
      <th><%= sortable "updated_at", "Updated" %></th>
      <th><%= sortable "due_date", "DueDate" %></th>
      <th>Status</th>
      <th>Labels</th>
      <th>Operation</th>
    </tr>
    </thead>
    <tbody>
    <% @tasks.each_with_index do |task, index| %>
      <tr>
        <td><%= link_to task.title, task %></td>
        <td><%= task.description %></td>
        <td><%= task.user.name %></td>
        <td><%= task.priority %></td>
        <td>
          <span title="<%= task.created_at.strftime('%Y-%m-%d %H:%M:%S') %>"><%= task.created_at.strftime('%Y-%m-%d') %></span>
        </td>
        <td>
          <span title="<%= task.created_at.strftime('%Y-%m-%d %H:%M:%S') %>"><%= task.updated_at.strftime('%Y-%m-%d') %></span>
        </td>
        <td><%= task.due_date %></td>
        <td><%= task.status %></td>
        <td>
          <% task.labels.each do |label| %>
            <span class="badge rounded-pill text-bg-secondary"><%= label.name %></span>
          <% end %>
        </td>
        <td>
          <div class="d-grid gap-2 d-md-flex">
            <%= button_to t('common.update'), edit_task_path(task), method: :get, class: 'btn btn-sm btn-primary', id: "update-#{index + 1}" %>
            <%= button_to t('common.delete'), task_path(task), method: :delete, data: { confirm: 'Really delete?' }, class: 'btn btn-sm btn-danger', id: "delete-#{index + 1}" %>
          </div>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
  <%= paginate @tasks, params: { search: params[:search], status: params[:status] }, theme: 'bootstrap-5'%>
<% end %>

<%= button_to t('common.create'), "/tasks/new", method: :get, class: 'btn btn-sm btn-primary', id: 'create' %>
