
  <%= render 'dashboard'%>


  <%= render 'searchbox'%>


<div class="section">

<h1 class="title has-text-primary">
  <%= Task.model_name.human + t('actions.list')%>
  <%= link_to "#{t('actions.new')} #{Task.model_name.human}", new_task_path, class:"button is-link" %>
</h1>
<div class='box'>




<%= paginate @tasks %>
<%= page_entries_info @tasks %>

<table class="table is-striped is-narrow is-hoverable is-fullwidth" id="task_list">
  <thead>
    <tr>
      <th><%= sort_link(@q, :id) %></th>
      <th><%= sort_link(@q, 'user_name') %></th>
      <th><%= sort_link(@q, :status) %></th>
      <th><%= sort_link(@q, :priority) %></th>
      <th><%= sort_link(@q, :name) %></th>
      <th>LABEL</th>
      <th><%= sort_link(@q, :started_at) %></th>
      <th><%= sort_link(@q, :finished_at) %></th>
      <th><%= sort_link(@q, :created_at) %></th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.id %></td>
        <td><%= task.user.name %></td>
        <td><%= t("enums.task.status.#{task.status}")  %></td>
        <td><%= task.priority %></td> 
        <td><%= task.name %></td>
        <td>
            <% task.labels.each do |label| %>
               <span class="tag"><%= label.name %></span>
            <% end %>
        </td>
        <td><%= task.started_at ? l(task.started_at.to_date): ''  %></td>
        <td><%= l(task.finished_at.to_date) %></td>
        <td><%= l(task.created_at) %></td>
        <td><%= link_to t('actions.show'), task , class: "button is-link" %></td>
        <td><%= link_to t('actions.edit'), edit_task_path(task) , class: "button is-link" %></td>
        <td><%= link_to t('actions.destroy'), task, method: :delete, class: "button is-danger", data: { confirm: t('messages.delete_confirm') } %></td>

      </tr>
    <% end %>
  </tbody>
</table>



</div>
</div>

