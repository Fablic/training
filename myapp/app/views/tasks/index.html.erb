<div>
  <%= link_to '新規登録', new_task_path %>
  <table>
    <tr>
      <th>id</th>
      <th>件名</th>
      <th>内容</th>
      <th>その他</th>
    </tr>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.id %></td>
        <td><%= task.title %></td>
        <td><%= task.content %></td>
        <td>
          <%= link_to '詳細', task_path(task.id) %>
          <%= link_to '編集', edit_task_path(task.id) %>
          <%= link_to '削除', task_path(task.id), method: :delete %>
        </td>
      </tr>
    <% end %>
  </table>
</div>
