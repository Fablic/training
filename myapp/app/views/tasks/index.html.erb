<h1>タスク一覧</h1>
<%= h(flash[:success]) %>
<p><%= link_to 'タスク作成', new_task_path, id: 'click_new_task' %></p>
<table>
    <thead>
        <tr>
          <th>タスク名</th>
          <th>説明</th>
          <th>編集</th>
          <th>削除</th>
        </tr>
    </thead>
    <tbody>
        <% @tasks.each do |task| %>
            <tr>
              <td><%= link_to task.name, task,id: "task_name_#{task.id}" %></td>
              <td><%= task.description %></td>
              <td><%= link_to 'Edit', edit_task_path(task) ,id: "link_edit_task_#{task.id}"%></td>
              <td><%= link_to 'Destroy', task, method: :delete,
                                              data: { confirm: 'Are you sure?' } ,id: "link_destroy_task_#{task.id}"%></td>
            </tr>
        <% end %>
    </tbody>
</table>
