<p id="notice"><%= notice %></p>

<h1><%= Task.model_name.human + t('actions.list')%></h1>

<table class="type06" id="task_list">
  <thead>
    <tr>
      <th><%= User.human_attribute_name(:name)  %></th>
      <th><%= link_to Task.human_attribute_name(:status), {sort: :status, direction: get_sort_direction(:status)} %></th>
      <th><%= link_to Task.human_attribute_name(:name), {sort: :name, direction: get_sort_direction(:name)} %></th>
      <th><%= link_to Task.human_attribute_name(:started_at), {sort: :started_at, direction: get_sort_direction(:started_at)} %></th>
      <th><%= link_to Task.human_attribute_name(:finished_at), {sort: :finished_at, direction: get_sort_direction(:finished_at)} %></th>
      <th><%= link_to Task.human_attribute_name(:created_at), {sort: :created_at, direction: get_sort_direction(:created_at)} %></th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.user.name %></td>
        <td><%= t("enums.task.status.#{task.status}")  %></td>
        <td><%= task.name %></td>
        <td><%= task.started_at ? l(task.started_at.to_date): ''  %></td>
        <td><%= l(task.finished_at.to_date) %></td>
        <td><%= l(task.created_at) %></td>
        <td><%= link_to t('actions.show'), task %></td>
        <td><%= link_to t('actions.edit'), edit_task_path(task) %></td>
        <td><%= link_to t('actions.destroy'), task, method: :delete, data: { confirm: t('messages.delete_confirm') } %></td>

      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to "#{t('actions.new')} #{Task.model_name.human}", new_task_path %>
