<h1>List of Tasks</h1>
<% if flash[:notice] %>
  <p><%= flash[:notice] %></p>
<% end %>
<%= form_with url: tasks_path, local: true, method: :get do %>
  <p>Search for tasks</p>
  <%= text_field_tag(:search, params[:search]) %>
  <%= submit_tag ("Search") %>
<% end %>
<table>
  <thead>
    <tr>
      <th>Title</th>
      <th>Description</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.title %></td>
        <td><%= task.description %></td>
        <td><%= link_to 'show', task_path(task.id) %></td>
        <td><%= link_to 'edit', edit_task_path(task) %></td>
        <td><%= button_to 'delete', task_path(task.id), method: :delete, form: {data: {confirm: 'Are you sure?'}} %></td>
      </tr>
    <% end %>
  </tbody>
</table>


<p><%= link_to 'create', 'tasks/new' %></p>
