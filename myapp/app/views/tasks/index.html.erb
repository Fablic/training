<h1>Tasks#list</h1>

<table>
    <tr>
        <th>id</th>
        <th>title</th>
    </tr>

<% @tasks.each do |task| %>
    <tr>
        <td><%= task.id %></td>
        <td><%= link_to task.title, task%></td>
        <td><%= link_to 'Edit', edit_task_path(id: task.id)%></td>
        <td><%= link_to 'Delete', task, method: :delete, data: { confirm: 'Are you sure?' } %></td>
    </tr>
<% end %>
</table>
<p><%= link_to 'Create', new_task_path, class: "task-new" %></p>
