<p style="color: green"><%= notice %></p>

<h1>タスク一覧</h1>
<table>
  <thead>
    <tr>
      <th>タスク名</th>
    </tr>
  </thead>

  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.name %></td>
        <td><%= link_to '詳細', task_path(task.id) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<br>

<%= link_to '新規作成', new_task_path %>
