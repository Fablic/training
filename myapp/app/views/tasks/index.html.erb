<h1>タスクの一覧画面</h1>
<table>
  <thead>
    <tr>
      <th>Title</th>
      <th>Description</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.title %></td>s
        <td><%= task.description %></td>
        <td><%= link_to 'show', task_path(task.id) %></td>
        <td><%= link_to 'edit', edit_task_path(task) %></td>
        <td><%= button_to 'delete', task_path(task.id), method: :delete,form: { data: {turbo_confirm: "Are you sure?"}} %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<p><%= link_to 'create', 'tasks/new' %></p>
