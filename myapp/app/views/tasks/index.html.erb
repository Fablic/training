<h1><%= t '.title' %></h1>
<%= h(flash[:success]) %>

<div>
  <%= form_with url: tasks_path,method: :get ,local: true do |f| %>
    <%= f.text_field :content %>
    <%= f.submit'検索' %>
  <% end %>
</div>

<p><%= link_to 'タスク作成', new_task_path, id: 'new_task_link' %></p>
<table>
    <thead>
        <tr>
          <th><%= sort_order "name", t('tasks.label.name') %></th>
          <th><%= sort_order "description", t('tasks.label.description') %></th>
          <th><%= sort_order "deadline_at", t('tasks.label.deadline_at') %></th>
          <th><%= sort_order "status", t('tasks.label.status') %></th>
          <th><%= t 'tasks.label.edit' %></th>
          <th><%= t 'tasks.label.destroy' %></th>
        </tr>
    </thead>
    <tbody>
        <% @tasks.each_with_index do |task, i| %>
            <tr id="task_row_<%= i %>">
              <td><%= link_to task.name, task,id: "task_name_#{task.id}" %></td>
              <td><%= task.description %></td>
              <td><%= l(task.deadline_at, format: :long_ja) %></td>
              <td><%= task.status_i18n %></td>
              <td><%= link_to t('tasks.label.edit'), edit_task_path(task) ,id: "link_edit_task_#{task.id}"%></td>
              <td><%= link_to t('tasks.label.destroy'), task, method: :delete,
                                              data: { confirm: t('tasks.message.destroy') } ,id: "link_destroy_task_#{task.id}"%></td>
            </tr>
        <% end %>
    </tbody>
</table>
