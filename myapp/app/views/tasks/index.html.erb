
<h1>Search</h1>
<%= form_with(url: tasks_path, method: :get, local: true) do %>
  <div class="field">
    <%= label_tag :title, "Title" %>
    <%= text_field_tag :title, params[:title] %>
  </div>
  <div class="field">
    <%= label_tag :status, "Status" %>
    <%= select_tag :status, options_for_select([['All', '']] + Task.statuses.keys.map { |k| [k.humanize, k] }, params[:status]) %>
  </div>
  <div class="actions">
    <%= submit_tag "Search" %>
  </div>
<% end %>



<h2>Tasks</h2>
<% flash.each do |key, message| %>
  <div class="flash <%= key %>"><%= message %></div>
<% end %>

<% if @tasks.empty? %>
  <p><%= t('tasks.no_tasks') %></p>
<% end %>

<table id="result">
  <thead>
  <tr>
    <th>Title</th>
    <th>Description</th>
    <th>Priority</th>
    <th>Labels</th>
    <th><%= sortable "due_date", "DueDate" %></th></th>
    <th>Status</th>
    <th><%= sortable "created_at", "Created" %></th>
    <th><%= sortable "updated_at", "Updated" %></th>
    <th>-</th>
    <th>-</th>
  </tr>
  </thead>
  <tbody>
  <% @tasks.each do |task| %>
    <tr>
      <td><%= link_to task.title, task %></td>
      <td><%= task.description %></td>
      <td><%= task.priority %></td>
      <td>N/A</td>
      <td><%= task.due_date %></td>
      <td><%= task.status %></td>
      <td><%= task.created_at %></td>
      <td><%= task.updated_at %></td>
      <td><%= link_to "Edit", edit_task_path(task) %></td>
      <td>
        <%= button_to "Delete", task_path(task), method: :delete, form: { data: { turbo_confirm: "Really delete?" }}%>
      </td>
    </tr>
  <% end %>
  </tbody>
</table>

<br>
<%= link_to "Create task", "/tasks/new" %>
