<h1><%= t '.title' %></h1>

<table>
  <tr>
    <th><%= Task.human_attribute_name :id %></th>
    <th><%= Task.human_attribute_name :title %></th>
    <th><%= Task.human_attribute_name :description %></th>
    <th><%= t 'tasks.common.edit' %></th>
  </tr>
  <% @tasks.each do |task| %>
    <tr>
      <td><%= task.id %></td>
      <td><%= link_to task.title, task %></td>
      <td><%= task.description %></td>
      <td><%= link_to (t 'tasks.common.edit'), edit_task_path(task) %></td>
    </tr>
  <% end %>
</table>

<%= link_to (t 'tasks.common.new_task'), new_task_path %>
