<h1><h1><%= t("page.task") %></h1></h1>

<% if flash[:notice] %>
  <div class="alert alert-success"><%= flash[:notice] %></div>
<% end %>
<% if flash[:alert] %>
  <div class="alert alert-danger"><%= flash[:alert] %></div>
<% end %>

<% if @tasks.empty? %>
  <p>No Task</p>
<% else %>
<div class="container">
<table class="table">
  <thead>
    <tr>
      <th><%= t('name') %></th>
      <th>
      <%= t('deadline') %>
      <%= link_to tasks_path(sort_by: 'deadline', direction: 'asc') do %>
        <span class="arrow <%= 'active' if params[:sort_by] == 'deadline' && params[:direction] == 'asc' %>">
          &uarr;
        </span>
      <% end %>
      <%= link_to tasks_path(sort_by: 'deadline', direction: 'desc') do %>
        <span class="arrow <%= 'active' if params[:sort_by] == 'deadline' && params[:direction] == 'desc' %>">
          &darr;
        </span>
      <% end %>
      </th>
      <th>
      <%= t('created_at') %>
      <%= link_to tasks_path(sort_by: 'created_at', direction: 'asc') do %>
        <span class="arrow <%= 'active' if params[:sort_by] == 'created_at' && params[:direction] == 'asc' %>">
          &uarr;
        </span>
      <% end %>
      <%= link_to tasks_path(sort_by: 'created_at', direction: 'desc') do %>
        <span class="arrow <%= 'active' if params[:sort_by] == 'created_at' && params[:direction] == 'desc' %>">
          &darr;
        </span>
      <% end %>
      </th>
      <th><%= t('priority') %></th>
      <th><%= t('status') %></th>
      <th><%= t('labels') %></th>
    </tr>
  </thead>
  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= link_to task.name, task %></td>
        <td><%= task.deadline.strftime("%Y-%m-%d %H:%M") %></td>
        <td><%= task.created_at.strftime("%Y-%m-%d %H:%M") %></td>
        <td><%= t("activerecord.attributes.task.priorities.#{task.priority}") %></td>
        <td><%= t("activerecord.attributes.task.statuses.#{task.status}") %></td>
        <td>Label</td>
        <td>
          <%= link_to edit_task_path(task), class: "text-decoration-none" do %>
            <i class="bi bi-pencil-square"></i>
            <span class="visually-hidden">Edit</span>
          <% end %> |
          <%= link_to task, method: :delete, data: { turbo_method: :delete , turbo_confirm: "Are you sure?" }, class: "text-decoration-none" do %>
            <i class="bi bi-trash"></i>
            <span class="visually-hidden">Delete</span>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
</div>
<% end %>

<%= link_to new_task_path, class: "btn btn-primary text-decoration-none" do  %>
  <i class="bi bi-plus-circle"></i>
  <span><%= t('button.new_task') %></span>
<% end %>

