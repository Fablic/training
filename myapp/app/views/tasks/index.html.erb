<div class="d-flex align-items-end">
  <h1>Tasks#list</h1>
  <%= link_to t('tasks.create'), new_task_path, class: "btn btn-info ml-auto" %>
</div>

<%= render "filter" %>

<table class="table table-striped mb-3">
  <thead class="thead-dark">
    <tr>
      <th scope="col"><%= '#' %></th>
      <th scope="col"><%= 'Title' %></th>
      <th scope="col"><%= 'Created' %></th>
      <th scope="col"><%= sort_link(@search, :due_date) do %>
        <%= 'DueDate' %>
        <% end %>
      </th>
      <th scope="col"><%= 'Status' %></th>
      <th scope="col"><%= 'Actions' %></th>
      <th scope="col"></th>
    </tr>
  </thead>
  <% @tasks.each do |task| %>
  <tr scope="row">
    <td><%= task.id %></td>
    <td><%= link_to task.title, task %></td>
    <td><%= l task.created_at %></td>
    <td><%= l task.due_date %></td>
    <td><%= t("activerecord.attributes.task.status.#{task.status}") %></td>
    <td><%= link_to t('tasks.edit'), edit_task_path(id: task.id) %></td>
    <td><%= link_to t('tasks.delete'), task, method: :delete, data: { confirm: 'Are you sure?' } %></td>
  </tr>
  <% end %>
</table>

<%= paginate @tasks %>
