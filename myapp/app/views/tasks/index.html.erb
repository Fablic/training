<div class="alert alert-success" style="color: green"><%= notice %></div>
<h1><%= t('tasks.index.page_title') %></h1>
<table>
  <thead>
    <tr>
      <th><%= Task.human_attribute_name(:name) %></th>
      <th><%= Task.human_attribute_name(:status) %></th>
      <th><%= Task.human_attribute_name(:priority) %></th>
    </tr>
  </thead>

  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.name %></td>
        <td><%= I18n.t("enums.task.status.#{task.status}") %></td>
        <td><%= I18n.t("enums.task.priority.#{task.priority}") %></td>
        <td><%= link_to '詳細', task_path(task.id) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<br>
<%= paginate @tasks %>

<div>
<%= form_with url: search_path, method: :get, local: true do |f| %>
  <p>検索フォーム</p>
    <p style="display: inline"><%= Task.human_attribute_name(:name) %></p>
    <%= f.text_field :name %>
    <br>
    <p style="display: inline"><%= Task.human_attribute_name(:status) %></p>
    <%= f.select :status, Task.statuses.keys.map { |k| [I18n.t("enums.task.status.#{k}"), k] } , include_blank: true %>
  <br>
  <%= f.submit t('common.button.search') %>
<% end %>
</div>
<br>

<%= link_to t('common.link.tasks.new'), new_task_path %>
<br>
