<p style="color: green"><%= notice %></p>

<h1>タスク一覧</h1>

<%= link_to I18n.t('transition_destination.create'), new_task_path %>

<div id="tasks">
  <table border="1">
    <tr>
      <%= render 'header' %>
      <th>詳細</th>
    </tr>

    <% @tasks.each do |task| %>
      <div id="<%= dom_id task %>">
        <tr>
          <%= render 'attributes', task: %>
          <td><%= link_to I18n.t('transition_destination.show'), task %></td>
        </tr>
      </div>
    <% end %>
  </table>
</div>
