<p id="notice"><%= notice %></p>

<h1><%= t '.title' %></h1>
<%= form_tag(tasks_path,:method => 'get') do %>
  <%= select_tag(:status, options_for_select(Task.statuses.keys.map { |k| [t("enums.task.status.#{k}"), k]})) %>
  <%= text_field_tag :task_name %>
  <%= submit_tag :search %>
<% end %>

<table>
  <thead>
    <tr>
      <th><%= t '.task_name' %></th>
      <th><%= t '.description' %></th>
      <th><%= t '.starts_on' %></th>
      <th><%= t '.ends_on' %></th>
      <th><%= t '.priority' %></th>
      <th><%= t '.label' %></th>
      <th><%= t '.status' %></th>
    </tr>
  </thead>

  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.task_name %></td>
        <td><%= task.description %></td>
        <td><%= task.starts_on %></td>
        <td><%= task.ends_on %></td>
        <td><%= task.priority %></td>
        <td><%= task.label %></td>
        <td><%= t("enums.task.status.#{task.status}")  %></td>
        <td><%= link_to (t '.show'), task %></td>
        <td><%= link_to (t '.edit'), edit_task_path(task) %></td>
        <td><%= link_to (t '.destory'), task, method: :delete, data: { confirm: (t '.Are you sure?') } %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<%= paginate @tasks %>

<br>

<%= link_to (t '.new_task'), new_task_path %>
