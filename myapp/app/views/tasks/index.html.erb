<div class='mt-5 mb-5 container', style='text-align:center'> 
  <h1><%= t('views.titles.task_list') %></h1>
</div>

<%= render 'log_out' %>

<div class='mb-5 container'>
  <h4 class='fst-italic text-info', style='text-align:center'>
    <%= flash[:notice] %>
  </h3>
</div>

<div class='mb-5 container'>
  <div class='mb-4'>
    <%= form_with url: '#', method: :get, local: true do |form| %>
      <div class='mb-3 w-50'>
        <%= form.label :query_title, t('views.labels.search_title'), class: 'form-label' %>
        <%= form.search_field :query_title, maxlength: 20, class: 'form-control' %>
      </div>

      <div class='mb-3 w-50'>
        <%= form.label :query_status, t('views.labels.search_status'), class: 'form-label' %>
        <%= form.select :query_status, [[t('views.selects.status_all'), ''], [t('views.selects.status_pending'), 'pending'], [t('views.selects.status_in_progress'), 'in_progress'], [t('views.selects.status_completed'), 'completed']], {}, { class: 'form-select' } %>
      </div>

      <div class='row justify-content-start'>
        <div class='col-4'>
          <div class='mb-3'>
            <%= form.label :sort_by, t('views.labels.sort_by'), class: 'form-label' %>
            <%= form.select :sort_by, [[t('views.selects.sort_create_date'), 'created_at'], [t('views.selects.sort_due_date'), 'due']], {}, { class: 'form-select' } %>
          </div>
        </div>

        <div class='col-4'>
          <div class='mb-3'>
            <%= form.label :order, t('views.labels.order'), class: 'form-label' %>
            <%= form.select :order, [[t('views.selects.order_desc'), 'desc'], [t('views.selects.order_asc'), 'asc']], {}, { class: 'form-select' } %>
          </div>
        </div>
      </div>

      <%= form.submit t('views.buttons.filter'), class: 'btn btn-outline-primary' %>
    <% end %>
  </div>

  <div class='d-flex justify-content-end'>
    <%= button_to t('views.buttons.create'), new_task_path, method: :get, class: 'btn btn-primary' %>
  </div>

  <table class='table table-striped table-hover'>
    <thead>
      <tr style="text-align:center">
        <td><h2><%= t('views.texts.title') %></h3></td>
        <td><h2><%= t('views.texts.due') %></h2></td>
        <td><h2><%= t('views.texts.status') %></h3></td>
      </tr>
    </head> 

    <tbody>
      <% @tasks.each do |task| %>
        <tr>
          <td>
            <h3><%= link_to task.title, task_path(task), class: 'btn link-without-underline' %></h3>
          </td>
          <td><%= l task.due, format: :preview %></td>
          <td><%= status_label(task)%></td>

          <td><%= button_to t('views.buttons.edit'), edit_task_path(task), method: :get, id: "Edit#{task.id}", class: 'btn btn-outline-success' %></td>
          <td><%= button_to t('views.buttons.delete'), task_path(task), method: :delete, id: "Delete#{task.id}", class: 'btn btn-danger' %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class='container'>
  <div class='d-flex justify-content-center', id='pagination-bar'>
    <%= paginate @tasks, theme: 'bootstrap-5' %>
  </div>
</div>
