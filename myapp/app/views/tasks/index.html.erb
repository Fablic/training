<% if @tasks.any? %>
  <h3> Tasks (<%= @tasks.count %>)</h3>
  <%= will_paginate @tasks,:previous_label => ' &lt', :next_label => '&gt' %>
    <table border='1'>
      <thead>
        <tr>
          <th scope="col"><%= sort_order "id","No" %></th>
          <th scope="col"><%= sort_order "title",t('activerecord.attributes.task.title') %></th>
          <th scope="col"><%= sort_order "priority",t('activerecord.attributes.task.priority') %></th>
          <th scope="col"><%= sort_order "status",t('activerecord.attributes.task.status') %></th>
          <th scope="col"><%= sort_order "due_date",t('activerecord.attributes.task.due_date') %></th>
          <th scope="col"><%= sort_order "created_at",t('activerecord.attributes.task.create_date') %></th>
        </tr>
      </thead>
      <tbody>
        <%= render partial: "task", collection: @tasks  %>
      </tbody>
    </table>    
  <%= will_paginate @tasks,:previous_label => ' &lt', :next_label => '&gt' %>
<% end %>
