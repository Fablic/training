<% content_for(:page_title, t('.title')) %>

<%= link_to 'Add Task', '/tasks/new' %>

<div>
  <% @tasks.each do |task| %>
    <%= link_to task.name, task %>
    <%= link_to 'Edit', edit_task_path(task) %>
    <%= link_to "Delete", task, method: :delete, data: {confirm: "Do you want to delete #{task.name}?"} %><br />
  <% end %>
</div>
