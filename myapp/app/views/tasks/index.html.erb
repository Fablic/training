<div>
  <p><%= link_to '新規登録', new_task_path %></p>

  <% if  @tasks.present? %>
    <p><%= render partial: 'search' %></p>
  <% end %>

  <h1>タスク管理</h1>

  <table class='tasks' border='1'>
    <thead>
    <tr>
      <th><%= t('activerecord.attributes.task.id') %></th>
      <td><%= t('activerecord.attributes.task.title') %></td>
      <td><%= t('activerecord.attributes.task.content') %></td>
      <td><%= t('activerecord.attributes.task.status') %></td>
      <td><%= t('activerecord.attributes.task.created_at') %></td>
      <td><%= t('activerecord.attributes.task.another') %></td>
    </tr>
    </thead>
    <tbody>
      <% @tasks.each do |task| %>
        <tr>
          <td><%= task.id %></td>
          <td class='task-title'><%= task.title %></td>
          <td><%= task.content %></td>
          <td><%= task.status %></td>
          <td><%= l task.created_at, format: :short %></td>
          <td>
            <%= link_to '詳細', task_path(task.id) %>
            <%= link_to '編集', edit_task_path(task.id) %>
            <%= link_to '削除', task_path(task.id), method: :delete %>
          </td>
        </tr>
      <% end %>
    <tbody>
  </table>
</div>
