<% content_for :title do %>
<%= t('.title')%>
<% end %>

<div class="navi">
    <%= link_to t('.new'), new_task_path %>
</div>

<div class="task-list">
    <% if @taskList.length > 0 %>
    <table>
        <tr>
            <th><%= t('activerecord.attributes.tasks.title') %></th>
            <th><%= t('activerecord.attributes.tasks.status') %></th>
            <th><%= t('activerecord.attributes.tasks.deadline') %></th>
            <th><%= t('activerecord.attributes.tasks.priority') %></th>
            <th><%= t('activerecord.attributes.tasks.label_id') %></th>
            <th><%= t('.operation') %></th>
        </tr>
        <% @taskList.each do |task| %>
        <tr>
            <td><%= link_to task.title, task %></td>
            <td><%= task.status %></td>
            <td><%= task.deadline %></td>
            <td><%= task.priority %></td>
            <td><%= task.label_id %></td>
            <td>
                <%= link_to t('.edit'), edit_task_path(task) %>
                <%= link_to t('.destroy'), task_path(task), method: :delete, data: { confirm: t('dictionary.message.destroy.confirm') } %>
            </td>
        </tr>
        <% end %>
    </table>
    <% else %>
    <p class="alert"><%= t('dictionary.message.no_task') %></p>
    <% end %>
</div>
