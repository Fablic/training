<h1>Tasks#list</h1>

<%= render "filter" %>
<%= link_to t('tasks.create'), new_task_path, class: "btn btn-info mb-3" %>

<table class="mb-3">
  <tr>
    <th><%= t('tasks.id') %></th>
    <th><%= t('tasks.title') %></th>
    <th><%= t('tasks.created_at') %></th>
    <th><%= sort_link(@search, :due_date) do %>
      <%= t('tasks.due_date') %>
      <% end %>
    </th>
    <th><%= t('tasks.status') %></th>
    <th>
  </tr>
  <% @tasks.each do |task| %>
  <tr>
    <td><%= task.id %></td>
    <td><%= link_to task.title, task %></td>
    <td><%= l task.created_at %></td>
    <td><%= l task.due_date %></td>
    <td><%= t("activerecord.attributes.task.status.#{task.status}") %></td>
    <td><%= link_to t('tasks.edit'), edit_task_path(id: task.id) %></td>
    <td><%= link_to t('tasks.delete'), task, method: :delete, data: { confirm: 'Are you sure?' } %></td>
  </tr>
  <% end %>
</table>

<%= paginate @tasks %>
