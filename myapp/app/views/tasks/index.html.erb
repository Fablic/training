<h1><%= t('.title') %></h1>
<%= render 'flash' %>

<%= form_with url: tasks_path, local: true, method: :get do |form| %>
  <%= form.text_field(:search, value: params[:search]) %>
  <%# <%= submit_tag (t'.search') %> 
<%# <% end %> 
<%# <%= form_with url: tasks_path, local: true, method: :get do |form| %> 
  <%= form.select(:status, 
                  Task.enum_options_for_select_status, 
                  { include_blank: "#{Task.human_attribute_name :status}",
                    :selected => params[:status] }) %>
  <%= submit_tag (t'.filter') %>
<% end %>
<table>
  <thead>
    <tr>
      <th><%= Task.human_attribute_name(:title) %></th>
      <th><%= Task.human_attribute_name(:description) %></th>
      <th><%= Task.human_attribute_name(:created_at) %></th>
      <th><%= link_to Task.human_attribute_name(:expiration_date), 
              tasks_path(sort: "expiration_date", is_order_desc: !params[:is_order_desc] ? params[:is_order_desc] : "true") %></th>
      <th><%= Task.human_attribute_name :status %></th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.title %></td>
        <td><%= task.description %></td>
        <td><%= task.created_at.strftime("%Y-%m-%d %H:%M:%S") %></td>
        <td><%= task.expiration_date.nil? ? '' : task.expiration_date.strftime("%Y-%m-%d %H:%M:%S") %></td>
        <td><%= Task.human_enum_name('status', task.status) %></td>
        <td><%= link_to t('tasks.index.show'), task_path(task.id) %></td>
        <td><%= link_to t('tasks.index.edit'), edit_task_path(task) %></td>
        <td><%= button_to t('tasks.index.delete'), task_path(task.id), method: :delete, form: {data: {confirm: t('tasks.index.delete_confirmation')}} %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<%= paginate @tasks %>

<p><%= link_to t('tasks.index.create'), new_task_path %></p>
