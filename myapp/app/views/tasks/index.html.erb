<h1>Task list</h1>

<table>
  <thead>
    <tr>
      <% Task.column_names.each do |t| %>
        <th><%= t %></th>
      <% end %>
      <th colspan="2"></th>
    </tr>
  </thead>
  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <% task.attributes.values.each do |v| %>
          <th><%= v %></th>
        <% end %>
        <th><%= link_to "Edit", "/tasks/#{task.id}/edit" %></th>
        <th><%= link_to "Delete", "/tasks/#{task.id}", data: { turbo_method: :delete } %></th>
      </tr>
    <% end %>
  </tbody>
</table>
