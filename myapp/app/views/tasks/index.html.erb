<div class="alert alert-success" style="color: green"><%= notice %></div>
<h1>タスク一覧画面</h1>
<table>
  <thead>
    <tr>
      <th>タスク名</th>
      <th>ステータス</th>
      <th>優先度</th>
      <th>ラベル</th>
    </tr>
  </thead>

  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.name %></td>
        <td><%= I18n.t("enums.task.status.#{task.status}") %></td>
        <td><%= I18n.t("enums.task.priority.#{task.priority}") %></td>
        <td>
          <% task.labels.each do |label| %>
            <%= label.label_name %>
          <% end %>
        </td>
        <td><%= link_to '詳細', task_path(task.id) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<br>
<%= paginate @tasks %>

<div>
<%= form_with url: search_path, method: :get, local: true do |f| %>
  <p>検索フォーム</p>
    <p style="display: inline">タスク名</p>
    <%= f.text_field :name %>
    <br>
    <p style="display: inline">ステータス</p>
    <%= f.select :status, Task.statuses.keys.map { |k| [I18n.t("enums.task.status.#{k}"), k]} , include_blank: true %>
    <br>
    <p style="display: inline">ラベル</p>
    <%= f.select :label_id, Label.pluck(:label_name, :id), { include_blank: true } %>
  <br>
  <%= f.submit '検索' %>
<% end %>
</div>
<br>

<%= link_to '新規登録', new_task_path %>
<br>

<%= link_to 'ログアウト', logout_path, method: :delete %>
