<p style="color: green"><%= notice %></p>

<h1 class="display-1">検索フォーム</h1>

<%= link_to I18n.t('sessions.button.logout'), logout_path, method: :delete, class: "btn btn-primary mx-1" %>

<%= render "search_form" %>

<h1 class="display-1">タスク一覧</h1>

<div style="padding:10px;">
  <%= link_to I18n.t('transition_destination.create'), new_task_path, { class: "btn btn-primary mx-1" } %>
</div>

<div id="tasks">
  <table class="table table-striped table-bordered">
    <tr>
      <%= render 'header' %>
      <th scope="col">詳細</th>
    </tr>

    <% @tasks.each do |task| %>
      <div class="task" id="<%= dom_id task %>">
        <tr>
          <%= render 'attributes', task: %>
          <td><%= link_to I18n.t('transition_destination.show'), task %></td>
        </tr>
      </div>
    <% end %>
  </table>
</div>

<%= paginate @tasks %>
