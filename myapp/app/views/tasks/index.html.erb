<%= stylesheet_link_tag params[:controller] %>

<p id="notice"><%= notice %></p>

<h1><%= t('activerecord.models.task') + t('common.index') %></h1>

<table class="tasks">
  <thead>
    <tr>
      <th><%= t('activerecord.attributes.task.title') %></th>
      <th><%= t('activerecord.attributes.task.status') %></th>
      <th><%= t('activerecord.attributes.task.priority') %></th>
      <th><%= t('activerecord.attributes.task.expires_at') %></th>
      <th><%= t('common.edit') %></th>
      <th><%= t('common.destroy') %></th>
    </tr>
  </thead>
  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= link_to task.title, task %></td>
        <td><%= link_to task.status.to_s , task %></td>
        <td><%= link_to task.priority.to_s , task %></td>
        <td><%= link_to task.expires_at.to_s, task %></td>
        <td><%= link_to t('common.edit'), edit_task_path(task) %></td>
        <td><%= link_to t('common.destroy'), task, method: :delete, data: { confirm: I18n.t('pages.tasks.confirm.destroy') } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to t('common.new'), new_task_path %>
