<div class="px-5">
  <h2><%= I18n.t('activerecord.models.task') %> <%= I18n.t('action.list') %></h2>

  <div class='mb-5'>
    <div class="d-flex justify-content-between align-items-center">
      <div><%= link_to I18n.t('action.add'), new_task_path, class:"btn btn-primary" %></div>
      <div>
        <span class="fw-bold me-3"><%= I18n.t('filter.title') %></span>
        <%= form_with url: tasks_path, method: :get, class:"d-inline" do |form| %>
          <span><%= I18n.t(:name, scope: [:activerecord, :attributes, :task]) %></span>
          <%= form.text_field :name, { value: params[:name], class:"form-control d-inline w-auto me-2" } %>
          <span><%= I18n.t(:status, scope: [:activerecord, :attributes, :task]) %></span>
          <%= form.select :status, options_for_select_of_statuses, { include_blank: true, selected: params[:status] }, {class: 'form-select d-inline w-auto me-2'} %>
          <%= form.submit I18n.t('filter.apply'), class:"btn btn-primary me-4" %>
          <span><%= link_to I18n.t('filter.remove'), tasks_path, class:"btn btn-primary" %></span>
        <% end %>
      </div>
    </div>
  </div>

  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <% @task_columns_with_sorting_direction.each do |column| %>
          <th class="text-center">
            <%= link_to I18n.t(column[:name].to_sym, scope: [:activerecord, :attributes, :task]),
                  tasks_path(sort_key: column[:name], sort_direction: column[:sort_direction]) %>
          </th>
        <% end %>
        <th class="text-center"><%= I18n.t('activerecord.models.tag') %></th>
        <th colspan="3"></th>
      </tr>
    </thead>
    <tbody>
      <% @tasks.each do |task| %>
        <tr>
          <th class="text-center"><%= task.id %></th>
          <th class="w-25"><%= task.name %></th>
          <th class="text-center"><span class="<%= badge_class(task.status) %>"><%= I18n.t(task.status, scope: [:activerecord, :enums, :task, :status]) %></span></th>
          <th class="text-center"><%= task.deadline_at&.strftime("%Y/%m/%d %H:%M")  %></th>
          <th>
            <% task.tags.each do |tag| %>
              <span class="badge py-2 fs-6 bg-secondary"><%= tag.name %></span>
            <% end %>
          </th>
          <th class="text-center"><%= link_to I18n.t('action.show'), task_path(task), class:"btn btn-primary" %></th>
          <th class="text-center"><%= link_to I18n.t('action.edit'), edit_task_path(task), class:"btn btn-primary" %></th>
          <th class="text-center"><%= link_to I18n.t('action.delete'), task_path(task), class:"btn btn-danger", data: { turbo_method: :delete, turbo_confirm: I18n.t('confirm') } %></th>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= paginate @tasks, theme: 'bootstrap-5', pagination_class: "flex-wrap justify-content-center"%>

</div>
