<h1>Task List</h1>
<%= flash[:notice] %>
<%= flash[:success] %>
<%= flash[:alert] %>

<%= form_with url: '#', method: :get, local: true do |form| %>
  <%= form.label :sort_by %>
  <%= form.select :sort_by, [['id', 'ID'], ['Create Date', 'CD'], ['Due Date', 'DD']], id: 'selected_sort_by' %>

  <%= form.label :order %>
  <%= form.select :order, ['asc', 'desc'], id: 'selected_order' %>

  <%= form.submit 'Sort' %>

<% end %>

<script>

</script>

<table>
  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><h3><%= task.title %></h3></td>
        <td><%= button_to "Delete", task_path(task), method: :delete, id: task.id %></td>
      </tr>
    <% end %>
  </tbody>
</table>


