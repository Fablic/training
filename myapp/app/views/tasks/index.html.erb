<h1>Task list</h1>

<table>
  <thead>
    <tr>
      <th>id</th>
      <th>name</th>
      <th>deadline_at</th>
    </tr>
  </thead>
  <tbody>
    <% Task.all.each do |t| %>
      <tr>
        <td><%= t.id %></td>
        <td><%= t.name %></td>
        <td><%= t.deadline_at %></td>
      </tr>
    <% end %>
  </tbody>
</table>
