<%= stylesheet_link_tag 'tasks' %>
<%= javascript_pack_tag 'task/task_index' %>

<h1><%= t ".title" %></h1>
<!--flash -->
<% if flash[:notice] %>
  <p class="notice_area"><%= flash[:notice] %><p>
<% end %>

<!--menu -->
<div id = "area_menu">
  <%= link_to t('.btn_add'), new_task_path ,class:"atag_btn"%>
</div>
<!-- search -->
<div id = "search_area">
  <%= form_with url:tasks_path ,model:@search_form ,method: :get,local:true , id:'search_form' do |f|%>
  <div>
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>
  <div>
    <%= f.label :status %>
    <%= f.select :status, Task.statuses_i18n.invert, include_blank:true %>
  </div>
  <%= f.hidden_field :sort %>
  <%= f.hidden_field :order %>
  <%= f.submit t('.btn_search'),class:"atag_btn" %>
  <% end %>
</div>
<%= paginate(@tasks) %>
<!--list -->
<div id="area_list">
  <table class="list_table">
    <thead>
      <tr>
        <th><%= t '.label_id' %></th>
        <th><%= t '.label_name' %></th>
        <th class="sort_link_th" name="status"><%= t('.label_status') %></th>
        <th><%= t '.label_description' %></th>
        <th class="sort_link_th" name="due_date"><%= t('.label_due_date') %></th>
        <th class="sort_link_th" name="created_at"><%= t('.label_created_at') %></th>
        <th><%= t '.label_updated_at' %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @tasks.each do |task| %>
      <tr>
        <td> <%= task.id %></td>
        <td> <%= link_to task.name, edit_task_path(task.id) %></td>
        <td> <%= task.status_i18n %></td>
        <td> <%= task.description %></td>
        <td>
          <% if task.due_date.present? %>
          <%= l task.due_date,format: :yymmdd %>
          <% end %>
        </td>
        <td> <%= l task.created_at %></td>
        <td> <%= l task.updated_at %></td>
        <td>
        <%= link_to t(".btn_del"), task_path(task.id), method: :delete, data: {confirm: t('.msg_del_confirm')}, id: "del_#{task.id}", class: "atag_btn del_button" %>
        </td>
      </tr>
      <% end %>
    </tbody>
  </table>
</div>
