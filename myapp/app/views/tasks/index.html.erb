<h1>Task List</h1>
<%= flash[:notice] %>
<%= flash[:success] %>
<%= flash[:alert] %>
<table>
  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><h3><%= task.title %></h3></td>
        <td><%= button_to "Delete", task_path(task), method: :delete, id: task.id %></td>
      </tr>
    <% end %>
  </tbody>
</table>


