<%= stylesheet_link_tag 'tasks' %>
<%= javascript_pack_tag 'tasks' %>
<!--flash -->
<% if flash[:notice] %>
  <p class="notice_area notice"><%= flash[:notice] %><p>
<% end %>
<!--menu -->
<%= render :partial => "menu" %>
<!-- search -->
<div id = "search_area">
  <%= form_with url:tasks_path ,model:@search_form ,method: :get,local:true , id:'search_form' ,class:'pure-form pure-form-stacked' do |f|%>
    <fieldset>
      <div class="pure-g">
        <div class="pure-u-lg-1-4 pure-u-md-1-4 pure-u-sm-1 pure-u-1-4">
          <%= f.label :name %>
          <%= f.text_field :name  ,class:'pure-u-23-24' %>
        </div>
        <div class="pure-u-lg-1-4 pure-u-md-1-4 pure-u-sm-1 pure-u-1-4">
          <%= f.label :status %>
          <%= f.select :status, Task.statuses_i18n.invert ,{ include_blank: true },{ class:'pure-u-23-24' } %>
        </div>
        <div class="pure-u-lg-1-4 pure-u-md-1-4 pure-u-sm-1 pure-u-1-4">
          <%= f.hidden_field :sort %>
          <%= f.hidden_field :order %>
          <label>　</label>
          <%= f.submit t('.btn_search'),class:"pure-button button-success" %>
        </div>
      </div>
    </fieldset>
  <% end %>
</div>
<div class="pure-g">
  <div class="pure-u-11-12"><%= paginate(@tasks) %></div>
  <div class="pure-u-1-12 page-entries-info"><%= page_entries_info @tasks %></div>
</div>
<!--list -->
<div id="area_list">
  <table class="pure-table task-list-table">
    <thead>
      <tr>
        <th><%= t '.label_id' %></th>
        <th><%= t '.label_name' %></th>
        <th class="sort_link_th" name="status"><%= t('.label_status') %></th>
        <th><%= t '.label_description' %></th>
        <th class="sort_link_th" name="due_date"><%= t('.label_due_date') %></th>
        <th class="sort_link_th" name="created_at"><%= t('.label_created_at') %></th>
        <th><%= t '.label_updated_at' %></th>
        <th></th>
      </tr>
    </thead>
    <tbody class="pure-table-striped">
      <% @tasks.each do |task| %>
      <tr>
        <td> <%= task.id %></td>
        <td> <%= link_to task.name, edit_task_path(task.id) %></td>
        <td> <%= task.status_i18n %></td>
        <td> <%= task.description %></td>
        <td>
          <% if task.due_date.present? %>
          <%= l task.due_date,format: :yymmdd %>
          <% end %>
        </td>
        <td> <%= l task.created_at %></td>
        <td> <%= l task.updated_at %></td>

        <td>
        <%= link_to t(".btn_del"), task_path(task.id), method: :delete, data: {confirm: t('.msg_del_confirm')}, id: "del_#{task.id}", class: "pure-button del_button" %>
        </td>
      </tr>
      <% end %>
    </tbody>
  </table>
</div>
