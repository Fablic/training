<div name='header'>
  <div name='message-area'>
    <%= notice %>
  </div>
  <h1><%= I18n.t('view_title.index') %></h1>
</div>
<div name='content'>
  <div name='create-task'>
      <%= link_to(I18n.t('link.create'), new_task_path) %>
  </div>
  <div name='serch-task'>
  <p>検索</p>
  <%= form_with(url: root_path, local: true, method: :get) do |f| %>
    <p><%= I18n.t('task.title') %>：<%= f.text_field(:title) %></p>
    <p><%= I18n.t('task.label') %>：<%= f.text_field(:label) %></p>
    <p><%= I18n.t('task.status') %>：<%= f.select(:status, Task.statuses.keys.map { |k| [I18n.t("enums.task.status.#{k}"), k] }, include_blank: true) %></p>
    <%= f.submit('検索') %>
  <% end %>
  </div>
  <div name='list-task'>
    <table>
      <thead>
        <tr>
          <th><%= I18n.t('task.title') %></th>
          <th><%= I18n.t('task.label') %></th>
          <th><%= I18n.t('task.status') %></th>
          <th><%= I18n.t('task.created_at') %></th>
          <th></th>
        </tr>
      <thead>
      <tbody>
        <% @tasks.each do |task| %>
          <tr>
            <td><span><%= task.title %></span></td>
            <td>
              <ul>
                <% task.labels.each do |label| %>
                  <li><%= label.name %></li>
                <% end %>
              </ul>
            </td>
            <td><span><%= I18n.t("enums.task.status.#{task.status}") %></span></td>
            <td><span><%= I18n.l(task.created_at) %></span></td>
            <td><%= link_to(I18n.t('link.detail'), task_path(task)) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <div class='pagenation-area'>
      <%= paginate(@tasks) %>
    </div>
  </div>
</div>
<div name='footer'>
  <td><%= button_to(I18n.t('link.logout'), logout_path, method: :delete) %></td>
</div>
