<% content_for :title do %>
<%= t('.title')%>
<% end %>

<div class="search">
    <%= form_tag(tasks_path,:method => 'get') do %>
        <div>
        <%= label_tag(:search_word,t('activerecord.attributes.tasks.title')) %>:
        <%= text_field_tag :search_word, params[:search_word] %>
        </div>
        <div>
        <%= label_tag(:search_status, t('activerecord.attributes.tasks.status')) %>:
        <%= select_tag :search_status, options_for_select({'全て' => 0}.update(Task.statuses), params[:search_status]) %>
        </div>
        <div>
        <% @task_labels.values.each do |tl|%>
        <%= check_box_tag( "search_labels[#{tl.id}]", tl.id, params[:search_labels].present? && params[:search_labels][tl.id.to_s].present?) %>
        <%= label_tag( "search_labels[#{tl.id}]", raw(show_label(tl.id)) ) %>
        <% end %>
        </div>
        <div>
        <%= submit_tag t('.search'), :name => nil %>
        </div>
    <% end %>
</div>

<div class="navi">
    <%= link_to t('.new'), new_task_path %>
</div>

<div class="task-list">
    <% if @tasks.length > 0 %>
    <table>
        <tr>
            <th><%= t('activerecord.attributes.tasks.title') %></th>
            <th><%= t('activerecord.attributes.tasks.status') %></th>
            <th><%= t('activerecord.attributes.tasks.deadline') %></th>
            <th><%= t('activerecord.attributes.tasks.priority') %></th>
            <th><%= t('activerecord.attributes.tasks.label_id') %></th>
            <th><%= t('.operation') %></th>
        </tr>
        <% @tasks.each do |task| %>
        <tr>
            <td><%= link_to task.title, task %></td>
            <td><%= task.status %></td>
            <td><%= task.deadline %></td>
            <td><%= task.priority %></td>
            <td><%= raw(show_labels(task.label_id)) %></td>
            <td>
                <%= link_to t('.edit'), edit_task_path(task) %>
                <%= link_to t('.destroy'), task_path(task), method: :delete, data: { confirm: t('dictionary.message.destroy.confirm') } %>
            </td>
        </tr>
        <% end %>
    </table>
    <%= paginate @tasks %>
    <% else %>
    <p class="alert"><%= t('dictionary.message.no_task') %></p>
    <% end %>
</div>
