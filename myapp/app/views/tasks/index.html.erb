<p id="notice"><%= notice %></p>

<h1>To-Do Tasks</h1>

<table>
  <thead>
    <tr>
      <th>Task Name</th>
      <th>Description</th>
      <th>Priority</th>
      <th>Status</th>
      <th>Due Date</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @tasks.each do |task| %>
        <td><%= link_to task.name, task %></td>
        <td><%= task.description %></td>
        <td><%= task.priority %></td>
        <td><%= task.status %></td>
        <td><%= task.duedate %></td>
        <td><%= link_to 'Edit', edit_task_path(task) %></td>
        <td><%= link_to "Delete", task, method: :delete, data: {confirm: "Do you want to delete #{task.name}?", turbolinks: false} %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<div class="float-right">
  <%= link_to 'New Task', new_task_path %>
</div>

