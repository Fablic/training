<div class="card card-skin">
  <h1>All Tasks</h1>
  <ul>
    <% @tasks.each do | task | %>
      <div><%= link_to task.title, task %></div>
      <div><%= task.description %></div>
      <%= task.expire_at %>
      <p>
        <%= link_to "Edit", edit_task_path(task), { id: "edit-#{task.id}" } %>
        <%= link_to "Delete", task_path(task), { method: :delete, data: { comfirm: "Sure?" }, id: "delete-#{task.id}" } %></br>
      </p>
    <% end %>
  </ul>

  <%= link_to "Create Task", new_task_path, class: 'btn btn-default' %>
  
</div>