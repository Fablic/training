<h1>Tasks</h1>

<table>
  <thead>
    <tr>
      <td>Title</td>
      <td>Description</td>
    </tr>
  </thead>

  <tbody>
    <% @tasks.each do |task| %>
        <tr>
          <td>
          <%= link_to task.title, task_path(task) %>
          </td>
          <td><%= task.description %></td>
        </tr>
    <% end %>
  </tbody>
</table>

<%= link_to 'New Task', new_task_path %>
