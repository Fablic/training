<div class="px-5">
  <h2><%= I18n.t('activerecord.models.task') %> <%= I18n.t('action.list') %></h2>

  <%# TODO: これ全画面にしてもいいかも。今のパスが取れるなら %>
  <div>
    <p><%= link_to "日本語", tasks_path(locale: 'ja') %></p>
    <p><%= link_to "English", tasks_path(locale: 'en') %></p>
  </div>

  <div style='margin-bottom: 40px;'>
    <h3><%= I18n.t('filter.title') %></h3>
    <%= form_with url: tasks_path, method: :get do |form| %>
      <span><%= I18n.t(:name, scope: [:activerecord, :attributes, :task]) %></span>
      <%= form.text_field :name, { value: params[:name] } %>
      <span><%= I18n.t(:status, scope: [:activerecord, :attributes, :task]) %></span>
      <%= form.select :status, options_for_select_of_statuses, { include_blank: true, selected: params[:status] } %>
      <%= form.submit I18n.t('filter.apply') %>
      <p><%= link_to I18n.t('filter.remove'), tasks_path %></p>
    <% end %>
  </div>

  <table>
    <thead>
      <tr>
        <% @task_columns_with_sorting_direction.each do |column| %>
          <th>
            <%= link_to I18n.t(column[:name].to_sym, scope: [:activerecord, :attributes, :task]),
                  tasks_path(sort_key: column[:name], sort_direction: column[:sort_direction]) %>
          </th>
        <% end %>
        <th colspan="3"></th>
      </tr>
    </thead>
    <tbody>
      <% @tasks.each do |task| %>
        <tr>
          <th><%= task.id %></th>
          <th><%= task.name %></th>
          <th><%= I18n.t(task.status, scope: [:activerecord, :enums, :task, :status]) %></th>
          <th><%= task.deadline_at %></th>
          <th><%= task.created_at %></th>
          <th><%= task.updated_at %></th>
          <th><%= link_to I18n.t('action.show'), task_path(task) %></th>
          <th><%= link_to I18n.t('action.edit'), edit_task_path(task) %></th>
          <th><%= link_to I18n.t('action.delete'), task_path(task), data: { turbo_method: :delete } %></th>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= link_to I18n.t('action.add'), new_task_path %>

  <%= paginate @tasks %>

</div>
