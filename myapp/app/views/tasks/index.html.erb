<h1>タスク一覧</h1>
<table>
  <thead>
    <tr>
      <th>タスク名</th>
    </tr>
  </thead>
  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.title %></td>
        <td><%= task.description %></td>
        <td><%= link_to '編集', edit_task_path(task), :class=>"btn btn-light" %></td>
        <td><%= link_to '削除', task_path(task), method: :delete, :class=>"btn btn-danger" %></td>
      </tr>
    <% end %>
    <div>
    <a href="/tasks/new" class="btn btn-primary">新規登録</a>
    </div>
  </tbody>
</table>
