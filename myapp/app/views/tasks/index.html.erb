<p style="color: green"><%= notice %></p>

<h2>検索フォーム</h2>
<%= render "search_form" %>

<h2>タスク一覧</h2>

<%= link_to I18n.t('transition_destination.create'), new_task_path %>

<div id="tasks">
  <table border="1">
    <tr>
      <%= render 'task_header' %>
      <th>詳細</th>
    </tr>

    <% @tasks.each do |task| %>
      <div class="task" id="<%= dom_id task %>">
        <tr>
          <%= render task %>
          <td><%= link_to I18n.t('transition_destination.show'), task %></td>
        </tr>
      </div>
    <% end %>
  </table>
</div>
