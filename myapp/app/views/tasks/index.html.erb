<div class='container', style='text-align:center'> 
  <h1>Task List</h1>
</div>

<%= flash[:notice] %>

<div class='container'>

  <%= form_with url: '#', method: :get, local: true do |form| %>
    <div class='mb-3 w-50'>
      <%= form.label :query_title, 'Search Title:', class: 'form-label' %>
      <%= form.search_field :query_title, maxlength: 20, class: 'form-control' %>
    </div>

    <div class='mb-3 w-50'>
      <%= form.label :query_status, 'Search Status:', class: 'form-label' %>
      <%= form.select :query_status, [['All', ''], ['Pending', 'pending'], ['In Progress', 'in_progress'], ['Completed', 'completed']], {}, { class: 'form-select' } %>
    </div>

    <div class='row justify-content-start'>
      <div class='col-4'>
        <div class='mb-3'>
          <%= form.label :sort_by, class: 'form-label' %>
          <%= form.select :sort_by, [['Create Date', 'created_at'], ['Due Date', 'due']], {}, { class: 'form-select' } %>
        </div>
      </div>

      <div class='col-4'>
        <div class='mb-3'>
          <%= form.label :order, class: 'form-label' %>
          <%= form.select :order, ['Desc', 'Asc'], {}, { class: 'form-select' } %>
        </div>
      </div>
    </div>

    <%= form.submit 'Filter', class: 'btn btn-outline-primary' %>
  <% end %>

  <br>

  <table class='table table-striped table-hover'>
    <thead>
      <tr style="text-align:center">
        <%# <td><h2>Id</h2></td> %>
        <td><h2>Due</h2></td>
        <td><h2>Title</h3></td>
        <td><h2>Status</h3></td>
      </tr>
    </head> 

    <tbody>
      <% @tasks.each do |task| %>
        <tr>
          <%# <td><%= "##{task.id}" %></td>
          <td>
            <h3><%= link_to task.title, task_path(task), class: 'btn link-without-underline' %></h3>
          </td>
          <td><%= l task.due, format: :preview %></td>
          <td><%= status_label(task)%></td>

          <td><%= button_to "Edit", edit_task_path(task), method: :get, id: "Edit#{task.id}", class: 'btn btn-outline-success' %></td>
          <td><%= button_to "Delete", task_path(task), method: :delete, id: "Delete#{task.id}", class: 'btn btn-danger' %></td>
        </tr>
      <% end %>
    </tbody>
  </table>


  <%= paginate @tasks, theme: 'bootstrap-5' %>

</div>
