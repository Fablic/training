<p id="notice"><%= notice %></p>

<h1><%= Task.model_name.human + t('actions.list')%></h1>

<table class="type06" id="task_list">
  <thead>
    <tr>
      <th><%= Task.human_attribute_name(:status) %></th>
      <th><%= Task.human_attribute_name(:name) %></th>
      <th><%= Task.human_attribute_name(:started_at) %></th>
      <th><%= Task.human_attribute_name(:finished_at) %></th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= t("enums.task.status.#{task.status}")  %></td>
        <td><%= task.name %></td>
        <td><%= task.started_at ? l(task.started_at.to_date): ''  %></td>
        <td><%= l(task.finished_at.to_date) %></td>
        <td><%= link_to t('actions.show'), task %></td>
        <td><%= link_to t('actions.edit'), edit_task_path(task) %></td>
        <td><%= link_to t('actions.destroy'), task, method: :delete, data: { confirm: t('messages.delete_confirm') } %></td>

      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to "#{t('actions.new')} #{Task.model_name.human}", new_task_path %>
