<h1><%= t('.title') %></h1>

<div class="search-form">
  <%= form_with(scope: :search, url: root_path, method: :get, local: true) do |f| %>
    <div class="field">
      <%= f.label :task_name_cont, t('tasks.common.task_name') %>
      <%= f.search_field :task_name_cont, value: @search_params[:task_name_cont] %>
    </div>

    <div class="field">
      <%= f.label :status_eq, t('tasks.common.status') %>
      <%= f.select :status_eq, Task.status_lists.keys.to_a, selected: @search_params[:status_eq], include_blank: t('helpers.select.include_blank') %>
    </div>

    <div class="field">
      <%= f.label :label_id_eq, t('tasks.common.label') %>
      <%= f.select :label_id_eq, Label.pluck(:name, :id), selected: @search_params[:label_id_eq], include_blank: t('helpers.select.include_blank') %>
    </div>

    <div class="actions">
      <%= f.submit(t('helpers.submit.search')) %>
    </div>
  <% end %>
</div>

<p><%= link_to t('.move_new_task'), new_task_path, id: 'click_new'  %> </p>

<%= paginate @tasks %>

<table class='table table-list' id='task_list' border=1>
  <thead>
    <tr>
      <th scope="col"><%= sort_order 'id', t('tasks.common.id') %></th>
      <th scope="col"><%= sort_order 'task_name', t('tasks.common.task_name') %></th>
      <th scope="col"><%= sort_order 'status', t('tasks.common.status') %></th>
      <th scope="col"><%= sort_order 'label', t('tasks.common.label') %></th>
      <th scope="col"><%= sort_order 'priority', t('tasks.common.priority') %></th>
      <th scope="col"><%= sort_order 'start_date', t('tasks.common.start_date') %></th>
      <th scope="col"><%= sort_order 'end_date', t('tasks.common.end_date') %></th>
      <th scope="col" colspan="3"></th>
    </tr>
  </thead>
  <tbody>
    <% @tasks.each do |task| %>
    <tr>
      <td><%= task.id %></td>
      <td><%= task.task_name %></td>
      <td><%= task.status %></td>
      <td>
        <% task.labels.each do |label| %>
          <span class="badge bg-light text-dark border"><%= label.name %></span>
        <% end %>
      </td>
      <td><%= task.priority %></td>
      <td>
        <%=
          if task.start_date.present? 
            l task.start_date
          end
        %>
      </td>
      <td>
        <%=
          if task.end_date.present? 
            l task.end_date
          end
        %>
      </td>
      <td><%= link_to t('.move_show_task'), task_path(task), method: :get, id: 'click_show' %></td>
      <td><%= link_to t('.move_edit_task'), edit_task_path(task), id: 'click_edit' %></td>
      <td><%= link_to t('.move_destroy_task'), task_path(task), method: :delete, data: { confirm: t('activerecord.check.messages.confirmation_destory') } , id: 'click_destroy' %></td>
    </tr>      
    <% end %>
  </tbody>
</table>
