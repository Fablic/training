<!DOCTYPE html>
<html>
   <head>
      <meta charset="UTF-8">
      <title>ToDo List</title>
   </head>
   <body>
      <%= link_to '新規登録', new_task_path %>
      <% if @task.present? %>
         <table>
            <tr>
               <th>id</th>
               <th>件名</th>
               <th>内容</th>
            </tr>
            <% @task.each do |t| %>
               <tr>
                  <td><%= t.id %></td>
                  <td><%= t.title %></td>
                  <td><%= t.content %></td>
                  <td><%= link_to '編集', edit_task_path(t.id), class:"btn" %></td>
                  <td><%= link_to '削除', task_path(t.id), class:"btn", method: :delete %></td>
               </tr>
            <% end %>
         </table>
      <% else %>
         <table>
            <tr>
               <th>id</th>
               <th>件名</th>
               <th>内容</th>
            </tr>
            <tr>
               <td>ダミー</td>
               <td>ダミー</td>
               <td>ダミー</td>
            </tr>
         </table>
      <% end %>
   </body>

</html>