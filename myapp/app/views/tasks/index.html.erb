<div name='header'>
  <div name='message-area'>
    <%= notice %>
  </div>
  <h1><%= I18n.t('view_title.index') %></h1>
</div>
<div name='content'>
  <div name='create-task'>
      <%= link_to(I18n.t('link.create'), new_task_path) %>
  </div>
  <div name='serch-task'>
  <span>検索</span>
  <%= form_with(url: root_path, local: true, method: :get) do |f| %>
    <%= f.text_field(:word) %>
    <%= f.select(:status, Task.statuses_i18n.keys.map { |k| [Task.statuses_i18n[k], k] }, include_blank: true) %>
    <%= f.submit('検索') %>
  <% end %>
  </div>
  <div name='list-task'>
    <table>
      <thead>
        <tr>
          <th><%= I18n.t('task.title') %></th>
          <th><%= I18n.t('task.label') %></th>
          <!-- user対応コメントアウト -->
          <!-- <th>担当者</th> -->
          <th><%= I18n.t('task.status') %></th>
          <th><%= I18n.t('task.created_at') %></th>
          <th></th>
        </tr>
      <thead>
      <tbody>
        <% @tasks.each do |task| %>
          <tr>
            <td><span><%= task.title %></span></td>
            <td><span><%= task.label %></span></td>
            <!-- user対応コメントアウト -->
            <!-- <td><span><%#= task.user.name %></span></td> -->
            <td><span><%= task.status_i18n %></span></td>
            <td><span><%= l(task.created_at) %></span></td>
            <td><%= link_to(I18n.t('link.detail'), task_path(task)) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= paginate(@tasks) %>
  </div>
</div>
<div name='footer'>
</div>
