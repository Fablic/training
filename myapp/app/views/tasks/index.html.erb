<p><%= notice %></p>
<h1>Task List</h1>
<%= link_to('Create Task', new_task_path, {class: 'btn_a'}) %>
<br>
<br>
<table>
    <thead>
      <tr>
        <th>title</th>
        <th>label</th>
        <th></th>
        <th></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @tasks.each do |task| %>
        <tr>
          <td><span><%= task.title %></span></td>
          <td><span><%= task.label %></span></td>
          <td><%= link_to('Details', task_path(task), {class: 'btn_a'}) %></td>
          <td><%= link_to('Update', edit_task_path(task), {class: 'btn_a'}) %></td>
          <td><%= link_to('Delete', task_path(task), method: :delete, class: 'btn_a') %></td>
        </tr>
      <% end %>
    </tbody>
</table>
