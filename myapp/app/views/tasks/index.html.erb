<div class="container">
  <div class="row">
    <div class="col-md-2 pt-5 text-center">
      <h2><%= t('.all') %></h2>
      <%= link_to t('.create'), new_task_path, class: 'btn btn-secondary' %>
      <div class="pt-3">
        <%= sort_order('expire_at', t('tasks.form.expire'), @direction, @title, @status) %>
        <%= sort_order("created_at", t('tasks.form.created_at'), @direction, @title, @status) %>
      </div>

      <%= form_with url: search_path, method: :get, local: true, class:"d-flex" do |f| %>
        <div class="form-check">
          <%= f.collection_check_boxes  :labels, Label.all, :name, :name, include_hidden: false do |b| %>
            <%= b.label class: "form-check-label"%>
            <%= b.check_box class:"form-check-input" %>
          <% end %>
          <div>
            <%= f.button type: 'submit', class: "btn btn-primary" do %>
                <i class="fa fa-search"></i>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="col-md-8 offset-md-1 pt-5">
      <div class="row">
        <% @tasks.each do | task | %>
          <div class="col-md-8 border-top border-bottom p-3">
          <a href=<%= task_path(task)%>, class="text-decoration-none text-dark ">
              <h5 class="card-title" ><%= task.title %></h5>
              <p class="card-text text-muted"><%= task.description %></p>
              <div>
                <%= task.status %>
                <% if task.expire_at.present? %>
                  <td><%= parse_date(task.expire_at) %></td>
                <% else %>
                  <td><%= t('tasks.index.no_expire') %></td>
                <% end %>
                <p>
                  <% task.labels.each do |label| %>
                    <span class="badge rounded-pill bg-info">
                      <%= label.name %>
                    </span>
                  <% end %>
                </p>

              </div>
            </a>
          </div>
          <div class="col-md-4 d-flex align-items-center">
            <div class="p-2">
              <%= link_to edit_task_path(task), id: "edit-#{task.id}" do %>
                <i class="fa-solid fa-pen-to-square"></i>
              <% end %>
            </div>
            <div>
              <%= link_to task_path(task), { method: :delete, data: { comfirm: "Sure?" }, id: "delete-#{task.id}", remote: true} do %>
                <i class="fa-solid fa-trash"></i>
              <% end %>
            </div>
          </div>

        <% end %>
      </div>
      <%= paginate @tasks %>
    </div>
  </div>
</div>
