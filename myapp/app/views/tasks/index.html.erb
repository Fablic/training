<h1>Task List</h1>
<%= link_to 'Add new task', new_task_path, class: 'btn btn-primary' %>
<br>
<table class="table">
  <thead>
    <tr>
      <th>Task</th>
      <th>Desc</th>
      <th>Created at</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @tasks.each do |task| %>
    <tr>
      <td><%= link_to task.name, task %></td>
      <td><%= task.description %></td>
      <td><%= task.created_at %></td>
      <td><%= link_to 'Edit', edit_task_path(task) %></td>
    </tr>
    <% end %>
  </tbody>
</table>
