<h1><%= t('.title') %></h1>

<% if flash[:notice] %>
  <p><%= flash[:notice] %></p>
<% end %>
<% if flash[:error] %>
  <p><%= flash[:error] %></p>
<% end %>

<p>
<%= link_to t('.move_new_task'), new_task_path, id: 'click_new'  %> 
</p>

<table class='table table-list' border=1>
  <thead>
    <tr>
      <th><%= t('tasks.common.id') %></th>
      <th><%= t('tasks.common.task_name') %></th>
      <th><%= t('tasks.common.status') %></th>
      <th><%= t('tasks.common.label') %></th>
      <th><%= t('tasks.common.priority') %></th>
      <th><%= t('tasks.common.start_date') %></th>
      <th><%= t('tasks.common.end_date') %></th>
      <th colspan="3"></th>
    </tr>
  </thead>
  <tbody>
    <% @tasks.each do |task| %>
    <tr>
      <td><%= task.id %></td>
      <td><%= task.task_name %></td>
      <td><%= task.status %></td>
      <td><%= task.label %></td>
      <td><%= task.priority %></td>
      <td><%= task.start_date %></td>
      <td><%= task.end_date %></td>
      <td><%= link_to t('.move_show_task'), task_path(task), method: :get, id: 'click_show' %></td>
      <td><%= link_to t('.move_edit_task'), edit_task_path(task), id: 'click_edit' %></td>
      <td><%= link_to t('.move_destroy_task'), task_path(task), method: :delete, data: { confirm: 'Are you sure you want to delete it?
      ' } , id: 'click_destroy' %></td>
    <% end %>
  </tbody>
</table>

