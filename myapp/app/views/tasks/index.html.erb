<h1><%= t '.title' %></h1>
<%= render 'flash' %>

<table>
  <thead>
    <tr>
      <th><%= Task.human_attribute_name :title %></th>
      <th><%= Task.human_attribute_name :description %></th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.title %></td>
        <td><%= task.description %></td>
        <td><%= link_to t('tasks.index.show'), task_path(task.id) %></td>
        <td><%= link_to t('tasks.index.edit'), edit_task_path(task) %></td>
        <td><%= button_to t('tasks.index.delete'), task_path(task.id), method: :delete, form: {data: {confirm: t('tasks.index.delete_confirmation')}} %></td>
      </tr>
    <% end %>
  </tbody>
</table>


<p><%= link_to t('tasks.index.create'), 'tasks/new' %></p>
