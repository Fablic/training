<h1><%= t('page_titles.tasks_index') %></h1>

<% if @tasks.any? %>
  <%= form_tag tasks_path, method: :get do %>
    <%= label_tag :name, "Name" %>
    <%= text_field_tag :name, params[:name] %>
    
    <%= label_tag :status, "Status" %>
    <%= select_tag :status, options_for_select([
      "", 
      t('task.status_options.not_started'), 
      t('task.status_options.in_progress'), 
      t('task.status_options.done')], params[:status]) %>
    
    <%= submit_tag "Search" %>
  <% end %>
  <div class="sort-links">
    <%= link_to 'Sort by Newest', tasks_path(sort_by: 'created_at', sort_order: 'desc') %>
    <%= link_to 'Sort by Oldest', tasks_path(sort_by: 'created_at', sort_order: 'asc') %>
    <%= link_to 'Sort by Due Date (Newest)', tasks_path(sort_by: 'deadline', sort_order: 'desc') %>
    <%= link_to 'Sort by Due Date (Oldest)', tasks_path(sort_by: 'deadline', sort_order: 'asc') %>
  </div>

  <table>
    <thead>
      <tr>
        <th><%= t("task.table_headers.name") %></th>
        <th><%= t("task.table_headers.description") %></th>
        <th><%= t("task.table_headers.priority") %></th>
        <th><%= t("task.table_headers.deadline") %></th>
        <th><%= t("task.table_headers.status") %></th>
        <th><%= t("task.table_headers.labels") %></th>
        <th><%= t("task.table_headers.created_at") %></th>
        <th><%= t("task.table_headers.actions") %></th>
      </tr>
    </thead>
    <tbody>
      <% @tasks.each do |task| %>
        <tr>
          <td><%= task.name %></td>
          <td><%= task.description %></td>
          <td><%= task.priority %></td>
          <td><%= task.deadline %></td>
          <td><%= task.status %></td>
          <td>
            <% task.labels.each do |label| %>
              <%= label.name %>
            <% end %>
          </td>
          <td><%= task.created_at.strftime("%Y-%m-%d %H:%M:%S") %></td>
          <td>
            <%= link_to t('task.show_task_link'), task_path(task) %>
            <%= link_to t('task.edit_task_link'), edit_task_path(task) %>
            <%= link_to t('task.destroy_task_link'), task_path(task), 
              method: :delete,
              data: { confirm: t('task.confirm_delete_task') } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p><%= t('task.no_tasks_found') %> <%= link_to 'Back to home', tasks_path %> </p>
<% end %>

<%= link_to t('task.new_task_link'), new_task_path %>
