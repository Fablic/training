<div class="container">
  <h2><%= t '.all' %></h2>
  <div class="row">
    <div class="col-md-2 text-center">
      <%= link_to t('.create'), new_task_path, class: 'btn btn-secondary' %>
      <div>
        <%= sort_order('expire_at', t('tasks.form.expire'), @direction, @title, @status) %>
        <%= sort_order("created_at", t('tasks.form.created_at'), @direction, @title, @status) %>
      </div>
      
    </div>

    <div class="col-md-8 offset-md-4">
      <div class="row">
        <% @tasks.each do | task | %>
          <div class="col-md-8 border-top border-bottom p-3">
          <a href=<%= task_path(task)%>, class="text-decoration-none text-dark ">
              <h5 class="card-title" ><%= task.title %></h5>
              <p class="card-text text-muted"><%= task.description %></p>
              <div>
                <%= task.status %>
                <% if task.expire_at.present? %>
                  <td><%= parse_date(task.expire_at) %></td>
                <% else %>
                  <td><%= t('tasks.index.no_expire') %></td>
                <% end %>
              </div>
            </a>
          </div>
          <div class="col-md-4 d-flex align-items-center">
            <div class="p-2">
              <%= link_to edit_task_path(task), id: "edit-#{task.id}" do %>
                <i class="fa-solid fa-pen-to-square"></i>
              <% end %>
            </div>
            <div>
              <%= link_to task_path(task), { method: :delete, data: { comfirm: "Sure?" }, id: "delete-#{task.id}" } do %>
                <i class="fa-solid fa-trash"></i>
              <% end %>
            </div>
          </div>

        <% end %>
      </div>
      <%= paginate @tasks %>
    </div>
  </div>
</div>
