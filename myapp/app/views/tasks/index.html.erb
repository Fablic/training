<style>
  .list_table td,
  .list_table th{
    border:1px solid gray;
    padding:10px;
  }
  .list_table th{
    background-color:black;
    color:white;
    min-width:100px;
  }
  .notice_area{
    background:yellow;
  }

</style>
<h1><%= t ".title" %></h1>
<!--flash -->
<% if flash[:notice] %>
  <p class="notice_area"><%= flash[:notice] %><p>
<% end %>

<!--menu -->
<div id = "area_menu">
  <%= link_to t('.btn_add'), new_task_path %>
</div>

<!--list -->
<div id="area_list">
  <table class="list_table">
    <thead>
      <tr>
      <th><%= t '.label_name' %></th>
      <th><%= t '.label_description' %></th>
      <th><%= t '.label_created_at' %></th>
      <th><%= t '.label_updated_at' %></th>
      <th></th>
      </tr>
    </thead>
    <tbody>
      <% @tasks.each do |task| %>
      <tr>
        <td><%= link_to task.name, edit_task_path(task.id) %></td>
        <td> <%= task.description %></td>
        <td> <%= l task.created_at %></td>
        <td> <%= l task.updated_at %></td>
        <td> 
        <%= link_to t(".btn_del"), task_path(task.id), method: :delete, data: {confirm: t('.msg_del_confirm')}, id: "del_#{task.id}", class: "del_button" %>
        </td>
      </tr>
      <% end %>
    </tbody>
  </table>
</div>
