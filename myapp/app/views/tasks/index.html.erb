<h1>タスク一覧</h1>

<% if flash[:notice] %>
  <p>
    <%= flash[:notice] %>
  </p>
<% end %>

<table>
  <thead>
    <tr>
      <th scope="col">タスク</th>
      <th scope="col">説明</th>
      <th scope="col">編集</th>
      <th scope="col">削除</th>
    </tr>
  </thead>
  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td>
          <%= link_to task.title, task_path(task), id: '詳細リンク' %>
        </td>
        <td>
          <%= task.description %>
        </td>
        <td>
          <%= link_to '編集', edit_task_path(task) %>
        </td>
        <td>
          <%= link_to '削除', task_path(task), method: :delete,  data: {confirm: "削除しますか？"} %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
  <%= link_to '新規登録', new_task_path %>
