<h1>タスク一覧</h1>
<h2>終了期限並び替え</h2>
<div>
<%= search_form_for @q, url: root_path do |f| %>
  <%= f.select(:sorts, {
    '': 'created_at desc',
    '終了期限早い': 'deadline asc',
    '終了期限遅い': 'deadline desc'
    }, { selected: params[:q][:sorts] }, { onchange: 'this.form.submit()'}) %>

</div>
<h2>検索</h2>
<div>
  <%= f.label :title %>
  <%= f.search_field :title_cont %>
</div>
<div>
  <%= f.label :status %>
　<%= f.radio_button :status_eq, '' %>指定なし

  <%= f.radio_button :status_eq, Task.statuses[:not_started] %>
  <%= I18n.t('activerecord.attributes.task.statuses.not_started') %>
  <%= f.radio_button :status_eq, Task.statuses[:in_progress] %>
  <%= I18n.t('activerecord.attributes.task.statuses.in_progress') %>
  <%= f.radio_button :status_eq, Task.statuses[:completed] %>
  <%= I18n.t('activerecord.attributes.task.statuses.completed') %>

</div>
<%= f.submit "検索" %>
<% end %>

<h2>タスク</h2>
<table class="task_list">
  <thead>
    <tr>
      <th scope="col">#</th>
      <th scope="col">ステータス</th>
      <th scope="col">件名</th>
      <th scope="col">終了期限</th>
      <th scope="col">作成日</th>
    </tr>
  </thead>
  <tbody>
<% @tasks.each do |task| %>
    <tr>
      <th scope="row"><%= task.id %></th>
      <td><%= I18n.t("activerecord.attributes.task.statuses.#{task.status}") %></td>
      <td><%= link_to task.title, task %></td>
      <td class="deadline"><%= I18n.l(task.deadline, format: :short, default: '') %></td>
      <td class="created"><%= I18n.l(task.created_at, format: :short) %></td>
    </tr>
<% end %>
  </tbody>
</table>
<%= paginate @tasks %>

<p><%= link_to '新規作成', new_task_path %></p>
