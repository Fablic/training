<% #共通メニュー  %>
<div class="pure-menu pure-menu-horizontal head-menu">
  <ul class="pure-menu-list">
    <li class="pure-menu-item menu-app-name">Task List</li>
    <% @menus.each do |menu| %>
      <li class="pure-menu-item <%= "pure-menu-selected" if current_page?(menu.path) %>">
        <% if current_page?(menu.path) %>
          <span class="pure-menu-link"><%= menu.label %></span>
        <% else %>
          <%= link_to menu.label, menu.path ,class:"pure-menu-link" %>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
