<div class="p-5 mb-3">
  <form>
    <div class="form-row">
      <%= search_form_for @search, url: root_path do |form| %>
      <div class="col mb-3">
        <%= form.label :title_cont, t('tasks.title') %>
        <%= form.search_field :title_cont , { class: 'form-control' }%>
      </div>

      <div class="col mb-3">
        <%= form.label :status, t('tasks.status') %>
        <%= form.select :status_eq, content_tag(:option, 'Select status', value: "") + 
              options_for_select(Task.statuses.map { |key, v| [t("activerecord.attributes.task.status.#{key}"), v] }, @search.status_eq),
              {},
              { class: 'form-control' } %>
      </div>
    </div>
    <div class="d-flex justify-content-center">
      <%= form.submit t('tasks.search'), class: 'btn btn-secondary' %>
    </div>
    <% end %>
  </form>
</div>
