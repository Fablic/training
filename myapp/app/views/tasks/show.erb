<section id="show-task-ticket">
<p><%= @task.id %></p>
<p><%= @task.title %></p>
<p><%= @task.body %></p>
<p><%= @task.status %></p>
<p><%= @task.urgency %></p>
<p><%= @task.importance %></p>
<p><%= @task.priority_point %></p>
<p><%= @task.deadline.strftime("%Y-%m-%e") %></p>
<p><%= button_to '編集', "/tasks/#{@task.id}/edit", method: :get  %></p>
<p><%= button_to '削除', "/tasks/#{@task.id}", method: :delete %></p>
</section>
