<div class='mt-5 mb-5 container', style='text-align:center'>
  <h1><%= t('views.titles.edit_task') %></h1>
</div>

<%= render 'log_out' %>

<div class='container'>
  <button class='mb-4 btn btn-outline-secondary'>
    <%= link_to t('views.buttons.back_to_home'), tasks_path, method: :get , class: 'link-without-underline link-secondary' %>
  </button>

  <%= form_with(model: @task, local: true, data: {turbo: false}) do |form| %>

    <%= render partial: 'common_components/error_display', locals: { model: @task } %>

    <div class='mb-3 w-75'>
      <%= form.label :title, class: 'form-label' %>
      <%= form.text_field :title, class: 'form-control' %>   
    </div>

    <div class='mb-3 w-75'>
      <%= form.label :description, class: 'form-label' %>
      <%= form.text_area :description, class: 'form-control' %>
    </div>

    <div class='mb-3 w-75'>
      <%= form.label :due, class: 'form-label' %>
      <%= form.datetime_local_field :due, class: 'form-control' %>
    </div>

    <div class='mb-3'>
      <%= form.label :status, t('views.labels.select_status'), class: 'form-label' %>

      <div class='form-check'>
        <%= form.radio_button :status, 'pending' %>
        <%= form.label :status_pending, t('views.selects.status_pending'), class: 'form-label' %>
      </div>

      <div class='form-check'>
        <%= form.radio_button :status, 'in_progress' %>
        <%= form.label :status_in_progress, t('views.selects.status_in_progress'), class: 'form-label' %>
      </div>

      <div class='form-check'>
        <%= form.radio_button :status, 'completed' %>
        <%= form.label :status_completed, t('views.selects.status_completed'), class: 'form-label' %>
      </div>

      <div class='mb-3 w-75'>
        <%= form.label :label, t('views.labels.select_labels'), class: 'form-label' %>
        <%= form.collection_select :label_ids, Label.all, :id, :label_name, {}, { multiple: true, class: 'form-select' } %>
      </div>
    </div>

    <p>
      <%= form.submit t('views.buttons.update'), class: 'btn btn-success' %>
    </p>
  <% end %>
</div>
