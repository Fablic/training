<section class="task-new">
    <div class="create-task-form">
        <%= form_for(@task, url: task_path, method: :put) do |f| %>
            <%= render :partial => "form", :locals => {:f => f}  %>
            <%= f.submit t(".submit"), data: { confirm: t(".confirm")} %>
        <% end %>
    </div>
</section>

