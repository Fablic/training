<div class='mt-5 mb-5 container', style='text-align:center'>
  <h1>Edit the task</h1>
</div>

<%= render 'log_out' %>

<div class='container'>
  <%= form_with(model: @task, local: true, data: {turbo: false}) do |form| %>
    <button class='mb-4 btn btn-outline-secondary'>
      <%= link_to 'Back to home', tasks_path, method: :get , class: 'link-without-underline link-secondary' %>
    </button>

    <%= render partial: 'common_components/error_display', locals: { model: @task } %>

    <div class='mb-3 w-75'>
      <%= form.label :title, class: 'form-label' %>
      <%= form.text_field :title, class: 'form-control' %>   
    </div>

    <div class='mb-3 w-75'>
      <%= form.label :description, class: 'form-label' %>
      <%= form.text_area :description, class: 'form-control' %>
    </div>

    <div class='mb-3 w-75'>
      <%= form.label :due, class: 'form-label' %>
      <%= form.datetime_local_field :due, class: 'form-control' %>
    </div>

    <div class='mb-3'>
      <%= form.label :status, 'Select Status:', class: 'form-label' %>

      <div class='form-check'>
        <%= form.radio_button :status, 'pending' %>
        <%= form.label :status_pending, 'Pending', class: 'form-label' %>
      </div>

      <div class='form-check'>
        <%= form.radio_button :status, 'in_progress' %>
        <%= form.label :status_in_progress, 'In Progress', class: 'form-label' %>
      </div>

      <div class='form-check'>
        <%= form.radio_button :status, 'completed' %>
        <%= form.label :status_completed, 'Completed', class: 'form-label' %>
      </div>
    </div>

    <p>
      <%= form.submit 'Update', class: 'btn btn-success' %>
    </p>
  <% end %>
</div>
