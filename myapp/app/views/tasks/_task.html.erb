<div id='<%= dom_id task %>'>
  <p>
    <strong>タスク名:</strong>
    <%= task.name %>
  </p>

  <p>
    <strong>詳細:</strong>
    <%= task.description %>
  </p>

  <p>
    <strong>登録日時:</strong>
    <%= task.created_at %>
  </p>

  <p>
    <strong>更新日時:</strong>
    <%= task.updated_at %>
  </p>

</div> 