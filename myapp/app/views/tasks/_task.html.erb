<div class="task">
  <%= link_to task.name, task_path(task) %>
  <div class="task__actions">
    <%= button_to t('pages.task_list_page.delete_task'),
                  task_path(task),
                  method: :delete,
                  class: "btn btn-danger" %>
    <%= link_to t('pages.task_list_page.edit_task'),
                edit_task_path(task),
                class: "btn btn-info" %>
  </div>
</div>
