<%= form_with(model: task,  local: true) do |f| %>
  <tr >
    <td><%= task.id %></td>
    <td><%= link_to task.title, task %></td>
    <td><%= translate_priority task.priority %></td>
    <td><%= translate_status task.status %></td>
    <td><%= l task.due_date %></td>
    <td class='created_at'><%= l task.created_at %></td>
  </tr>
<% end %>
