<% if model.errors.any? %>
  <div class='mb-4 border border-danger rounded d-flex justify-content-center'>
    <div class='container'>
      <p>You have some invalid inputs!</p>
      <ul>
        <% model.errors.full_messages.each do |error| %>
        <li><%= error %></li>
        <% end %>
      </ul>
    </div>
  </div>
<% end %>
