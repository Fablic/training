<%= t '.title' %>
<p><%= t '.name' %></p>
<%=@task.title %><br>
<p><%= t '.body' %></p>
<%=@task.body %><br>
<p><%= t '.finish' %></p>
<%=@task.finish_at %><br>
<p><%= t '.status' %></p>
<%= form_with(model: @task, url: task_schedule_path(@task), local: true, class: "form-row") do |f| %>
  <%= f.select :status, Task.statuses_i18n.invert, {prompt: false},
    {class:"form-control form-control-sm col-6", onchange: "this.form.submit();"} %>
<% end %>
<%= link_to t('.index'), :back %>
