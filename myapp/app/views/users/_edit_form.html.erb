<%= simple_form_for user, html: { class: "user form" } do |f| %>
  <% if user.errors.any? %>
    <div class="error-message">
      <%= user.errors.full_messages.to_sentence.capitalize %>
    </div>
  <% end %>

  <%= f.input :name, input_html: { autofocus: true } %>
  <% unless current_user?(user) %>
    <%= f.input :role, collection: User.enums_i18n(:role).keys, selected: f.object.role || 0 %>
  <% end %>
  <%= f.input :description %>
  <%= f.submit class: "btn btn-primary" %>
<% end %>
