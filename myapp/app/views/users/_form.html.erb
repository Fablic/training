<%= form_with(model: user, local: true) do |form| %>
  <% if user.errors.any? %>
    <div id="error_explanation">
      <ul>
        <% user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label User.human_attribute_name(:name) %>
    <%= form.text_field :name %>
  </div>


  <div class="field">
    <%= form.label User.human_attribute_name(:username)  %>
    <%= form.text_field :username %>
  </div>


  <div class="field">
    <%= form.label User.human_attribute_name(:password)  %>
    <%= form.password_field :password %>
  </div>
<div class="field">
    <%= form.label User.human_attribute_name(:password_confirmation)  %>
    <%= form.password_field :password_confirmation %>
  </div>
 

    <div class="field">
    <%= form.label User.human_attribute_name(:admin)  %>
    <%= form.check_box :admin %>
  </div>

  <div class="actions">
    <%= form.submit %>
  </div>
<% end %>
