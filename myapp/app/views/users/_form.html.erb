<div class="row mb-4">
  <%= form_with(model: user, local: true, class: 'col-4') do |form| %>
    <div class="form-group mb-4">
      <%= form.label :name %>
      <%= form.text_field :name, class: 'form-control' %>
      <% user.errors.full_messages_for(:name).each do |message| %>
        <div class="alert alert-danger mt-2"><%= message %></div>
      <% end %>
    </div>

    <div class="form-group mb-4">
      <%= form.label :email %>
      <%= form.email_field :email, class: 'form-control' %>
      <% user.errors.full_messages_for(:email).each do |message| %>
        <div class="alert alert-danger mt-2"><%= message %></div>
      <% end %>
    </div>

    <div class="form-group mb-4">
      <%= form.label :password %>
      <%= form.password_field :password, class: 'form-control' %>
      <% user.errors.full_messages_for(:password).each do |message| %>
        <div class="alert alert-danger mt-2"><%= message %></div>
      <% end %>
    </div>

    <div class="form-group mb-4">
      <%= form.label :password_confirmation %>
      <%= form.password_field :password_confirmation, class: 'form-control' %>
      <% user.errors.full_messages_for(:password_confirmation).each do |message| %>
        <div class="alert alert-danger mt-2"><%= message %></div>
      <% end %>
    </div>

    <div class="form-row mx-0 mb-3">
      <%= form.label :role, class: 'col-4' %>
      <%= form.select :role, I18n.t('enums.user.role').invert, {}, class: 'form-control col-8' %>
    </div>

    <div class="form-group mb-4">
      <%= form.submit class: 'btn btn-primary' %>
    </div>
  <% end %>
</div>
