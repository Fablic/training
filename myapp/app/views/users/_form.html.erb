<% if @user.errors.any? %>
  <div>
    <ul>
      <% @user.errors.each do |error| %>
        <li class="text-danger fw-bold"><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
<div class="mb-3">
  <%= form.label :username, class: "form-label", disabled: !@edit_mode %>
  <%= form.text_field :username, class: "form-control", readonly: !@edit_mode %>
</div>
<div class="mb-3">
  <%= form.label :password, class: "form-label", disabled: !@edit_mode %>
  <%= form.password_field :password, class: "form-control", readonly: !@edit_mode %>
</div>
<div class="mb-3">
  <%= form.label :role, class: "form-label" %>
  <div class="btn-group d-flex"  role="group" aria-label="Basic radio toggle button group">
    <% User.roles.keys.each do |role| %>
      <%= form.radio_button :role, role, id: %(role_#{role}), class: "btn-check", autocomplete: "off",disabled: !@edit_mode %>
      <%= form.label t(%(activerecord.attributes.user.roles.#{role})) , class: "btn btn-outline-primary", for: %(role_#{role})%>
    <% end %>
  </div>
</div>
