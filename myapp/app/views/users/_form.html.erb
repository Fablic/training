<% if user.errors.any? %>
  <div class = "alert">
    <ul>
      <% user.errors.full_messages.each do |message| %>
      <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with(model: user, local: true) do |f| %>
  <div class="form-group">
    <%= f.label :name, t('users.common.name')  %>
    <%= f.text_field :name, class: 'form-control' %>
  </div>

  <div class="form-group">
    <%= f.label :login_id, t('users.common.id')  %>
    <%= f.text_field :login_id, class: 'form-control' %>
  </div>

  <div class="form-group">
    <%= f.label :password, t('users.common.password')  %>
    <%= f.text_field :password, class: 'form-control' %>
  </div>
 
  <div class="form-group">
    <%= f.label :password_confirmation, t('users.common.password_confirmation') %>
    <%= f.password_field :password_confirmation, class: 'form-control' %>
  </div>
 
  <div class="field">
    <%= f.label :is_admin, t('users.common.is_admin') %>
    <%= f.check_box :is_admin %>
  </div>

  <div class="actions">
    <%= f.submit %>
  </div>
<% end %>
