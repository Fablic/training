<%= form_with model: @user do |form| %>
  <%= render partial: "shared/error_messages", locals: { model: @user } %>

  <div class="w-50">
    <div class="d-flex mb-4">
      <p class="w-25"><%= I18n.t(:name, scope: [:activerecord, :attributes, :user]) %></p>
      <%= form.text_field :name, class:"form-control w-75" %>
    </div>
    <div class="d-flex mb-4">
      <p class="w-25"><%= I18n.t(:email, scope: [:activerecord, :attributes, :user]) %></p>
      <%= form.text_field :email, class:"form-control w-75" %>
    </div>
    <div class="d-flex mb-4">
      <p class="w-25"><%= I18n.t(:password, scope: [:activerecord, :attributes, :user]) %></p>
      <%= form.password_field :password, class:"form-control w-75" %>
    </div>
    <div class="d-flex mb-4">
      <p class="w-25"><%= I18n.t(:password_confirmation, scope: [:activerecord, :attributes, :user]) %></p>
      <%= form.password_field :password_confirmation, class:"form-control w-75" %>
    </div>

    <%# 自分を管理者から外すことはできない仕様 %>
    <% if @user.id != @current_user.id %>
      <div class="d-flex mb-4">
        <p class="w-25"><%= I18n.t(:is_admin, scope: [:activerecord, :attributes, :user]) %></p>
        <%= form.check_box :is_admin, class:"form-check-input", style:"width: 30px; height: 30px;" %>
      </div>
    <% end %>

    <%= link_to I18n.t('action.back'), :back, class:"btn btn-primary"  %>
    <%= form.submit nil, class:"btn btn-primary me-4" %>
  </div>
<% end %>
