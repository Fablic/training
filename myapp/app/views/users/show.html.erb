<h1><%= t('.title') %></h1>

<h2><%= User.human_attribute_name(:name) %>: <%= @user.name %></h2>
<p><%= User.human_attribute_name(:email) %>: <%= @user.email %></p>
<h2><%= t('.task_list') %></h2>

<table class='table'>
  <thead>
    <tr>
      <th><%= Task.human_attribute_name(:title) %></th>
      <th><%= Task.human_attribute_name(:description) %></th>
      <th><%= Task.human_attribute_name(:created_at) %></th>
    </tr>
  </thead>

  <tbody>
    <% @user.tasks.each do |task| %>
      <tr>
        <td><%= task.title %></td>
        <td><%= task.description %></td>
        <td><%= task.created_at.strftime("%Y-%m-%d %H:%M:%S") %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<p><%= link_to t('users.index.title'), users_path, class: 'btn btn-info' %></p>
