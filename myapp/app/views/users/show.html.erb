<div class="d-flex justify-content-between align-items-center">
  <h1><%= t('views.users.show.title') %></h1>
  <%= button_to t('views.common.delete'), user_path(@user), method: :delete, form: { data: { turbo_confirm: t('views.common.confirm') }}, class: "btn btn-danger ml-auto" %>
</div>
<%= form_with model: @user, local: true do |form| %>
  <%= render "form", form: form %>
<% end %>
<div class="d-flex justify-content-between">
  <%= link_to t('views.common.cancel'), users_path, class: "btn btn-secondary" %>
  <%= link_to t('views.common.edit'), edit_user_path(@user), class: "btn btn-primary" %>
</div>
