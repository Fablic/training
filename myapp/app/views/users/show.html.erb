
<div class="section container">

<h1 class="title has-text-primary">
  <%=t('actions.show') + User.model_name.human() %>
</h1>
<div class='box'>
<%= link_to t('actions.back'), users_path, class:"delete is-large is-pulled-right" %>

<p>
  <strong><%= Task.human_attribute_name(:name) %></strong>
  <%= @user.name %>
</p>

<p>
  <strong><%= Task.human_attribute_name(:username) %></strong>
  <%= @user.username %>
</p>


<p>
  <strong><%= Task.human_attribute_name(:admin) %></strong>
  <%= @user.admin %>
</p>
<%= link_to t('actions.edit'), edit_user_path(@user) , class: "button is-link" %>


</div>
</div>