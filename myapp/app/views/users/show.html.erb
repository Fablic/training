<nav class="user_navbar navbar navbar-expand-lg">
  <div class="container-fluid">
    <h1 class="user_navbar__title">
      <%= t('pages.user_detail_page.title') %>
    </h1>
    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0"></ul>
      <div class="user_navbar__log_out_btn">
        <%= button_to t('pages.navbar.logout'), '/logout',
                      method: :delete,
                      class: 'nav-link active' %>
      </div>
    </div>
  </div>
</nav>
<main class="container">
  <%= link_to sanitize("&larr; #{t('back')}"), users_path %>
  <div class="header"></div>
  <%= flash.now[:success] %>
  <div>
    <div class="row user_details__item_row">
      <div class="col-8">
        <h2 class="user_details__user_name">
          <%= @user.name %>
        </h2>
      </div>
      <div class="col-4">
        <%= link_to t('pages.user_list_page.edit_user'),
                    edit_user_path(@user),
                    class: "btn btn-warning btn-lg" %>
      </div>
    </div>
    <div class="row user_details__item_row">
      <div class="col-4">
        <h3>
          <%= t('attributes.model.user.role') %>
          <span class="badge bg-primary">
            <%= @user.enum_i18n(:role) %>
          </span>
        </h3>
      </div>
    </div>
    <div class="row user_details__item_row">
      <h3>
        <%= t('attributes.model.user.description') %>
      </h3>
    </div>
    <div class="row user_details__item_row">
      <div class="col-8">
        <div class="card">
          <div class="card-body user_details__description_wrapper">
            <%= @user.description %>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="row user_details__item_row">
    <h3>
      <%= t('pages.task_list_page.title') %>
    </h3>
  </div>
  <div class="row user_details__item_row">
    <div class="col-8">
      <table class="table table-striped table-hover align-middle">
        <thead>
        <tr>
          <th scope="col">Task name</th>
          <th scope="col">Priority</th>
          <th scope="col">Status</th>
          <th scope="col">Expired date</th>
          <th scope="col">Description</th>
        </tr>
        </thead>
        <tbody>
        <%= render partial: "task_table", collection: @tasks, as: :task %>
        </tbody>
      </table>
      <%= paginate @tasks %>
    </div>
  </div>

</main>
