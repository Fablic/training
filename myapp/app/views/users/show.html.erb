<div class="px-5">
  <h2><%= I18n.t('activerecord.models.user') %> <%= I18n.t('action.show') %></h2>

  <table class="table">
    <tbody>
      <tr>
        <th class="w-25"><%= I18n.t(:id, scope: [:activerecord, :attributes, :user]) %></th>
        <td class="w-75"><%= @user.id %></td>
      </tr>
      <tr>
        <th class="w-25"><%= I18n.t(:name, scope: [:activerecord, :attributes, :user]) %></th>
        <td class="w-75"><%= @user.name %></td>
      </tr>
      <tr>
        <th class="w-25"><%= I18n.t(:email, scope: [:activerecord, :attributes, :user]) %></th>
        <td class="w-75"><%= @user.email %></td>
      </tr>
      <tr>
        <th class="w-25"><%= I18n.t(:is_admin, scope: [:activerecord, :attributes, :user]) %></th>
        <td class="w-75"><%= @user.is_admin %></td>
      </tr>
      <tr>
        <th class="w-25"><%= I18n.t(:created_at, scope: [:activerecord, :attributes, :user]) %></th>
        <td class="w-75"><%= @user.created_at %></td>
      </tr>
      <tr>
        <th class="w-25"><%= I18n.t(:updated_at, scope: [:activerecord, :attributes, :user]) %></th>
        <td class="w-75"><%= @user.updated_at %></td>
      </tr>
    </tbody>
  </table>

  <%= link_to I18n.t('action.list'), users_path, class:"btn btn-primary" %>
  <%= link_to I18n.t('action.edit'), edit_user_path(@user), class:"btn btn-primary" %>

  <h4 class="mt-5"><%= @user.name %> <%= I18n.t('activerecord.models.task') %> <%= I18n.t('action.list') %></h4>
  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th class="text-center"><%= I18n.t(:id, scope: [:activerecord, :attributes, :task]) %></th>
        <th class="text-center"><%= I18n.t(:name, scope: [:activerecord, :attributes, :task]) %></th>
        <th class="text-center"><%= I18n.t(:deadline_at, scope: [:activerecord, :attributes, :task]) %></th>
        <th class="text-center"><%= I18n.t(:created_at, scope: [:activerecord, :attributes, :task]) %></th>
        <th class="text-center"><%= I18n.t(:updated_at, scope: [:activerecord, :attributes, :task]) %></th>
      </tr>
    </thead>
    <tbody>
      <% @tasks.each do |task| %>
        <tr>
          <th class="text-center"><%= task.id %></th>
          <th class="w-25"><%= task.name %></th>
          <th class="text-center"><span class="<%= badge_class(task.status) %>"><%= I18n.t(task.status, scope: [:activerecord, :enums, :task, :status]) %></span></th>
          <th class="text-center"><%= task.deadline_at&.strftime("%Y/%m/%d %H:%M")  %></th>
          <th class="text-center"><%= task.created_at.strftime("%Y/%m/%d %H:%M")  %></th>
          <th class="text-center"><%= task.updated_at.strftime("%Y/%m/%d %H:%M")  %></th>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
