<div class='mt-5 mb-5 container', style='text-align:center'>
  <h1>User Tasks</h1>
</div>

<div class='container'>
  <button class='mb-4 btn btn-outline-secondary'>
    <%= link_to 'Back to admin page', admin_path, method: :get , class: 'link-without-underline link-secondary' %>
  </button>

  <table class='table table-striped table-hover'>
    <thead>
      <tr style="text-align:center">
        <td><h2>Title</h3></td>
        <td><h2>Due</h2></td>
        <td><h2>Status</h3></td>
      </tr>
    </head> 

    <tbody>
      <% @tasks.each do |task| %>
        <tr style="text-align:center">
          <td>
            <h3><%= link_to task.title, task_path(task), class: 'btn link-without-underline' %></h3>
          </td>
          <td><%= l task.due, format: :preview %></td>
          <td><%= status_label(task)%></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
</div>
