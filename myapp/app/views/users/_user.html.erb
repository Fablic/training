<tr class="user">
  <th scope="row" class="user_list__user_row">
    <%= link_to user.name, user_path(user), class: "user_list__user_name" %>
  </th>
  <td>
    <%= user.enum_i18n(:role) %>
  </td>
  <td>
    <%= Task.get_own_tasks(user).count %>
  </td>
  <td>
    <div class="user__actions">
      <%= link_to t('pages.user_list_page.edit_user'),
                  edit_user_path(user),
                  class: "btn btn-outline-info" %>
    </div>
    <% unless current_user?(user) %>
      <div class="user__actions">
        <%= button_to t('pages.user_list_page.delete_user'),
                      user_path(user),
                      method: :delete,
                      class: "btn btn-outline-danger" %>
      </div>
    <% end %>

  </td>
</tr>
