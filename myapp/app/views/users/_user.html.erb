<div class="container-sm rounded-2" style="padding:10px;">
  <% if @user.tasks.present? %>
    <h1><%= I18n.t('users.show.title_with_tasks', user_name: @user.name) =%></h1>
    <hr>
      <div id="tasks" class="container-sm border rounded-2" style="padding:10px;">
        <table class="table">
          <tr>
            <th></th>
            <th><%= I18n.t('activerecord.attributes.task.title') %></th>
            <th><%= I18n.t('activerecord.attributes.task.priority') %></th>
            <th><%= I18n.t('activerecord.attributes.task.status') %></th>
            <th><%= I18n.t('activerecord.attributes.task.expires_at') %></th>
            <th><%= I18n.t('activerecord.attributes.user.name') %></th>
          </tr>
            <% @user.tasks.each do |task| %>
          <tr>
            <td>
              <%= link_to "edit", edit_task_path(task), class: "btn btn-secondary" %>
            </td>
            <td>
              <%= link_to task.title, task %>
            </td>
            <td>
              <%= Task.priorities_i18n[task.priority] %>
            </td>
            <td>
              <%= Task.statuses_i18n[task.status] %>
            </td>
            <td>
              <%= task.expires_at ? task.expires_at.strftime("%Y/%m/%d") : '' %>
            </td>
            <td>
              <%= task.user&.name %>
            </td>
          </tr>
        <% end %>
      </table>
    </div>
  <% else %>
    <h1><%= I18n.t('users.show.title_without_task', user_name: @user.name) =%></h1>
    <hr>
  <% end %>
</div>
