<p id="notice"><%= notice %></p>

<h1><%= User.model_name.human + t('actions.list')%></h1>

<table class="type06">
  <thead>
    <tr>
      <th><%= link_to User.human_attribute_name(:name), {sort: :name, direction: get_sort_direction(:name)}%> </th>
      <th><%= link_to User.human_attribute_name(:username), {sort: :username, direction: get_sort_direction(:username)}%></th>
      <th><%= link_to User.human_attribute_name(:admin), {sort: :admin, direction: get_sort_direction(:admin)}%></th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.name %></td>
        <td><%= user.username %></td>
        <td><%= user.admin %></td>
        <td><%= link_to t('actions.show'), user %></td>
        <td><%= link_to t('actions.edit'), edit_user_path(user) %></td>
        <td><%= link_to t('actions.destroy'), user, method: :delete, data: { confirm: t('messages.delete_confirm') } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%= link_to "#{t('actions.new')} #{User.model_name.human}", new_user_path %>
