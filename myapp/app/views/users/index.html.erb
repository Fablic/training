<div class="d-flex justify-content-between align-items-center">
  <h1><%= t('views.users.index.title') %></h1>
</div>
<div class="container mt-2 mb-2">
  <% if @users.any? %>
    <table class="table table-striped table-hover">
      <thead class="thead-light">
        <tr>
          <th><%= t('helpers.label.user.username') %></th>
          <th><%= t('helpers.label.user.role') %></th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td class="text-truncate" style="max-width: 200px;"><%= link_to user.username, user_path(user) %></td>
            <td><%= t(%(activerecord.attributes.user.roles.#{user.role})) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-center"><%= t('views.users.index.no_users') %></p>
  <% end %>
  <div class="d-flex justify-content-end">
    <%= link_to t('views.common.add'), new_user_path, class: "btn btn-primary" %>
  </div>
</div>
