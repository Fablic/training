<h1><%= t('.title') %></h1>

<table>
  <thead>
    <tr>
      <th><%= User.human_attribute_name :name %></th>
      <th><%= User.human_attribute_name :email %></th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.name %></td>
        <td><%= user.email %></td>
        <td><%= link_to t('users.index.show'), user_path(user.id) %></td>
        <td><%= link_to t('users.index.edit'), edit_user_path(user) %></td>
        <td><%= button_to t('users.index.delete'), user_path(user.id), method: :delete, form: {data: {confirm: t('users.index.delete_confirmation')}} %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<p><%= link_to t('users.index.create'), new_user_path %></p>
