<div class="px-5">
  <h2><%= I18n.t('activerecord.models.user') %> <%= I18n.t('action.list') %></h2>

  <div><%= link_to I18n.t('action.add'), new_user_path, class:"btn btn-primary" %></div>

  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th class="text-center"><%= I18n.t(:id, scope: [:activerecord, :attributes, :user]) %></th>
        <th class="text-center"><%= I18n.t(:name, scope: [:activerecord, :attributes, :user]) %></th>
        <th class="text-center"><%= I18n.t(:email, scope: [:activerecord, :attributes, :user]) %></th>
        <th class="text-center"><%= I18n.t(:created_at, scope: [:activerecord, :attributes, :user]) %></th>
        <th class="text-center"><%= I18n.t(:updated_at, scope: [:activerecord, :attributes, :user]) %></th>
        <th colspan="3"></th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <th class="text-center"><%= user.id %></th>
          <th class="w-25"><%= user.name %></th>
          <th class="w-25"><%= user.email %></th>
          <th class="text-center"><%= user.created_at.strftime("%Y/%m/%d %H:%M")  %></th>
          <th class="text-center"><%= user.updated_at.strftime("%Y/%m/%d %H:%M")  %></th>
          <th class="text-center"><%= link_to I18n.t('action.show'), user_path(user), class:"btn btn-primary" %></th>
          <th class="text-center"><%= link_to I18n.t('action.edit'), edit_user_path(user), class:"btn btn-primary" %></th>
          <th class="text-center"><%= link_to I18n.t('action.delete'), user_path(user), class:"btn btn-danger", data: { turbo_method: :delete, turbo_confirm: I18n.t('confirm') } %></th>
        </tr>
      <% end %>
    </tbody>
  </table>

</div>
