<tr class="task">
  <th scope="row" class="task_list__task_row task_table__name">
    <%= task.name %>
  </th>
  <td class="task_table__priority">
    <%= task.priority %>
  </td>
  <td class="task_table__status">
    <%= task.status %>
  </td>
  <td class="task_table__expired_date">
    <%= task.expired_date %>
  </td>
  <td class="task_table__description">
    <%= task.description %>
  </td>
</tr>
