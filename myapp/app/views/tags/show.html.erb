<div class="px-5">
  <h2><%= I18n.t('activerecord.models.tag') %> <%= I18n.t('action.show') %></h2>

  <table class='table'>
    <tbody>
      <tr>
        <th class="w-25"><%= I18n.t(:id, scope: [:activerecord, :attributes, :tag]) %></th>
        <td class="w-75"><%= @tag.id %></td>
      </tr>
      <tr>
        <th class="w-25"><%= I18n.t(:user_id, scope: [:activerecord, :attributes, :tag]) %></th>
        <td class="w-75"><%= @tag.user_id %></td>
      </tr>
      <tr>
        <th class="w-25"><%= I18n.t(:name, scope: [:activerecord, :attributes, :tag]) %></th>
        <td class="w-75"><%= @tag.name %></td>
      </tr>
      <tr>
        <th class="w-25"><%= I18n.t(:created_at, scope: [:activerecord, :attributes, :tag]) %></th>
        <td class="w-75"><%= @tag.created_at %></td>
      </tr>
      <tr>
        <th class="w-25"><%= I18n.t(:updated_at, scope: [:activerecord, :attributes, :tag]) %></th>
        <td class="w-75"><%= @tag.updated_at %></td>
      </tr>
    </tbody>
  </table>

  <%= link_to I18n.t('action.list'), tags_path, class:"btn btn-primary" %>
  <%= link_to I18n.t('action.edit'), edit_tag_path(@tag), class:"btn btn-primary" %>

  <h4 class="mt-5"><%= @tag.name %> <%= I18n.t('activerecord.models.task') %> <%= I18n.t('action.list') %></h4>
  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th class="text-center"><%= I18n.t(:id, scope: [:activerecord, :attributes, :task]) %></th>
        <th class="text-center"><%= I18n.t(:name, scope: [:activerecord, :attributes, :task]) %></th>
        <th class="text-center"><%= I18n.t(:deadline_at, scope: [:activerecord, :attributes, :task]) %></th>
        <th class="text-center"><%= I18n.t('activerecord.models.tag') %></th>
        <th class="text-center"><%= I18n.t(:created_at, scope: [:activerecord, :attributes, :task]) %></th>
        <th class="text-center"><%= I18n.t(:updated_at, scope: [:activerecord, :attributes, :task]) %></th>
      </tr>
    </thead>
    <tbody>
      <% @tasks.each do |task| %>
        <tr>
          <th class="text-center"><%= task.id %></th>
          <th class="w-25"><%= task.name %></th>
          <th class="text-center"><span class="<%= badge_class(task.status) %>"><%= I18n.t(task.status, scope: [:activerecord, :enums, :task, :status]) %></span></th>
          <th class="text-center"><%= task.deadline_at&.strftime("%Y/%m/%d %H:%M")  %></th>
          <th>
            <% task.tags.each do |tag| %>
              <span class="badge py-2 fs-6 bg-secondary"><%= tag.name %></span>
            <% end %>
          </th>
          <th class="text-center"><%= task.created_at.strftime("%Y/%m/%d %H:%M")  %></th>
          <th class="text-center"><%= task.updated_at.strftime("%Y/%m/%d %H:%M")  %></th>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
