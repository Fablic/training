<!DOCTYPE html>
<html>
  <head>
    <title>Users</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= render 'shared/flash_message' %>
    <%= render 'layouts/top_header' %>
    <%= link_to I18n.t("users.index.add_user"), new_user_path, method: :get, class: "link-primary text-decoration-none"%>
    <%= render 'layouts/bottom_header' %>
    <%= yield %>
  </body>
</html>
