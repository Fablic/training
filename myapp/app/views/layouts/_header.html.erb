<header>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container-fluid">
      <%= link_to 'タスク管理システム', root_path, class: 'navbar-brand' %>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav">
          <% if logged_in? %>
          <li class="nav-item">
            <%= link_to 'タスク管理', tasks_path, class: 'nav-link active' %>
          </li>
          <li class="nav-item">
            <%= link_to 'ユーザー情報', current_user, class: 'nav-link active' %>
          </li>
          <% end %>
        </ul>
      </div>
      <div class="login-logout">
        <% if logged_in? %>
          <%= link_to "ログアウト", logout_path, method: :delete, class: 'nav-link active' %>
        <% else %>
          <%= link_to "ログイン", login_path, class: 'nav-link active' %>
        <% end %>
      </div>
    </div>
  </nav>
</header>
