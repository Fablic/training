<header class="navbar navbar-fixed-top navbar-inverse">
  <div class="container">
    <%= link_to "Todo App", root_path, id: "logo" %>
    <nav>
      <ul class="nav navbar-nav navbar-right">
        <li><%= link_to "Home",   root_path %></li>
        <li><%= link_to "Log out", logout_path %></li>
        <li>
            <div class="search_form">
              <%= form_with url: search_path, method: :get, local: true do |f| %>
                <% f.label :title %>
                <%= f.text_field :title %>
                <% f.label :status %>
                <%= f.select :status, Task.statuses.map { |k, v| [k, v] } %>
								<%= f.submit 'search' %>
              <% end %>
            </div>
        </li>
      </ul>

      <div class="d-flex">
        <%= form_with url: search_path, method: :get, local: true, class:"d-flex" do |f| %>
        <%= f.text_field :title, placeholder: "Search", class: "form-control me-2" %>
        <%= f.select :status, Task.statuses.map { |k, v| [k, v] }, {}, { class: "form-select" } %>
				<%= f.button type: 'submit', class: "btn btn-secondary", name: 'search-button' do %>
          <i class="fa fa-search"></i>
        <% end %>
      <% end %>
      </div>
      </ul>
    </div>
  </div>
</nav>



