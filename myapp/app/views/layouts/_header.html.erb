<header class="navbar navbar-fixed-top navbar-inverse">
  <div class="container">
    <%= link_to "MyApp", root_path, id: "logo" %>
    <nav class="nav navbar-nav navbar-right">
      <% if logged_in? %>
        <li><%= link_to t('common.new'),   new_task_path %></li>

          <% if adminer? %>
            <li class="dropdown">
              <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                <%=t('pages.admin.title')%> <b class="caret"></b>
              </a>
              <ul class="dropdown-menu">
                <li><%= link_to t('pages.admin.users'), admin_path %></li>
              </ul>
            </li>
          <% end %>

          <li class="dropdown">
            <a href="#" class="dropdown-toggle" data-toggle="dropdown">
              <%=t('pages.admin.account')%> <b class="caret"></b>
            </a>
            <ul class="dropdown-menu">
              <li><%= link_to t('common.profile'), edit_user_path(current_user) %></li>
              <li class="divider"></li>
              <li><%= link_to t('common.logout'), logout_path, method: :delete %></li>
            </ul>
          </li>

      <% else %>
        <li><%= link_to t('common.login'), login_path %></li>
      <% end %>
    </nav>
  </div>
</header>
