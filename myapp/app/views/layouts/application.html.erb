<!DOCTYPE html>
<html>
  <head>
    <title><%= I18n.t('title') %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="px-5 mb-3 bg-primary">
      <div class="d-flex justify-content-between align-items-center">
        <%= link_to tasks_path, class:"text-decoration-none" do %>
          <h1 class="py-2 text-white"><%= I18n.t('title') %></h1>
        <% end %>
        <div>
          <% if logged_in? %>
            <span class="me-5 text-white"><%= @current_user.name %></span>
            <span class="me-5"><%= link_to I18n.t('action.logout'), logout_path, class:"text-white", data: { turbo_method: :delete, turbo_confirm: I18n.t('confirm') } %></span>
          <% end %>

          <%# TODO: admin ユーザの時のみユーザ一覧へのリンクを表示する %>
          <%# TODO: i18n 対応する %>
          <% if true %>
            <span class="me-5"><%= link_to "ユーザ一覧", users_path, class:"text-white" %></span>
          <% end %>

          <span class="me-2"><%= link_to "日本語", request.path_info + "?locale=ja", class:"text-white" %></span>
          <span><%= link_to "English", request.path_info + "?locale=en", class:"text-white" %></span>
        </div>
      </div>
    </div>

    <% flash.each do |message_type, message| %>
      <div class="mx-5 alert alert-<%= message_type %>"><%= message %></div>
    <% end %>

    <%= yield %>

  </body>
</html>
