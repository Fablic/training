<!DOCTYPE html>
<html>
  <head>
    <title>Myapp</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag 'rails-ujs', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
      <div class="container">
        <%= link_to 'Myapp', root_path, class: 'navbar-brand' %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
          <ul class="navbar-nav">
            <li class="nav-item">
              <%= link_to 'Tasks', tasks_path, class: 'nav-link' %>
            </li>
            <% if current_user && current_user.admin?%>
              <li class="nav-item">
                <%= link_to 'Admin', admin_users_path, class: 'nav-link' %>
              </li>
            <% end %>
          </ul>
        </div>
        
        <% if current_user %>
          <div class="navbar-text" style="margin-right:10px; font-weight: bold;">
            <%= current_user.username %>
          </div>
          <div class="navbar-nav">
            <%= link_to 'Log out', logout_path, method: :delete, class: 'btn btn-outline-danger' %>
          </div>
        <% end %>
      </div>
    </nav>
    <%= render 'layouts/flash' %>
    <%= yield %>
  </body>
</html>
