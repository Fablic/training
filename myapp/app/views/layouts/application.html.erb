<!DOCTYPE html>
<html>
  <head>
    <title>Tasks</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
  <div class="container">
    <% if signed_in? %>
      <p>Welcome, <%= current_user.name %> | <%= link_to 'Sign out', session_path, method: :delete, data: { confirm: 'Are you sure?' } %></p>
    <% else %>
      <%= link_to 'Sign in', session_path %>
    <% end %>
    <%= yield %>
  </div>
  </body>
</html>
