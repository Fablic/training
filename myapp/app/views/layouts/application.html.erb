<!DOCTYPE html>
<html>
  <head>
    <title><%= I18n.t('title') %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <% flash.each do |message_type, message| %>
    <div><%= message %></div>
  <% end %>

  <body>
    <div class="px-5 mb-3 bg-primary">
      <%= link_to tasks_path, class:"text-decoration-none" do %>
        <h1 class="py-2 text-white"><%= I18n.t('title') %></h1>
      <% end %>
      <div>
        <p><%= link_to "日本語", request.path_info + "?locale=ja", class:"text-white" %></p>
        <p><%= link_to "English", request.path_info + "?locale=en", class:"text-white" %></p>
      </div>
    </div>

    <%= yield %>

  </body>
</html>
