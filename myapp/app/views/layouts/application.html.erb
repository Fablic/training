<!DOCTYPE html>
<html>
  <head>
    <title>Myapp</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <%= notice %>
    <div class='container-sm'>
      <div id='user_header' style='text-align: right;'>
        <% if Current.user %>
          <%= I18n.t('session.log_in.as', user_name: Current.user.name) %>.
          <%= link_to I18n.t('session.log_out.log_out'), logout_path %>
        <% else %>
          <%= link_to I18n.t('activerecord.actions.user.sign_up.sign_up'), signup_path %> or
          <%= link_to I18n.t('session.log_in.log_in'), login_path %>
        <% end %>
      </div>
    </div>
    <%= yield %>
  </body>
</html>
