<!DOCTYPE html>
<html>
  <head>
    <title>Myapp</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <% if flash[:notice] %>
      <p><%= flash[:notice] %></p>
    <% end %>
    <% if flash[:alert] %>
      <p><%= flash[:alert] %></p>
    <% end %>
    <% if current_user %>
      <div class="d-flex flex-row-reverse">
        <div class="p-2"><%= current_user.name %></div>
        <div class="p-2"><%= link_to "Log out", logout_path, method: "delete" %></div>
      </div>
    <% else %>
      <div class="d-flex flex-row-reverse">
        <div class="p-2"><%= link_to "Login", login_path %></div>
        <div class="p-2"><%= link_to "Sign Up", signup_path %></div>
      </div>
    <% end %>
    <%= yield %>
  </body>
</html>
