<!DOCTYPE html>
<html>
  <head>
    <title>Myapp</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
      <nav>
        <div>
          <%= link_to t('nav.page_title'), root_path %>
          <div>
            <% if current_user %>
              <li>
                <%= link_to t('nav.home_link'), root_path %>
              </li>
              <% if current_user.admin? %>
                <li>
                  <%= link_to t('nav.admin_users_link'), admin_users_path %>
                </li>
              <% end %>
              <li>
                <%= link_to t('nav.logout_link'), logout_path, method: :delete %>
              </li>
            <% end %>
          </div>
        </div>
      </nav>
  </head>

  <body>
    <%= yield %>
  </body>
</html>
