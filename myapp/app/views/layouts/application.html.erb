<!DOCTYPE html>
<html>
  <head>
    <title>Myapp | <%= yield :title %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <div class="header">
      <div class="logo">
        <h1><%= t('dictionary.system.title')%></h1> 
      </div>
      <% if @login_user %>
      <div class="info">
        <%= @login_user['name']%>
        <%= link_to t('dictionary.system.logout'), '/logout' %> 
      </div>
      <% end %>
    </div>

    <div class="contents">
      <h1><%= yield :title %></h1>
      
      <div class="notifications">
        <% flash.each do |key, value| %>
          <%= content_tag(:div, value, class: key)%>
        <% end%>
      </div>

      <%= yield %>
    </div>
  </body>
</html>
