<!DOCTYPE html>
<html>
  <head>
    <title>Myapp</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <div class="d-flex flex-column flex-md-row align-items-center p-3 px-md-4 mb-3 bg-white border-bottom shadow-sm">
      <h5 class="my-0 mr-md-auto font-weight-normal">[Rails training]</h5>
      <nav class="my-2 my-md-0 mr-md-3">
        <a class="p-2 text-dark" href="/"><%= t('tasks.index.title') %></a>
        <a class="p-2 text-dark" href="/tasks/new"><%= t('tasks.new.title') %></a>
      </nav>
      <td><%= link_to t('login.new.signup'), "#", method: :get, class: "btn btn-outline-primary" %></td>
      <td><%= link_to t('login.new.logout'), logout_path, method: :delete, class: "btn btn-outline-primary" %></td>
    </div>
    <p class="notice"><%= notice %></p>
    <p class="alert"><%= alert %></p>
    <%= yield %>
  </body>
</html>
