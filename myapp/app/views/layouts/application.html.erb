<!DOCTYPE html>
<html>
  <head>
    <title>Myapp</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_pack_tag 'application' %>
    <%= javascript_pack_tag 'application' %>
  </head>

  <body>
    <div class="container my-4">

      <ul class="nav nav-pills justify-content-end">
        <% if logged_in? %>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" data-toggle="dropdown" href="#"><%= @current_user.email %></a>
            <div class="dropdown-menu">
              <%= link_to I18n.t('auth.logout'), logout_path, method: :delete, class: 'dropdown-item' %>
            </div>
          </li>
        <% else %>
          <li class="nav-item">
            <%= link_to I18n.t('auth.login'), login_path, class: 'nav-link'%>
          </li>
        <% end %>
      </ul>

      <%= render '/common_partials/flash_messages' %>

      <%= yield %>
    </div>
  </body>
</html>
