<!DOCTYPE html>
<html>
  <head>
    <title>Task-u-ten</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag 'https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css'%>
    <%= stylesheet_link_tag 'https://unpkg.com/bulmaswatch/journal/bulmaswatch.min.css' %>
    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body class='has-background-white-ter'>

<% if ! notice.blank? %>

 
      <div class="notification is-success ">
        <button class="delete"></button>
        <%= notice %>
      </div>
 

<% end  %>
<nav class="navbar is-primary" role="navigation" aria-label="main navigation">
  <div class="navbar-brand">

    <h1 class="title is-1 has-text-white">Task-u-ten</h1>

  </div>

  <div id="navbarBasicExample" class="navbar-menu ">
    <div class="navbar-start is-size-4">
      <div class='block'>&nbsp;&nbsp;&nbsp;</div>
      
      <%= link_to 'Tasks', tasks_path , class: 'navbar-item'%>
      <%= link_to 'Labels', labels_path , class: 'navbar-item'%>

<% if admin? %>
      <%= link_to 'Users', users_path , class: 'navbar-item'%>
      <a class="navbar-item">
        Config
      </a>
<% end %>
    </div>

    <div class="navbar-end">
      <div class="navbar-item is-size-4">
         
          Hi <%= current_user.name %>! 
    
      </div>
      <div class="navbar-item">

        <div class="buttons">
          <%= link_to "Log out", logout_path, method: :delete, class: 'button is-light' %>
        </div>
      </div>
    </div>
  </div>
</nav>
<!-- -----START ------  -->

    <%= yield %>

<!-- -----END ------  -->
  </body>
</html>
