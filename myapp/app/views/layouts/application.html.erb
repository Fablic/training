<!DOCTYPE html>
<html>
  <head>
    <title><%= I18n.t('title') %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <% flash.each do |message_type, message| %>
    <div><%= message %></div>
  <% end %>

  <body>
    <div class="px-5 mb-3 bg-primary">
      <%= link_to tasks_path(locale: 'ja'), class:"text-decoration-none" do %>
        <h1 class="py-2 text-white"><%= I18n.t('title') %></h1>
      <% end %>
    </div>
    <%= yield %>
  </body>
</html>
