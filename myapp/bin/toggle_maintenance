#!/bin/bash
# 文件: bin/toggle_maintenance

MAINTENANCE_FILE="/myapp/maintenance.flag"

case "$1" in
  on)
    echo "Turning on maintenance mode."
    touch "$MAINTENANCE_FILE"
    ;;
  off)
    echo "Turning off maintenance mode."
    rm -f "$MAINTENANCE_FILE"
    ;;
  *)
    echo "Usage: $0 {on|off}"
    exit 1
esac

echo "Done."