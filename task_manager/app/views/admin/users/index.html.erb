<h1>ユーザー一覧</h1>
<div class="row">
  <div class="col-6">
    <%
=begin%>
 <%= form_with url: root_path, method: :get, local: true do |f| %>
        <%= f.text_field :keyword_name, value: @keyword_name ,:placeholder => (t '.name') %>
        <%= f.select :keyword_progress, options_for_select(Task.progresses_i18n.keys.map {|k| [I18n.t("enums.task.progress.#{k}"), k]}, selected: @keyword_progress) , { include_blank: '選択なし'} %>
        <%= f.submit "検索" %>
    <% end %> 
<%
=end%>
  </div>
  <div class="col-6">
    <%= paginate @users %>
  </div>
</div>
<table class="table table-striped table-bordered table-hover" style="margin-top: 10px;">
  <thead>
    <tr>
      <th scope="col"><%= I18n.t 'activerecord.attributes.user.name'%></th>
      <th scope="col"><%= I18n.t 'activerecord.attributes.user.email'%></th>
    </tr>
  </thead>

  <tbody>
    <% @users.each_with_index do |user , index| %>
      <tr id= 'user-<%= index %>'>
        <td><%= user.name %></td>
        <td><%= user.email %></td>
        <td><%= link_to '詳細', [:admin, user ] %></td>
      </tr>
    <% end %>
  </tbody>
</table>
