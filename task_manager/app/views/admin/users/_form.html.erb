<%= form_for([:admin, @user ], remote: true, class: "form-horizontal") do |f| %>
  <div id='errors'></div>

  <div class="form-group">
    <div class="row">
      <div class="col-8">
        <%= f.label :name %>
        <%= f.text_field :name, class: "form-control"%>
      </div>
    </div>
  </div>
  <div class="form-group">
    <div class="row">
      <div class="col-8">
        <%= f.label :email %>
        <%= f.email_field :email, class: "form-control"%>
      </div>
    </div>       
  </div>
  <div class="form-group">
      <div>
        <%= f.label :is_admin %>
      </div>
        <%= f.radio_button :is_admin, true %>
        <%= f.label :is_admin, I18n.t("activerecord.values.is_admin.true"), value: true %>
        <%= f.radio_button :is_admin, false %>
        <%= f.label :is_admin, I18n.t("activerecord.values.is_admin.false"), value: false %>
    </div>       
  <%= f.submit '投稿', class: "btn btn-primary"%>
<% end %>
