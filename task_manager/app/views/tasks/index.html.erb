<h1><%= t '.title' %></h1>
<div class="row">
  <div class="col-6">
    <%= form_with url: root_path, method: :get, local: true do |f| %>
        <%= f.text_field :keyword_name, value: @keyword_name ,:placeholder => (t '.name') %>
        <%= f.select :keyword_progress, options_for_select(Task.progresses_i18n.keys.map {|k| [I18n.t("enums.task.progress.#{k}"), k]}, selected: @keyword_progress) , { include_blank: '選択なし'} %>
        <%= f.submit "検索" %>
    <% end %>
  </div>
  <div class="col-6">
    <%= paginate @tasks %>
  </div>
</div>
<table class="table table-striped table-bordered table-hover" style="margin-top: 10px;">
  <thead>
    <tr>
      <th scope="col"><%= build_sort_link "name" , (t '.name')%></th>
      <th scope="col"><%= build_sort_link "created_at" , (t '.created_at')%></th>
      <th scope="col"><%= build_sort_link "due_at" , (t '.due_at')%></th>
    </tr>
  </thead>

  <tbody>
    <% @tasks.each_with_index do |task , index| %>
      <tr id= 'task-<%= index %>'>
        <td><%= task.name %></td>
        <td><%= I18n.l(task.created_at, format: :default) %></td>
        <td><%= I18n.l(task.due_at, format: :default) %></td>
        <td><%= task.progress_i18n%></td>
        <td><%= link_to '詳細', task %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to 'New Task', new_task_path %>
