<h1><%= t '.title' %></h1>
<%= form_with url: search_path, method: :get, local: true do |f| %>
    <%= f.text_field :keyword, value: @keyword %>
    <%= f.submit "検索" %>
<% end %>
<table class="table table-striped table-bordered table-hover">
  <thead>
    <tr>
      <th scope="col"><%= sortable "name" , (t '.name')%></th>
      <th scope="col"><%= sortable "created_at" , (t '.created_at')%></th>
      <th scope="col"><%= sortable "due_at" , (t '.due_at')%></th>
    </tr>
  </thead>

  <tbody>
    <% @tasks.each_with_index do |task , index| %>
      <tr id= 'task-<%= index %>'>
        <td><%= task.name %></td>
        <td><%= l(task.created_at, format: :default) %></td>
        <td><%= l(task.due_at, format: :default) %></td>
        <td><%= link_to '詳細', task %></td>
      </tr>
    <% end %>
  </tbody>
</table>


<%= link_to 'New Task', new_task_path %>
