<h1><%= t '.title' %></h1>

<table class="table table-striped table-bordered table-hover">
  <thead>
    <tr>
      <th scope="col"><%= sortable "name" , (t '.name')%></th>
      <th scope="col"><%= sortable "created_at" , (t '.created_at')%></th>
    </tr>
  </thead>

  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.name %></td>
        <td><%= task.created_at %></td>
        <td><%= link_to '詳細', task %></td>
      </tr>
    <% end %>
  </tbody>
</table>


<%= link_to 'New Task', new_task_path %>
