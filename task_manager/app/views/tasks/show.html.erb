<h1>タスク詳細</h1>

<div class="row">
  <div class="col-8">
    <%= render partial:'layouts/standard_card', locals: { title: "タスク名", text: @task.name } %>
    <%= render partial:'layouts/standard_card', locals: { title: "メモ", text: @task.description } %>
    <%= render partial:'layouts/standard_card', locals: { title: "締め切り", text: I18n.l(@task.due_at, format: :default) } %>
    <%= render partial:'layouts/standard_card', locals: { title: "優先度", text: @task.priority_i18n } %>
    <%= render partial:'layouts/standard_card', locals: { title: "進捗状況", text: @task.progress_i18n } %>
    <%= link_to '一覧へ戻る',tasks_path , class: "btn btn-info btn-lg btn-blok"%>
  </div>
  <div class="col-4">
      <button type="button" class="btn btn-primary btn-lg btn-block" data-toggle="modal" data-target="#edit-task-modal">
        タスクを編集する
      </button>

    <%= link_to 'タスクを削除する', @task, class: "btn btn-danger btn-lg btn-block", method: :delete, data:{ confirm: '本当によろしいですか？'} %>
  </div>

  <!-- Modal -->
  <div class="modal fade" id="edit-task-modal">
    <div class="modal-dialog" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="exampleModalLongTitle">タスクの編集</h5>
          <button type="button" class="close" data-dismiss="modal" aria-label="Close">
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
        <div class="modal-body">
          <%= render 'form', task: @task %>
        </div>
      </div>
    </div>
  </div>
</div>
