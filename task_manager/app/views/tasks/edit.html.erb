<h1>タスクの編集</h1>

<%= form_for(@task) do |f| %>
    <div>
        <%= f.label :name, 'タスク' %>
        <%= f.text_field :name %>
    </div>
    <div>
        <%= f.label :description, 'メモ' %>
        <%= f.text_area :description %>
    </div>
    <div>
        <%= f.label :due_at, '締め切り' %>
        <%= f.text_field :due_at %>
    </div>
    <div>
        <%= f.label :priority, '優先順位' %>
        <%= f.select :priority, [['低', 'low'], ['中', 'normal'], ['高', 'high']], {selected: @task.priority}, {class: 'mclist__select'} %>
    </div>
    <div>
        <%= f.label :progress, '優先順位' %>
        <%= f.select :progress, [['Todo', 'Todo'], ['InProgress', 'InProgress'], ['Done', 'Done']], {selected: @task.progress}, {class: 'mclist__select'} %>
    </div>
    <%= f.submit '投稿' %>
<% end %>

<%= link_to '一覧に戻る', tasks_path %>
