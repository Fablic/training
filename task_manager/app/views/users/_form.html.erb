<%= form_with model: @user, local: false, class: "form-horizontal" do |f| %>
  <div id='errors'></div>

  <div class="form-group">
    <div class="row">
      <div class="col-8">
        <%= f.label :name %>
        <%= f.text_field :name, class: "form-control"%>
      </div>
    </div>
  </div>
  <div class="form-group">
    <div class="row">
      <div class="col-8">
        <%= f.label :email %>
        <%= f.email_field :email, class: "form-control"%>
      </div>
    </div>       
  </div>
  <div class="form-group">
    <div class="row">
      <div class="col-8">
        <%= f.label :password %>
        <%= f.password_field :password, class: "form-control"%>
      </div>
    </div>
  </div>
  <div class="form-group">
    <div class="row">
      <div class="col-8">
        <%= f.label :password_confirmation %>
        <%= f.password_field :password_confirmation, class: "form-control"%>
      </div>
    </div>
  </div>
  <%= f.submit '投稿', class: "btn btn-primary"%>
<% end %>
