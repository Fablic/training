<div class="row">
  <%= form_with(model: task) do |f| %>
    <% if task.errors.any? %>
      <div id="error_explanation" class="alert alert-danger">
        <ul>
          <% task.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-group mb-4">
      <%= f.label :name, 'Name' %>
      <%= f.text_field :name, class: %w[form-control] %>
    </div>

    <div class="form-group mb-4">
      <%= f.label :description, 'Description' %>
      <%= f.text_field :description, class: %w[form-control] %>
    </div>

    <div class="form-group mb-4">
      <%= f.label :priority, 'Priority' %>
      <%= f.select :priority, Task.priorities.keys , {}, { class: %w[form-select] } %>
    </div>

    <div class="form-group mb-4">
      <%= f.label :status, 'Priority' %>
      <%= f.select :status, Task.statuses.keys , {}, { class: %w[form-select] } %>
    </div>

    <div class="actions mb-4">
      <%= f.submit nil, class: %w[btn btn-primary] %>
    </div>
  <% end %>
</div>
