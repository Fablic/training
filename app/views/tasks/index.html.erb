<h1>Task Index</h1>


<%= form_with(url: tasks_path, method: :get) do |f| %>
  <div class="row">
    <div class="col-4">
      <%= f.label "name", class: %[col-form-label] %>
      <%= f.text_field :name, value: params[:name], class: %w[form-control] %>
    </div>
    <div class="col-4">
      <%= f.label "status", class: %[col-form-label] %>
      <%= f.select :status, Task.statuses.keys, { include_blank: true, selected: params[:status] }, { class: %w[form-select] } %>
    </div>
    <div class="col-4">
      <%= f.submit 'Search', class: %w[btn btn-primary mt-4] %>
    </div>
  </div>
<% end %>

<table class="table">
  <thead>
    <tr>
      <th>Name</th>
      <th>Description</th>
      <th>Status</th>
      <th>Priority</th>
      <th>Label</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.name %></td>
        <td><%= task.description %></td>
        <td><%= task.status %></td>
        <td><%= task.priority %></td>
        <td>
          <% task.labels.each do |label| %>
            <div><%= label.name %></div>
          <% end %>
        </td>
        <td><%= link_to 'Show', task %></td>
        <td><%= link_to 'Edit', edit_task_path(task) %></td>
        <td><%= link_to 'Destroy', task, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<br>

<%= link_to 'New Task', new_task_path, class: %w[btn btn-success] %>
