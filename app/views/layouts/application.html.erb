<!DOCTYPE html>
<html>
  <head>
    <title>Myapp</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <header class="navbar navbar-expand-sm navbar-light bg-light">
      <div class="container">
        <%= link_to 'TaskApp', root_path, class: 'navbar-brand' %>
        <% if current_user %>
          <%= link_to 'Log out', logout_path, class: 'navbar-brand', method: :delete %>
        <% end %>
      </div>
    </header>

    <div class="container">
      <%= yield %>
    </div>
  </body>
</html>
