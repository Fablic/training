<h1><%= I18n.t('tasks.show.title') %></h1>
<h2><%= @task.name %> <%= renderStatus @task.status %></h2>
<p><%= l @task.start_at, format: :long %> 〜 <%= l @task.due_date_at, format: :long %></p>
<p><%= simple_format @task.description %></p>

<p><%= link_to I18n.t('dictionary.words.to_list'), tasks_path, class: 'btn btn-success mr-2' %></p>
