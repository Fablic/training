<%= render partial: 'header', locals: { title: I18n.t('tasks.show.title') } %>

<div class='container' id='main-container'>
  <% if notice.present? %>
    <%= render partial: 'common/notice', locals: { notice: notice } %>
  <% end %>

  <div id='back-to-list'><%= link_to I18n.t('dictionary.words.to_list'), tasks_path, class: 'btn btn-success mr-2' %></div>

  <div id='show-area' class='border rounded'>
    <h2 class='task-name d-inline-block'><span class='border rounded d-inline-block'><%= @task.status.text %></span><%= @task.name %></h2>
    <p><%= l @task.start_at, format: :long %> 〜 <%= l @task.due_date_at, format: :long %></p>
    <%= simple_format @task.description %>
    <ul class='label-list'>
      <% @task.labels.each do |label| %>
        <li class='d-inline-block border rounded'><%= label.name %></li>
      <% end %>
    </ul>
  </div>

</div>
