<table>
  <tr>
    <th><%= form.label :name, Task.human_attribute_name(:name) %></th>
    <td><%= form.text_field :name %></td>
  </tr>
  <tr>
    <th><%= Task.human_attribute_name(:period) %></th>
    <td>
      <%= form.datetime_field :start_at, class: 'form-control' %>
       〜 
      <%= form.datetime_field :due_date_at, class: 'form-control' %>
    </td>
  </tr>
  <tr>
    <th><%= form.label :description, Task.human_attribute_name(:description) %></th>
    <td><%= form.text_area :description %></td>
  </tr>
</table>
<p><%= form.submit @submit_label, class: 'btn btn-primary' %></p>
