<header class='border-bottom rounded-bottom position-fixed w-100'>
  <h1><%= I18n.t('tasks.index.title') %></h1>
</header>
<div class='container' id='main-container'>

<div id='create-task'><%= link_to I18n.t('tasks.index.create'), new_task_path, class: 'btn btn-success mr-2' %></div>

<div id="search-form" class='border rounded'>
  <%= form_with url: search_path, method: :get, local: true do |f| %>
    <p><%= f.text_field :keyword, value: @keyword %> <%= f.select :status, Task.status.options, include_blank: I18n.t('dictionary.words.all'), selected: @status %> <%= f.submit I18n.t('dictionary.words.search_button') %></p>
  <% end %>
</div>

<div id='sort-form'>
  <%= Task.human_attribute_name(:due_date_at) + I18n.t('dictionary.words.sort') %>
  <%= link_to I18n.t('dictionary.words.asc'), { sort: 'due_date_at', direction: 'asc' } %> 
  <%= link_to I18n.t('dictionary.words.desc'), { sort: 'due_date_at', direction: 'desc' } %> 
  <%= link_to I18n.t('dictionary.words.clear'), tasks_path %>
</div>

<ul class='list-group rounded'>
  <% @tasks.each do |task| %><li class='list-group-item'>
    <div class='d-inline-block'>
    <%= button_to I18n.t('tasks.index.delete'), task_path(task), method: :delete, data: {confirm: I18n.t('dictionary.messages.confirm_delete')} %>
    </div>
    <h2 class='task-name d-inline-block'>
      <span class='border rounded d-inline-block'><%= task.status.text %></span><%= link_to task.name, task_path(task) %>
      <%= link_to I18n.t('tasks.index.edit'), edit_task_path(task), class: 'btn btn-dark mr-2'%>
    </h2>
    <p><%= l task.start_at, format: :long %> 〜 <%= l task.due_date_at, format: :long %></p>
  </li>
  <% end %>
</ul>
<%= paginate @tasks %>
</div>
