<h1><%= I18n.t('tasks.index.title') %></h1>
<p><%= link_to I18n.t('tasks.index.create'), new_task_path, class: 'btn btn-success mr-2' %></p>
<p>
  <%= Task.human_attribute_name(:due_date_at) + I18n.t('dictionary.words.sort') %>
  <%= link_to I18n.t('dictionary.words.asc'), { sort: 'due_date_at', direction: 'asc' } %> 
  <%= link_to I18n.t('dictionary.words.desc'), { sort: 'due_date_at', direction: 'desc' } %> 
  <%= link_to I18n.t('dictionary.words.clear'), tasks_path %>
</p>
<div class="search-form">
  <%= form_with url: search_path, method: :get, local: true do |f| %>
    <p><%= f.label :keyword, I18n.t('dictionary.words.search_keyword') %><%= f.text_field :keyword, value: @keyword %><%= Task.human_attribute_name(:status) %><%= f.select :status, [[I18n.t('dictionary.words.status_not_started'), "0"], [I18n.t('dictionary.words.status_wip'), "1"], [I18n.t('dictionary.words.status_completed'), "2"]], include_blank: "全て", selected: @status %><%= f.submit I18n.t('dictionary.words.search_button') %></p>
  <% end %>
</div>
<ul>
  <% @tasks.each do |task| %><li>
    <h2>
      <%= link_to task.name, task_path(task), class: 'btn btn-success mr-2' %>  <%= renderStatus task.status %>
      <%= link_to I18n.t('tasks.index.edit'), edit_task_path(task), class: 'btn btn-primary mr-2'%>
      <%= button_to I18n.t('tasks.index.delete'), task_path(task), method: :delete, data: {confirm: I18n.t('dictionary.messages.confirm_delete')} %>
    </h2>
    <p><%= l task.start_at, format: :long %> 〜 <%= l task.due_date_at, format: :long %></p>
  </li>
  <% end %>
</ul>
