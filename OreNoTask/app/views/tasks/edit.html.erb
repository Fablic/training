<header class='border-bottom rounded-bottom position-fixed w-100'>
  <h1><%= I18n.t('tasks.edit.title') %></h1>
  <%= button_to I18n.t('dictionary.words.logout'), logout_path, method: :delete, data: {confirm: I18n.t('dictionary.messages.confirm_logout')}, class: 'btn btn-dark logout' %>
  <%= link_to I18n.t('dictionary.words.user_management'), admin_users_path, class: 'btn btn-success change-management' %>
</header>

<div class='container' id='main-container'>
  <% if notice.present? %>
  <%= render partial: 'common/notice', locals: { notice: notice } %>
  <% end %>

  <div id='back-to-list'><%= link_to I18n.t('dictionary.words.to_list'), tasks_path, class: 'btn btn-success mr-2' %></div>
  <div id='edit-form' class='border rounded'>
    <%= form_with url: task_path(@task), model: @task do |form| %>
      <%= render partial: 'form', locals: { form: form, task: @task, submit_label: @submit_label } %>
    <% end %>
  </div>
</div>
