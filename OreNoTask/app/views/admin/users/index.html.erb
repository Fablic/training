<%= render partial: 'header', locals: { title: I18n.t('users.index.title') } %>

<div class='container' id='main-container'>
  <% if notice.present? %>
    <%= render partial: 'common/notice', locals: { notice: notice } %>
  <% end %>

<div id='create-task'><%= link_to I18n.t('users.index.create'), new_admin_user_path, class: 'btn btn-success mr-2' %></div>

<ul class='list-group rounded'>
  <% @users.each do |user| %>
    <li class='list-group-item'>
      <div class='d-inline-block'>
        <%= button_to I18n.t('users.index.delete'), admin_user_path(user), method: :delete, data: {confirm: I18n.t('dictionary.messages.confirm_delete')} %>
      </div>
      <h2 class='task-name d-inline-block'>
        <%= link_to user.name + '(' + user.tasks.size.to_s + ')', admin_user_path(user) %>
        <%= link_to I18n.t('users.index.edit'), edit_admin_user_path(user), class: 'btn btn-dark mr-2' %>
      </h2>
    </li>
  <% end %>
</ul>
<%= paginate @users %>
</div>
