<header class='border-bottom rounded-bottom position-fixed w-100'>
  <h1><%= I18n.t('users.show.title') %></h1>
  <%= button_to I18n.t('dictionary.words.logout'), logout_path, method: :delete, data: {confirm: I18n.t('dictionary.messages.confirm_logout')}, class: 'btn btn-dark logout' %>
  <%= link_to I18n.t('login.index.title'), tasks_path, class: 'btn btn-success change-management' %>
</header>

<div class='container' id='main-container'>
  <% if notice.present? %>
    <%= render partial: 'common/notice', locals: { notice: notice } %>
  <% end %>

  <div id='back-to-list'><%= link_to I18n.t('dictionary.words.to_list'), admin_users_path, class: 'btn btn-success mr-2' %></div>

  <div id='show-area' class='border rounded'>
    <h2 class='task-name d-inline-block'><%= @user.name %>(<%= @user.privilege.text %>)</h2>
    <h3><%= I18n.t('users.show.task_list') %></h3>
    <ul class='list-group rounded'>
      <% @tasks.each do |task| %><li class='list-group-item'>
        <h2 class='task-name d-inline-block'>
          <span class='border rounded d-inline-block'><%= task.status.text %></span><%= task.name %>
        </h2>
        <p><%= l task.start_at, format: :long %> 〜 <%= l task.due_date_at, format: :long %></p>
      </li>
      <% end %>
    </ul>
  </div>

</div>
