<header class='border-bottom rounded-bottom position-fixed w-100'>
  <h1><%= I18n.t('users.index.title') %></h1><%= button_to I18n.t('dictionary.words.logout'), logout_path, method: :delete, data: {confirm: I18n.t('dictionary.messages.confirm_logout')}, class: 'btn btn-dark logout' %>
</header>

<div class='container' id='main-container'>
<ul class='list-group rounded'>
  <% @users.each do |user| %><li class='list-group-item'>
    <div class='d-inline-block'>
    <%= button_to I18n.t('users.index.delete'), admin_users_path(user), method: :delete, data: {confirm: I18n.t('dictionary.messages.confirm_delete')} %>
    </div>
    <h2 class='task-name d-inline-block'>
      <span class='border rounded d-inline-block'></span><%= link_to user.name, admin_users_path(user) %>
      <%= link_to I18n.t('users.index.edit'), edit_user_path(user), class: 'btn btn-dark mr-2'%>
    </h2>
  </li>
  <% end %>
</ul>
<%= paginate @users %>
</div>