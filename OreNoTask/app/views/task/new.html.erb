<html>
<head>
	<meta charset="UTF-8">
	<meta http-equiv="content-language" content="ja">
	<link rel="stylesheet" href="/css/normalize.css">
	<link rel="stylesheet" href="/js/jquery-ui-1.12.1.custom/jquery-ui.css">
	<script src="/js/jquery3_6_0.js"></script>
	<script src="/js/jquery-ui-1.12.1.custom/jquery-ui.js"></script>
</head>

<body>
	<%= form_with model: @task do |form| %>
		<table>
			<tr>
				<th><%= form.label :タスク名 %></th><td><%= form.text_field :name %></td>
			</tr>
			<tr>
				<th>期間</th><td><%= form.text_field :start_at, class: 'form-control date-picker' %><%= form.select :start_at_hour, (0..23).to_a.map { |v| "%02d" % v }, {}, class: 'form-control' %> :
    <%= form.select :start_at_minute, (0..59).to_a.map { |v| "%02d" % v }, {}, class: 'form-control' %> 〜 <%= form.text_field :due_date_at, class: 'form-control date-picker' %><%= form.select :due_date_at_hour, (0..23).to_a.map { |v| "%02d" % v }, {}, class: 'form-control' %> :
    <%= form.select :due_date_at_minute, (0..59).to_a.map { |v| "%02d" % v }, {}, class: 'form-control' %></td>
			</tr>
			<tr>
				<th><%= form.label :内容 %></th><td><%= form.text_area :description %></td>
			</tr>
		</table>
		<p><%= form.submit %></p>
	<% end %>
</body>
<script>
	$( function() {
  		$( ".date-picker" ).datepicker({dateFormat: 'yy/mm/dd',});
 	} );
</script>
</html>