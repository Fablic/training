# Ignore all logfiles and tempfiles.
myapp/log/*
myapp/tmp/*
!myapp/log/.keep
!myapp/tmp/.keep

# TODO Comment out this rule if you are OK with secrets being uploaded to the repo
myapp/config/initializers/secret_token.rb
myapp/config/master.key

# dotenv, dotenv-rails
.env

## Environment normalization:
.bundle
myapp/vendor/bundle

# Ignore node_modules
node_modules

# Ignore yarn files
yarn-error.log
yarn-debug.log*
.yarn-integrity

# Ignore uploaded files in development
myapp/storage/*
!myapp/storage/.keep

.DS_Store
myapp/public/packs
myapp/public/packs-test

# Ignore .idea directory.
myapp/.idea/*
