# Ignore bundler config.
/.bundle

# Ignore bundler gems.
vendor/bundle

# Ignore the default SQLite database.
/db/*.sqlite3
/db/*.sqlite3-journal

# Ignore all logfiles and tempfiles.
/log/*.log
/tmp
!/log/.keep
!/tmp/.keep

# Ignore other unneeded files.
doc/
*.swp
*~
.project
.DS_Store
.idea
.secret
/.yardoc
/public/packs
/public/packs-test
/node_modules
/yarn-error.log
yarn-debug.log*
.yarn-integrity