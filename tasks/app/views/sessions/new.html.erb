<header class="sticky-top">
  <div class="header">
    <h1 class="title">ログイン</h1>
  </div>
</header>

<%= form_for(:session, url: login_path, html: { class: 'col-md-6 offset-md-3 mt-5' }) do |f| %>
  <% flash.each do |message_type, message| %>
    <div class="alert alert-<%= message_type %>"><%= message %></div>
  <% end %>
  
  <div class="form-group">
    <%= f.label t('activerecord.attributes.user.email'), class: 'control-label text-primary' %>
    <%= f.text_field :email, class: 'form-control' %>
  </div>

  <div class="form-group">
    <%= f.label t('activerecord.attributes.user.password'), class: 'control-label text-primary' %>
    <%= f.password_field :password, class: 'form-control' %>
  </div>

  <div class="form-group row justify-content-center">
    <div>
      <%= f.submit t('link.log_in'), class: 'btn btn-primary btn-width' %>
    </div>
  </div>
  <div class="form-group row justify-content-center">
    <p>New user? <%= link_to "Sign up now!", signup_path %></p>
  </div>
<% end %>
